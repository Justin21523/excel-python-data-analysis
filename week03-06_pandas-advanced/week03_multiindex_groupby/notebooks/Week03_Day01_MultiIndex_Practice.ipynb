   "source": [
    "# Week 3 - Day 1: MultiIndex 完整實踐指南\n",
    "\n",
    "## 學習目標\n",
    "- 深入理解 Pandas MultiIndex 的概念與應用\n",
    "- 掌握多層索引的創建、操作與轉換\n",
    "- 通過真實案例學習多維度分析技巧\n",
    "- 實戰應用 MultiIndex 進行複雜數據分析\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 1: 環境設置與資料載入"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import sys\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 設置顯示選項\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.max_rows', 100)\n",
    "pd.set_option('display.width', None)\n",
    "pd.set_option('display.float_format', lambda x: f'{x:.2f}' if abs(x) < 1000 else f'{x:,.2f}')\n",
    "\n",
    "print(\"✅ 環境設置完成\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 載入數據加載模組\n",
    "sys.path.append('../../utils')\n",
    "from data_loader import load_olist_data, load_olist_integrated\n",
    "\n",
    "# 載入 Olist 資料\n",
    "orders, order_items, products, customers, sellers, payments, reviews = load_olist_data()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 2: MultiIndex 建立（10 個範例）\n",
    "\n",
    "### 範例 1: 使用 set_index 建立雙層索引"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 將訂單表和客戶表合併，然後以客戶地區和城市建立雙層索引\n",
    "df1 = orders.merge(customers[['customer_id', 'customer_state', 'customer_city']], \n",
    "                   on='customer_id', how='left')\n",
    "\n",
    "# 建立雙層索引\n",
    "df_multi1 = df1.set_index(['customer_state', 'customer_city'])\n",
    "\n",
    "print(\"\\n=== 範例 1: 雙層索引 ===\")\n",
    "print(f\"索引類型: {type(df_multi1.index)}\")\n",
    "print(f\"索引名稱: {df_multi1.index.names}\")\n",
    "print(f\"索引級別數: {df_multi1.index.nlevels}\")\n",
    "print(\"\\n前5行的索引:\")\n",
    "print(df_multi1.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 2: 使用 from_tuples 建立索引"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 準備數據\n",
    "tuples = list(zip(\n",
    "    df1['customer_state'].head(10),\n",
    "    df1['customer_city'].head(10),\n",
    "    df1['order_id'].head(10)\n",
    "))\n",
    "\n",
    "# 使用 from_tuples 建立索引\n",
    "multi_index = pd.MultiIndex.from_tuples(tuples, names=['State', 'City', 'OrderID'])\n",
    "df_multi2 = pd.DataFrame({\n",
    "    'Amount': df1['order_purchase_timestamp'].head(10).values,\n",
    "    'Status': df1['order_status'].head(10).values\n",
    "}, index=multi_index)\n",
    "\n",
    "print(\"\\n=== 範例 2: from_tuples 建立三層索引 ===\")\n",
    "print(f\"索引級別: {df_multi2.index.nlevels}\")\n",
    "print(f\"索引名稱: {df_multi2.index.names}\")\n",
    "print(\"\\n數據預覽:\")\n",
    "print(df_multi2)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 3: 使用 from_product 建立笛卡爾積索引"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 建立笛卡爾積索引（所有可能的組合）\n",
    "states = ['SP', 'RJ', 'MG']  # São Paulo, Rio de Janeiro, Minas Gerais\n",
    "quarters = ['Q1', 'Q2', 'Q3', 'Q4']\n",
    "\n",
    "multi_index3 = pd.MultiIndex.from_product(\n",
    "    [states, quarters],\n",
    "    names=['State', 'Quarter']\n",
    ")\n",
    "\n",
    "# 創建示例數據\n",
    "np.random.seed(42)\n",
    "df_multi3 = pd.DataFrame({\n",
    "    'Sales': np.random.uniform(50000, 500000, len(multi_index3)),\n",
    "    'Orders': np.random.randint(100, 1000, len(multi_index3))\n",
    "}, index=multi_index3)\n",
    "\n",
    "print(\"\\n=== 範例 3: from_product 笛卡爾積索引 ===\")\n",
    "print(f\"生成的索引組合數: {len(df_multi3)}\")\n",
    "print(\"\\n完整數據:\")\n",
    "print(df_multi3)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 4: 使用 from_arrays 建立索引"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 準備多個數組\n",
    "states = df1['customer_state'].head(15).values\n",
    "years = [2017] * 5 + [2018] * 5 + [2018] * 5\n",
    "months = list(range(1, 6)) + list(range(1, 6)) + list(range(6, 11))\n",
    "\n",
    "# 使用 from_arrays 建立索引\n",
    "multi_index4 = pd.MultiIndex.from_arrays(\n",
    "    [states, years, months],\n",
    "    names=['State', 'Year', 'Month']\n",
    ")\n",
    "\n",
    "df_multi4 = pd.DataFrame({\n",
    "    'Revenue': np.random.uniform(10000, 100000, len(multi_index4)),\n",
    "    'Profit': np.random.uniform(2000, 30000, len(multi_index4))\n",
    "}, index=multi_index4)\n",
    "\n",
    "print(\"\\n=== 範例 4: from_arrays 建立三層索引 ===\")\n",
    "print(f\"索引級別數: {df_multi4.index.nlevels}\")\n",
    "print(f\"索引名稱: {df_multi4.index.names}\")\n",
    "print(\"\\n前10行:\")\n",
    "print(df_multi4.head(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 5: 多層索引 reset_index 操作"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# reset_index 將索引轉換為普通列\n",
    "df_reset = df_multi4.reset_index()\n",
    "\n",
    "print(\"\\n=== 範例 5: reset_index 操作 ===\")\n",
    "print(f\"原始 - 索引級別: {df_multi4.index.nlevels}, 列數: {len(df_multi4.columns)}\")\n",
    "print(f\"轉換後 - 索引級別: {df_reset.index.nlevels}, 列數: {len(df_reset.columns)}\")\n",
    "print(\"\\n轉換後的數據:\")\n",
    "print(df_reset.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 6: 多層索引 get_level_values"
   ]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: 多層索引 get_level_values\""}, "source": "### 範例 6: 多層索引 get_level_values"
  },
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 提取特定層級的值\n",
    "print(\"\\n=== 範例 6: 提取索引層級值 ===\")\n",
    "print(\"\\n層級 0 (State) 的唯一值:\")\n",
    "print(df_multi4.index.get_level_values(0).unique())\n",
    "\n",
    "print(\"\\n層級 1 (Year) 的唯一值:\")\n",
    "print(df_multi4.index.get_level_values(1).unique())\n",
    "\n",
    "print(\"\\n層級 2 (Month) 的唯一值:\")\n",
    "print(sorted(df_multi4.index.get_level_values(2).unique()))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 7: 多層索引 droplevel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 移除特定層級的索引\n",
    "df_drop_level = df_multi4.droplevel('Month')\n",
    "\n",
    "print(\"\\n=== 範例 7: droplevel 移除索引層級 ===\")\n",
    "print(f\"原始索引名稱: {df_multi4.index.names}\")\n",
    "print(f\"移除 'Month' 後: {df_drop_level.index.names}\")\n",
    "print(f\"新的行數（重複值合併）: {len(df_drop_level)}\")\n",
    "print(\"\\n前5行:\")\n",
    "print(df_drop_level.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 8: 多層索引的 sortlevel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 按層級排序\n",
    "df_sorted = df_multi4.sortlevel(['State', 'Year'], sort_remaining=True)\n",
    "\n",
    "print(\"\\n=== 範例 8: 按層級排序 ===\")\n",
    "print(\"排序前:\")\n",
    "print(df_multi4.head(8).index.tolist())\n",
    "print(\"\\n排序後 (按 State 和 Year):\")\n",
    "print(df_sorted.head(8).index.tolist())"
   ]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 9: MultiIndex 重索引 reindex\""}, "source": "### 範例 9: MultiIndex 重索引 reindex"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 使用 from_product 建立完整的索引網格\n",
    "new_index = pd.MultiIndex.from_product(\n",
    "    [['SP', 'RJ', 'MG'], [2017, 2018], range(1, 13)],\n",
    "    names=['State', 'Year', 'Month']\n",
    ")\n",
    "\n",
    "df_reindex = df_multi4.reindex(new_index, fill_value=np.nan)\n",
    "\n",
    "print(\"\\n=== 範例 9: reindex 重新索引 ===\")\n",
    "print(f\"原始行數: {len(df_multi4)}\")\n",
    "print(f\"重索引後行數: {len(df_reindex)}\")\n",
    "print(f\"缺失值數量: {df_reindex['Revenue'].isna().sum()}\")\n",
    "print(\"\\n包含 NaN 的部分數據:\")\n",
    "print(df_reindex[df_reindex['Revenue'].isna()].head())"
   ]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 10: 多層索引的層級交換 swaplevel\""}, "source": "### 範例 10: 多層索引的層級交換 swaplevel"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 交換索引層級\n",
    "df_swap = df_multi4.swaplevel('State', 'Year')\n",
    "\n",
    "print(\"\\n=== 範例 10: swaplevel 交換索引層級 ===\")\n",
    "print(f\"原始索引層級: {df_multi4.index.names}\")\n",
    "print(f\"交換後索引層級: {df_swap.index.names}\")\n",
    "print(\"\\n原始前5行索引:\")\n",
    "print(df_multi4.head().index.tolist())\n",
    "print(\"\\n交換後前5行索引:\")\n",
    "print(df_swap.head().index.tolist())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 3: MultiIndex 切片（10 個範例）\n",
    "\n",
    "### 範例 1: loc 基礎切片"
   ]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 1: loc 基礎切片\""}, "source": "### 範例 1: loc 基礎切片"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 使用 loc 進行多層索引切片\n",
    "print(\"\\n=== 範例 1: loc 基礎切片 ===\")\n",
    "\n",
    "# 選擇特定州\n",
    "sp_data = df_multi4.loc['SP']\n",
    "print(f\"\\nSP 州的數據行數: {len(sp_data)}\")\n",
    "print(sp_data.head())\n",
    "\n",
    "# 選擇特定州和年份\n",
    "sp_2018 = df_multi4.loc[('SP', 2018)]\n",
    "print(f\"\\nSP 州 2018 年的數據行數: {len(sp_2018)}\")\n",
    "print(sp_2018.head())"
   ]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: loc 範圍切片\""}, "source": "### 範例 2: loc 範圍切片"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# 使用 slice 進行範圍切片\n", "print(\"\\n=== 範例 2: loc 範圍切片 ===\")\n", "\n", "# 選擇多個州\n", "multi_state = df_multi4.loc[['SP', 'RJ', 'MG']]\n", "print(f\"SP, RJ, MG 的數據行數: {len(multi_state)}\")\n", "print(multi_state.groupby(level=0).size())"]]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 範例 3: xs 跨層級切片"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 使用 xs 在特定層級進行切片\n",
    "print(\"\\n=== 範例 3: xs 跨層級切片 ===\")\n",
    "\n",
    "# 選擇所有 2018 年的數據\n",
    "year_2018 = df_multi4.xs(2018, level='Year')\n",
    "print(f\"2018 年數據行數: {len(year_2018)}\")\n",
    "print(year_2018.head())\n",
    "\n",
    "# 選擇特定州的特定年份\n",
    "sp_2017 = df_multi4.xs(('SP', 2017), level=('State', 'Year'))\n",
    "print(f\"\\nSP 州 2017 年數據行數: {len(sp_2017)}\")\n",
    "print(sp_2017)"
   ]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: loc 與 xs 的性能對比\""}, "source": "### 範例 4: loc 與 xs 的性能對比"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import time\n", "\n", "print(\"\\n=== 範例 4: loc 與 xs 性能對比 ===\")\n", "\n", "# 測試 loc\n", "start = time.time()\n", "for _ in range(1000):\n", "    _ = df_multi4.loc[('SP', 2018)]\n", "loc_time = time.time() - start\n", "\n", "# 測試 xs\n", "start = time.time()\n", "for _ in range(1000):\n", "    _ = df_multi4.xs(('SP', 2018), level=('State', 'Year'))\n", "xs_time = time.time() - start\n", "\n", "print(f\"loc 用時: {loc_time:.4f} 秒\")\n", "print(f\"xs 用時: {xs_time:.4f} 秒\")\n", "print(f\"xs 快 {loc_time/xs_time:.2f} 倍\") if xs_time > 0 else None"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: 使用 IndexSlice 進階切片\""}, "source": "### 範例 5: 使用 IndexSlice 進階切片"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# IndexSlice 用於複雜的多層索引切片\n", "print(\"\\n=== 範例 5: IndexSlice 進階切片 ===\")\n", "\n", "idx = pd.IndexSlice\n", "\n", "# 選擇特定州和月份範圍\n", "result = df_multi4.loc[idx[['SP', 'RJ'], :, [1, 2, 3]], :]\n", "print(f\"SP, RJ 州 1-3月份的數據行數: {len(result)}\")\n", "print(result.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: 按列名多層索引切片\""}, "source": "### 範例 6: 按列名多層索引切片"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# 創建列也是多層索引的數據\n", "print(\"\\n=== 範例 6: 按列多層索引切片 ===\")\n", "\n", "columns = pd.MultiIndex.from_product(\n", "    [['Sales', 'Cost'], ['2017', '2018']],\n", "    names=['Metric', 'Year']\n", ")\n", "\n", "df_col_multi = pd.DataFrame(\n", "    np.random.uniform(1000, 10000, (len(df_multi4), 4)),\n", "    index=df_multi4.index,\n", "    columns=columns\n", ")\n", "\n", "print(f\"列索引層級: {df_col_multi.columns.nlevels}\")\n", "print(\"\\n選擇 Sales 列:\")\n", "print(df_col_multi['Sales'].head())\n", "\n", "print(\"\\n選擇 2017 年列:\")\n", "print(df_col_multi.xs('2017', level='Year', axis=1).head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: 使用 isin 進行多層索引篩選\""}, "source": "### 範例 7: 使用 isin 進行多層索引篩選"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# 使用 isin 篩選多層索引\n", "print(\"\\n=== 範例 7: isin 進行多層索引篩選 ===\")\n", "\n", "# 篩選特定州和月份的組合\n", "mask = df_multi4.index.get_level_values('State').isin(['SP', 'MG']) & \\\n", "       df_multi4.index.get_level_values('Month').isin([1, 6, 12])\n", "\n", "result = df_multi4[mask]\n", "print(f\"篩選結果行數: {len(result)}\")\n", "print(result)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: 多層索引的 query\""}, "source": "### 範例 8: 多層索引的 query"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# 使用 query 進行條件查詢\n", "print(\"\\n=== 範例 8: query 進行複雜篩選 ===\")\n", "\n", "df_reset_for_query = df_multi4.reset_index()\n", "result = df_reset_for_query.query(\"State == 'SP' and Year == 2018 and Month >= 6\")\n", "\n", "print(f\"查詢結果行數: {len(result)}\")\n", "print(result)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 9: 多層索引的條件篩選\""}, "source": "### 範例 9: 多層索引的條件篩選"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# 基於值的條件篩選\n", "print(\"\\n=== 範例 9: 基於值的多層索引篩選 ===\")\n", "\n", "# 選擇收入大於平均值的行\n", "avg_revenue = df_multi4['Revenue'].mean()\n", "high_revenue = df_multi4[df_multi4['Revenue'] > avg_revenue]\n", "\n", "print(f\"平均收入: ${avg_revenue:,.2f}\")\n", "print(f\"高收入行數: {len(high_revenue)} (佔 {len(high_revenue)/len(df_multi4)*100:.1f}%)\")\n", "print(\"\\n高收入數據樣本:\")\n", "print(high_revenue.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 10: 多層索引嵌套選擇\""}, "source": "### 範例 10: 多層索引嵌套選擇"
  },
  {
