   "cell_type": {"text/plain": "\"## Part 4: MultiIndex 重塑（8 個範例）\""}, "source": "## Part 4: MultiIndex 重塑（8 個範例）\n\n### 範例 1: stack 操作"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 1: stack 操作 ===\")\n", "\n", "# stack 將列轉換為行索引\n", "df_wide = pd.DataFrame({\n", "    '2017_Sales': [100000, 150000, 120000],\n", "    '2017_Cost': [50000, 75000, 60000],\n", "    '2018_Sales': [150000, 180000, 160000],\n", "    '2018_Cost': [70000, 90000, 80000]\n", "}, index=['SP', 'RJ', 'MG'])\n", "\n", "print(\"原始寬表:\")\n", "print(df_wide)\n", "\n", "# 簡單 stack\n", "df_stacked = df_wide.stack()\n", "print(\"\\nStack 後 (列變為行索引):\")\n", "print(df_stacked)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: unstack 操作\""}, "source": "### 範例 2: unstack 操作"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: unstack 操作 ===\")\n", "\n", "# unstack 將行索引轉換為列\n", "df_unstacked = df_stacked.unstack()\n", "print(\"Unstack 後 (恢復為寬表):\")\n", "print(df_unstacked)\n", "\n", "# 驗證是否恢復原始數據\n", "print(f\"\\n是否相同: {df_unstacked.equals(df_wide)}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 特定層級的 stack\""}, "source": "### 範例 3: 特定層級的 stack"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 特定層級的 stack ===\")\n", "\n", "# 創建多層列索引的數據\n", "columns = pd.MultiIndex.from_product(\n", "    [['Revenue', 'Cost'], ['Q1', 'Q2']],\n", "    names=['Metric', 'Quarter']\n", ")\n", "\n", "df_multi_col = pd.DataFrame(\n", "    np.random.uniform(10000, 100000, (3, 4)),\n", "    index=['SP', 'RJ', 'MG'],\n", "    columns=columns\n", ")\n", "\n", "print(\"原始多層列數據:\")\n", "print(df_multi_col)\n", "\n", "# Stack 特定層級\n", "stacked = df_multi_col.stack(level='Quarter')\n", "print(\"\\nStack 'Quarter' 層級後:\")\n", "print(stacked)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: unstack 特定層級\""}, "source": "### 範例 4: unstack 特定層級"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: unstack 特定層級 ===\")\n", "\n", "# 建立多層行索引數據\n", "index = pd.MultiIndex.from_product(\n", "    [['SP', 'RJ'], [2017, 2018], ['Q1', 'Q2']],\n", "    names=['State', 'Year', 'Quarter']\n", ")\n", "\n", "df_multi_row = pd.DataFrame({\n", "    'Sales': np.random.uniform(10000, 100000, len(index)),\n", "    'Cost': np.random.uniform(5000, 50000, len(index))\n", "}, index=index)\n", "\n", "print(\"原始多層行索引數據 (前6行):\")\n", "print(df_multi_row.head(6))\n", "\n", "# Unstack 特定層級\n", "unstacked = df_multi_row.unstack(level='Quarter')\n", "print(\"\\nUnstack 'Quarter' 層級後 (前4行):\")\n", "print(unstacked.head(4))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: swaplevel 交換層級\""}, "source": "### 範例 5: swaplevel 交換層級"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: swaplevel 交換層級 ===\")\n", "\n", "# 交換行索引的層級\n", "swapped = df_multi_row.swaplevel('State', 'Year')\n", "print(f\"原始索引順序: {df_multi_row.index.names}\")\n", "print(f\"交換後索引順序: {swapped.index.names}\")\n", "\n", "print(\"\\n原始前4行:\")\n", "print(df_multi_row.head(4).index.tolist())\n", "\n", "print(\"\\n交換後前4行:\")\n", "print(swapped.head(4).index.tolist())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: swaplevel + sort_index\""}, "source": "### 範例 6: swaplevel + sort_index"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: swaplevel + sort_index ===\")\n", "\n", "# 交換層級後排序\n", "swapped_sorted = df_multi_row.swaplevel('Year', 'Quarter').sort_index()\n", "\n", "print(\"交換後排序的前8行:\")\n", "print(swapped_sorted.head(8))\n", "\n", "print(\"\\n按照新的層級順序 (Year, State, Quarter) 已排序\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: reorder_levels\""}, "source": "### 範例 7: reorder_levels"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: reorder_levels 重新排列層級 ===\")\n", "\n", "# 完全重新排列層級順序\n", "reordered = df_multi_row.reorder_levels(['Quarter', 'State', 'Year'])\n", "\n", "print(f\"原始層級順序: {df_multi_row.index.names}\")\n", "print(f\"重新排列後: {reordered.index.names}\")\n", "print(\"\\n前4行:\")\n", "print(reordered.head(4))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: pivoting - 從長表到寬表\""}, "source": "### 範例 8: pivoting - 從長表到寬表"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: Pivoting 操作 ===\")\n", "\n", "# 長表數據\n", "df_long = df_multi_row.reset_index()\n", "print(\"\\n長表 (前5行):\")\n", "print(df_long.head())\n", "\n", "# Pivot 轉為寬表\n", "df_pivot = df_long.pivot_table(\n", "    index=['State', 'Year'],\n", "    columns='Quarter',\n", "    values=['Sales', 'Cost'],\n", "    aggfunc='sum'\n", ")\n", "\n", "print(\"\\nPivot 後的寬表:\")\n", "print(df_pivot)"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 5: 實戰案例（5 個完整案例）\""}, "source": "## Part 5: 實戰案例（5 個完整案例）\n\n### 案例 1: 地區-類別-月份三維銷售分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 1: 地區-類別-月份三維銷售分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_case1 = orders.merge(order_items, on='order_id') \\\n", "    .merge(products, on='product_id') \\\n", "    .merge(customers[['customer_id', 'customer_state', 'customer_city']], on='customer_id')\n", "\n", "# 轉換日期並提取年月\n", "df_case1['order_month'] = pd.to_datetime(df_case1['order_purchase_timestamp']).dt.to_period('M')\n", "df_case1['order_date'] = pd.to_datetime(df_case1['order_purchase_timestamp']).dt.date\n", "\n", "# 建立三層索引\n", "df_case1_multi = df_case1.set_index(['customer_state', 'product_category_name', 'order_month'])\n", "\n", "# 計算銷售額\n", "sales_3d = df_case1_multi.groupby(level=[0, 1, 2])['price'].agg(['sum', 'mean', 'count'])\n", "sales_3d.columns = ['Total_Sales', 'Avg_Price', 'Qty']\n", "\n", "print(f\"\\n三維銷售數據索引層級: {sales_3d.index.nlevels}\")\n", "print(f\"總行數: {len(sales_3d)}\")\n", "print(\"\\n前10行:\")\n", "print(sales_3d.head(10))\n", "\n", "# 查詢特定地區\n", "print(\"\\n=== SP 州的銷售情況 ===\")\n", "sp_sales = sales_3d.loc['SP']\n", "print(sp_sales.head(10))\n", "\n", "# 查詢特定地區和類別\n", "print(\"\\n=== SP 州電子類的銷售情況 ===\")\n", "sp_electronics = sales_3d.loc[('SP', 'electronics')]\n", "print(sp_electronics.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 2: 產品層次結構分析\""}, "source": "### 案例 2: 產品層次結構分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 2: 產品層次結構分析\")\n", "print(\"=\"*60)\n", "\n", "# 建立產品層次索引\n", "df_product_hier = order_items.merge(products[['product_id', 'product_category_name']], on='product_id') \\\n", "    .set_index(['product_category_name', 'product_id'])\n", "\n", "# 聚合數據\n", "product_sales = df_product_hier.groupby(level=[0, 1]).agg({\n", "    'price': ['sum', 'mean', 'min', 'max'],\n", "    'order_id': 'count',\n", "    'freight_value': 'mean'\n", "})\n", "\n", "product_sales.columns = ['Total_Sales', 'Avg_Price', 'Min_Price', 'Max_Price', 'Quantity', 'Avg_Freight']\n", "\n", "print(f\"\\n產品層次結構行數: {len(product_sales)}\")\n", "print(f\"類別數: {product_sales.index.get_level_values(0).nunique()}\")\n", "print(f\"產品數: {product_sales.index.get_level_values(1).nunique()}\")\n", "\n", "# 按類別分析\n", "print(\"\\n=== 各類別銷售概況 ===\")\n", "category_summary = product_sales.groupby(level=0).agg('sum')\n", "category_summary = category_summary.sort_values('Total_Sales', ascending=False)\n", "print(category_summary.head(10))\n", "\n", "# 找出各類別最暢銷產品\n", "print(\"\\n=== 各類別最暢銷產品 ===\")\n", "for category in ['electronics', 'fashion', 'furniture']:\n", "    if category in product_sales.index.get_level_values(0):\n", "        top_product = product_sales.loc[category].nlargest(1, 'Quantity')\n", "        if len(top_product) > 0:\n", "            print(f\"{category}: {top_product['Quantity'].values[0]:.0f} 件\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 3: 時間序列多維度分析\""}, "source": "### 案例 3: 時間序列多維度分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 3: 時間序列多維度分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備時間序列數據\n", "df_time = orders.merge(order_items, on='order_id') \\\n", "    .merge(customers[['customer_id', 'customer_state']], on='customer_id')\n", "\n", "# 轉換日期並提取年月日\n", "df_time['purchase_date'] = pd.to_datetime(df_time['order_purchase_timestamp'])\n", "df_time['year'] = df_time['purchase_date'].dt.year\n", "df_time['month'] = df_time['purchase_date'].dt.month\n", "df_time['week'] = df_time['purchase_date'].dt.isocalendar().week\n", "\n", "# 建立時間序列多層索引\n", "df_time_multi = df_time.set_index(['year', 'month', 'week', 'customer_state'])\n", "\n", "# 聚合銷售額\n", "timeseries_sales = df_time_multi.groupby(level=[0, 1, 2, 3])['price'].agg(['sum', 'count'])\n", "timeseries_sales.columns = ['Sales', 'Orders']\n", "\n", "print(f\"\\n時間序列多維數據行數: {len(timeseries_sales)}\")\n", "print(\"\\n前10行:\")\n", "print(timeseries_sales.head(10))\n", "\n", "# 按年分析\n", "print(\"\\n=== 按年份統計 ===\")\n", "yearly = timeseries_sales.groupby(level=0).agg('sum')\n", "print(yearly)\n", "\n", "# 比較不同州的月度銷售\n", "print(\"\\n=== 2018 年各州月度銷售對比 ===\")\n", "state_monthly = timeseries_sales.loc[2018].groupby(level=[0, 1]).agg('sum')\n", "state_monthly_pivot = state_monthly.unstack(level=0)\n", "print(state_monthly_pivot.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 4: 客戶分群多層次分析\""}, "source": "### 案例 4: 客戶分群多層次分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 4: 客戶分群多層次分析\")\n", "print(\"=\"*60)\n", "\n", "# 計算客戶購買指標\n", "df_customer = orders.merge(order_items, on='order_id') \\\n", "    .merge(customers[['customer_id', 'customer_state']], on='customer_id')\n", "\n", "# 按客戶計算購買次數和總金額\n", "customer_metrics = df_customer.groupby('customer_id').agg({\n", "    'order_id': 'nunique',\n", "    'price': 'sum',\n", "    'customer_state': 'first'\n", "})\n", "\n", "customer_metrics.columns = ['Order_Count', 'Total_Spend', 'State']\n", "\n", "# 分層客戶（基於消費金額）\n", "customer_metrics['Customer_Tier'] = pd.qcut(\n", "    customer_metrics['Total_Spend'],\n", "    q=3,\n", "    labels=['Bronze', 'Silver', 'Gold']\n", ")\n", "\n", "# 建立多層索引\n", "df_customer_multi = customer_metrics.reset_index().set_index(['Customer_Tier', 'State', 'customer_id'])\n", "\n", "# 分析\n", "print(f\"\\n客戶分層多維數據行數: {len(df_customer_multi)}\")\n", "print(\"\\n前10行:\")\n", "print(df_customer_multi.head(10))\n", "\n", "# 按層級統計\n", "print(\"\\n=== 客戶層級統計 ===\")\n", "tier_stats = df_customer_multi.groupby(level='Customer_Tier').agg({\n", "    'Order_Count': ['sum', 'mean'],\n", "    'Total_Spend': ['sum', 'mean']\n", "})\n", "print(tier_stats)\n", "\n", "# 分析最高消費客戶\n", "print(\"\\n=== 金牌客戶分布 ===\")\n", "gold_customers = df_customer_multi.xs('Gold', level='Customer_Tier')\n", "gold_by_state = gold_customers.groupby(level='State').size().sort_values(ascending=False)\n", "print(gold_by_state.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 5: 綜合多維度儀表板\""}, "source": "### 案例 5: 綜合多維度儀表板"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 5: 綜合多維度銷售儀表板\")\n", "print(\"=\"*60)\n", "\n", "# 整合所有維度\n", "df_dashboard = orders.merge(order_items, on='order_id') \\\n", "    .merge(products[['product_id', 'product_category_name']], on='product_id') \\\n", "    .merge(customers[['customer_id', 'customer_state']], on='customer_id') \\\n", "    .merge(reviews[['order_id', 'review_score']], on='order_id', how='left')\n", "\n", "df_dashboard['order_date'] = pd.to_datetime(df_dashboard['order_purchase_timestamp'])\n", "df_dashboard['order_year'] = df_dashboard['order_date'].dt.year\n", "df_dashboard['order_month'] = df_dashboard['order_date'].dt.month\n", "df_dashboard['order_quarter'] = df_dashboard['order_date'].dt.quarter\n", "\n", "# 建立儀表板多層索引\n", "df_dash_multi = df_dashboard.set_index(\n", "    ['order_year', 'order_quarter', 'customer_state', 'product_category_name']\n", ")\n", "\n", "# 計算多個指標\n", "dashboard_metrics = df_dash_multi.groupby(level=[0, 1, 2, 3]).agg({\n", "    'price': ['sum', 'mean', 'count'],\n", "    'freight_value': 'mean',\n", "    'review_score': 'mean',\n", "    'order_id': 'nunique'\n", "})\n", "\n", "dashboard_metrics.columns = ['GMV', 'Avg_Price', 'Items', 'Avg_Freight', 'Avg_Rating', 'Orders']\n", "\n", "print(f\"\\n儀表板數據行數: {len(dashboard_metrics)}\")\n", "print(\"\\n前10行:\")\n", "print(dashboard_metrics.head(10))\n", "\n", "# 儀表板分析 1: 按年度\n", "print(\"\\n=== 年度業績對比 ===\")\n", "yearly_perf = dashboard_metrics.groupby(level=0).agg('sum')\n", "yearly_perf['Avg_Rating'] = dashboard_metrics['Avg_Rating'].groupby(level=0).mean()\n", "print(yearly_perf)\n", "\n", "# 儀表板分析 2: 最高銷售州份\n", "print(\"\\n=== 各州銷售業績 (2018 年) ===\")\n", "state_perf = dashboard_metrics.xs(2018, level='order_year').groupby(level='customer_state').agg('sum').sort_values('GMV', ascending=False)\n", "print(state_perf.head(10))\n", "\n", "# 儀表板分析 3: 產品類別績效\n", "print(\"\\n=== 產品類別績效 (2018 年, 第四季) ===\")\n", "category_perf = dashboard_metrics.xs((2018, 4), level=('order_year', 'order_quarter')).groupby(level='product_category_name').agg('sum').sort_values('GMV', ascending=False)\n", "print(category_perf.head(10))"]]
  },
