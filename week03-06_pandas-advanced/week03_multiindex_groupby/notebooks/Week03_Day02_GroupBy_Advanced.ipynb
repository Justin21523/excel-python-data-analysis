   "cell_type": {"text/plain": "\"### 案例 6: 綜合業績儀表板\""}, "source": "### 案例 6: 綜合業績儀表板"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 6: 綜合業績儀表板\")\n", "print(\"=\"*60)\n", "\n", "# 準備完整數據\n", "df_dashboard = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ").merge(\n", "    products[['product_id', 'product_category_name']], on='product_id'\n", ").merge(\n", "    reviews[['order_id', 'review_score']], on='order_id', how='left'\n", ")\n", "\n", "df_dashboard['order_date'] = pd.to_datetime(df_dashboard['order_purchase_timestamp']).dt.date\n", "\n", "# 全局 KPI\n", "print(\"\\n=== 全局 KPI ===\")\n", "print(f\"總訂單數: {df_dashboard['order_id'].nunique():,}\")\n", "print(f\"總訂單明細: {len(df_dashboard):,}\")\n", "print(f\"總銷售額: R$ {df_dashboard['price'].sum():,.2f}\")\n", "print(f\"平均訂單金額: R$ {df_dashboard.groupby('order_id')['price'].sum().mean():.2f}\")\n", "print(f\"平均評分: {df_dashboard['review_score'].mean():.2f}\")\n", "print(f\"評分覆蓋率: {df_dashboard['review_score'].notna().sum() / df_dashboard['order_id'].nunique() * 100:.1f}%\")\n", "\n", "# 區域分析\n", "print(\"\\n=== 頂級州份 ===\")\n", "state_kpis = df_dashboard.groupby('customer_state').agg(\n", "    orders=('order_id', 'nunique'),\n", "    revenue=('price', 'sum'),\n", "    avg_rating=('review_score', 'mean')\n", ")\n", "print(state_kpis.nlargest(5, 'revenue'))\n", "\n", "# 類別分析\n", "print(\"\\n=== 產品類別績效 ===\")\n", "category_kpis = df_dashboard.groupby('product_category_name').agg(\n", "    items_sold=('price', 'count'),\n", "    revenue=('price', 'sum'),\n", "    avg_price=('price', 'mean'),\n", "    avg_rating=('review_score', 'mean')\n", ")\n", "print(category_kpis.nlargest(5, 'revenue'))\n", "\n", "print(\"\\n✅ GroupBy 進階實踐課程結束！\")"]]
