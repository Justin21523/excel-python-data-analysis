  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: Filter 與排名結合 ===\")\n", "\n", "# 在每個產品內排名，然後過濾\n", "order_items['price_rank'] = order_items.groupby('product_id')['price'].rank(method='dense', ascending=False)\n", "\n", "# 只保留每個產品的前 3 高價格\n", "top_3_prices = order_items.groupby('product_id').filter(lambda x: (x['price'].rank(method='dense', ascending=False) <= 3).any())\n", "\n", "print(f\"原始行數: {len(order_items)}\")\n", "print(f\"篩選後行數: {len(top_3_prices)}\")\n", "\n", "# 顯示示例\n", "print(\"\\nProduct 4f3fac9d84c4854bb09665f2e98dc236 的前 3 高價格:\")\n", "sample_product = 'df41cf8c-f9d5-46f5-84a6-b5dfd02e7944'\n", "sample_data = order_items[order_items['product_id'] == sample_product].nlargest(3, 'price')\n", "if len(sample_data) > 0:\n", "    print(sample_data[['product_id', 'price', 'freight_value']].head())"]]
