  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 11: Transform 的性能優化 ===\")\n", "\n", "import time\n", "\n", "# 方法 1: 用 transform\n", "start = time.time()\n", "result1 = order_items.copy()\n", "result1['group_mean'] = order_items.groupby('product_id')['price'].transform('mean')\n", "time1 = time.time() - start\n", "\n", "# 方法 2: 先 agg 再 merge\n", "start = time.time()\n", "group_means = order_items.groupby('product_id')['price'].mean().reset_index()\n", "group_means.columns = ['product_id', 'group_mean']\n", "result2 = order_items.merge(group_means, on='product_id')\n", "time2 = time.time() - start\n", "\n", "print(f\"\\nTransform 方法用時: {time1*1000:.2f} ms\")\n", "print(f\"Merge 方法用時: {time2*1000:.2f} ms\")\n", "print(f\"Transform 快 {time2/time1:.2f} 倍\")"]]
