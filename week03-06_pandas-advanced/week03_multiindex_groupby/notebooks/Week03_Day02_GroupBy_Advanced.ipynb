   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 1: GroupBy 基礎回顧（8 個範例）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import sys\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 設置顯示選項\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.max_rows', 100)\n",
    "pd.set_option('display.width', None)\n",
    "pd.set_option('display.float_format', lambda x: f'{x:.2f}' if abs(x) < 1000 else f'{x:,.2f}')\n",
    "\n",
    "# 載入資料\n",
    "sys.path.append('../../utils')\n",
    "from data_loader import load_olist_data\n",
    "\n",
    "orders, order_items, products, customers, sellers, payments, reviews = load_olist_data()\n",
    "\n",
    "print(\"✅ 環境設置完成\")"
   ]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 1: 基本 GroupBy 與單一聚合函數\""}, "source": "### 範例 1: 基本 GroupBy 與單一聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 1: 基本 GroupBy 操作 ===\")\n", "\n", "# 按客戶分組計算訂單總數\n", "customer_orders = orders.groupby('customer_id')['order_id'].count()\n", "\n", "print(f\"GroupBy 結果類型: {type(customer_orders)}\")\n", "print(f\"群組數量: {len(customer_orders)}\")\n", "print(f\"\\n前 10 個客戶的訂單數:\")\n", "print(customer_orders.head(10))\n", "\n", "print(f\"\\n統計信息:\")\n", "print(customer_orders.describe())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: GroupBy 多個列\""}, "source": "### 範例 2: GroupBy 多個列"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 多列 GroupBy ===\")\n", "\n", "# 準備數據\n", "df = orders.merge(customers[['customer_id', 'customer_state']], on='customer_id')\n", "\n", "# 按州和訂單狀態分組\n", "state_status = df.groupby(['customer_state', 'order_status']).size().reset_index(name='count')\n", "\n", "print(f\"\\n多列 GroupBy 結果行數: {len(state_status)}\")\n", "print(state_status.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 多個聚合函數\""}, "source": "### 範例 3: 多個聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 多個聚合函數 ===\")\n", "\n", "# 按產品分組計算多個統計量\n", "product_stats = order_items.groupby('product_id')['price'].agg([\n", "    ('total_sales', 'sum'),\n", "    ('avg_price', 'mean'),\n", "    ('min_price', 'min'),\n", "    ('max_price', 'max'),\n", "    ('count', 'count'),\n", "    ('std_dev', 'std')\n", "])\n", "\n", "print(f\"\\n統計列數: {len(product_stats.columns)}\")\n", "print(product_stats.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: 按不同列應用不同聚合函數\""}, "source": "### 範例 4: 按不同列應用不同聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: 不同列不同聚合函數 ===\")\n", "\n", "# 準備訂單明細數據\n", "order_detail = orders.merge(order_items, on='order_id')\n", "\n", "# 為不同的列應用不同的聚合函數\n", "agg_dict = {\n", "    'order_id': 'count',  # 訂單項目數\n", "    'price': ['sum', 'mean'],  # 銷售額和平均價格\n", "    'freight_value': 'mean'  # 平均運費\n", "}\n", "\n", "order_summary = order_detail.groupby('customer_id').agg(agg_dict)\n", "\n", "print(f\"\\n聚合後的列:\")\n", "print(order_summary.columns.tolist())\n", "print(f\"\\n前 5 行:\")\n", "print(order_summary.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: GroupBy 結果過濾\""}, "source": "### 範例 5: GroupBy 結果過濾"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: GroupBy 結果過濾 ===\")\n", "\n", "# 計算每個客戶的訂單數\n", "customer_order_count = orders.groupby('customer_id')['order_id'].count()\n", "\n", "# 過濾出多次購買的客戶（2 次及以上）\n", "repeat_customers = customer_order_count[customer_order_count >= 2]\n", "\n", "print(f\"\\n總客戶數: {len(customer_order_count)}\")\n", "print(f\"重複購買客戶數: {len(repeat_customers)}\")\n", "print(f\"重複購買率: {len(repeat_customers)/len(customer_order_count)*100:.1f}%\")\n", "\n", "print(f\"\\n重複購買客戶訂單數分布:\")\n", "print(repeat_customers.value_counts().head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: 多層索引 GroupBy 結果\""}, "source": "### 範例 6: 多層索引 GroupBy 結果"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: 多層索引 GroupBy 結果 ===\")\n", "\n", "# 準備數據\n", "df_multi = orders.merge(order_items, on='order_id') \\\n", "    .merge(customers[['customer_id', 'customer_state']], on='customer_id')\n", "\n", "df_multi['order_month'] = pd.to_datetime(df_multi['order_purchase_timestamp']).dt.to_period('M')\n", "\n", "# 多層 GroupBy\n", "multi_group = df_multi.groupby(['customer_state', 'order_month'])['price'].agg(['sum', 'count'])\n", "\n", "print(f\"\\n索引級別: {multi_group.index.nlevels}\")\n", "print(f\"結果行數: {len(multi_group)}\")\n", "print(\"\\n前 10 行:\")\n", "print(multi_group.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: GroupBy 對象的遍歷\""}, "source": "### 範例 7: GroupBy 對象的遍歷"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: GroupBy 對象遍歷 ===\")\n", "\n", "# 按州分組\n", "grouped = orders.merge(customers[['customer_id', 'customer_state']], on='customer_id').groupby('customer_state')\n", "\n", "print(f\"\\n群組數量: {grouped.ngroups}\")\n", "\n", "# 遍歷前 3 個群組\n", "print(\"\\n前 3 個州的訂單統計:\")\n", "for i, (state, group) in enumerate(grouped):\n", "    if i >= 3:\n", "        break\n", "    print(f\"\\n{state}: {len(group)} 個訂單\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: GroupBy 的 get_group 方法\""}, "source": "### 範例 8: GroupBy 的 get_group 方法"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: get_group 提取特定群組 ===\")\n", "\n", "# 提取特定州的數據\n", "sp_data = grouped.get_group('SP')\n", "\n", "print(f\"\\nSP 州訂單數: {len(sp_data)}\")\n", "print(f\"訂單狀態分布:\")\n", "print(sp_data['order_status'].value_counts())\n", "\n", "print(f\"\\nSP 州訂單日期範圍:\")\n", "print(f\"最早: {sp_data['order_purchase_timestamp'].min()}\")\n", "print(f\"最晚: {sp_data['order_purchase_timestamp'].max()}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 2: 命名聚合（10 個範例）\""}, "source": "## Part 2: 命名聚合（10 個範例）\n\n### 範例 1: 基本命名聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 2: 命名聚合\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: 基本命名聚合 ===\")\n", "\n", "# 使用命名聚合改善可讀性\n", "customer_agg = orders.merge(order_items, on='order_id').groupby('customer_id').agg(\n", "    total_orders=('order_id', 'nunique'),\n", "    total_spent=('price', 'sum'),\n", "    avg_price=('price', 'mean'),\n", "    item_count=('price', 'count')\n", ")\n", "\n", "print(f\"\\n聚合後列名: {customer_agg.columns.tolist()}\")\n", "print(customer_agg.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 元組型命名聚合\""}, "source": "### 範例 2: 元組型命名聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 元組型命名聚合 ===\")\n", "\n", "# 使用元組語法: (column, function, output_name)\n", "order_detail = orders.merge(order_items, on='order_id')\n", "\n", "sales_agg = order_detail.groupby('order_id').agg(\n", "    total_price=('price', 'sum'),\n", "    item_qty=('price', 'count'),\n", "    min_item_price=('price', 'min'),\n", "    max_item_price=('price', 'max')\n", ")\n", "\n", "print(f\"\\n聚合結果:\")\n", "print(sales_agg.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 多列多函數的命名聚合\""}, "source": "### 範例 3: 多列多函數的命名聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 多列多函數命名聚合 ===\")\n", "\n", "df_agg = order_detail.groupby('customer_id').agg(\n", "    # 訂單相關\n", "    num_orders=('order_id', 'nunique'),\n", "    # 價格相關\n", "    total_sales=('price', 'sum'),\n", "    avg_item_price=('price', 'mean'),\n", "    price_std=('price', 'std'),\n", "    # 運費相關\n", "    total_freight=('freight_value', 'sum'),\n", "    avg_freight=('freight_value', 'mean'),\n", "    # 商品數量\n", "    total_items=('price', 'count')\n", ")\n", "\n", "print(f\"\\n聚合欄位數: {len(df_agg.columns)}\")\n", "print(df_agg.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: 命名聚合與自訂函數\""}, "source": "### 範例 4: 命名聚合與自訂函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: 命名聚合與自訂函數 ===\")\n", "\n", "# 定義自訂函數\n", "def price_range(x):\n", "    return x.max() - x.min()\n", "\n", "def quartile_25(x):\n", "    return x.quantile(0.25)\n", "\n", "def quartile_75(x):\n", "    return x.quantile(0.75)\n", "\n", "# 使用命名聚合結合自訂函數\n", "product_agg = order_items.groupby('product_id').agg(\n", "    sales_volume=('price', 'count'),\n", "    avg_price=('price', 'mean'),\n", "    price_range=('price', price_range),\n", "    price_q25=('price', quartile_25),\n", "    price_q75=('price', quartile_75),\n", "    total_revenue=('price', 'sum')\n", ")\n", "\n", "print(f\"\\n聚合結果:\")\n", "print(product_agg.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: Lambda 表達式在命名聚合中的應用\""}, "source": "### 範例 5: Lambda 表達式在命名聚合中的應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: Lambda 表達式在命名聚合中 ===\")\n", "\n", "category_agg = order_items.merge(products[['product_id', 'product_category_name']], on='product_id').groupby('product_category_name').agg(\n", "    total_items=('price', 'count'),\n", "    total_sales=('price', 'sum'),\n", "    avg_price=('price', 'mean'),\n", "    # 使用 lambda 計算價格中位數\n", "    price_median=('price', lambda x: x.median()),\n", "    # 使用 lambda 計算高於平均值的比例\n", "    high_price_ratio=('price', lambda x: (x > x.mean()).sum() / len(x)),\n", "    # 使用 lambda 計算客製化指標\n", "    price_per_item=('price', lambda x: x.sum() / len(x))\n", ")\n", "\n", "print(f\"\\n聚合結果:\")\n", "print(category_agg)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: 命名聚合的列順序\""}, "source": "### 範例 6: 命名聚合的列順序"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: 命名聚合的列順序 ===\")\n", "\n", "# Python 3.7+ 保證字典順序，所以聚合函數的順序被保留\n", "agg_result = order_detail.groupby('customer_id').agg(\n", "    # 第1組: 訂單指標\n", "    num_orders=('order_id', 'nunique'),\n", "    # 第2組: 銷售指標\n", "    total_sales=('price', 'sum'),\n", "    avg_price=('price', 'mean'),\n", "    # 第3組: 物流指標\n", "    total_freight=('freight_value', 'sum'),\n", "    # 第4組: 計數\n", "    item_count=('price', 'count')\n", ")\n", "\n", "print(f\"\\n列的順序: {agg_result.columns.tolist()}\")\n", "print(agg_result.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: 處理缺失值的聚合\""}, "source": "### 範例 7: 處理缺失值的聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: 處理缺失值的聚合 ===\")\n", "\n", "# 合併包含評論的數據\n", "df_with_reviews = order_detail.merge(reviews[['order_id', 'review_score']], on='order_id', how='left')\n", "\n", "review_agg = df_with_reviews.groupby('customer_id').agg(\n", "    order_count=('order_id', 'nunique'),\n", "    reviewed_count=('review_score', 'count'),  # 非缺失值計數\n", "    avg_rating=('review_score', 'mean'),  # 自動忽略 NaN\n", "    rating_std=('review_score', 'std'),\n", "    has_review_ratio=('review_score', lambda x: x.notna().sum() / len(x))\n", ")\n", "\n", "print(f\"\\n聚合結果:\")\n", "print(review_agg.head())\n", "\n", "print(f\"\\n缺失值檢查:\")\n", "print(review_agg.isna().sum())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: 條件聚合\""}, "source": "### 範例 8: 條件聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: 條件聚合 ===\")\n", "\n", "# 計算不同訂單狀態的訂單數\n", "df_status = order_detail.merge(\n", "    customers[['customer_id', 'customer_state']], \n", "    on='customer_id'\n", ")\n", "\n", "status_agg = df_status.groupby('customer_state').agg(\n", "    total_orders=('order_id', 'nunique'),\n", "    delivered_orders=('order_status', lambda x: (x == 'delivered').sum()),\n", "    cancelled_orders=('order_status', lambda x: (x == 'canceled').sum()),\n", "    pending_orders=('order_status', lambda x: (x != 'delivered').sum())\n", ")\n", "\n", "print(f\"\\n聚合結果:\")\n", "print(status_agg.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 9: 命名聚合結果的進一步處理\""}, "source": "### 範例 9: 命名聚合結果的進一步處理"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 9: 聚合結果的進一步處理 ===\")\n", "\n", "customer_metrics = order_detail.groupby('customer_id').agg(\n", "    total_orders=('order_id', 'nunique'),\n", "    total_spent=('price', 'sum'),\n", "    avg_order_value=('price', 'mean'),\n", "    num_items=('price', 'count')\n", ")\n", "\n", "# 衍生新列\n", "customer_metrics['avg_items_per_order'] = customer_metrics['num_items'] / customer_metrics['total_orders']\n", "customer_metrics['customer_value_tier'] = pd.cut(\n", "    customer_metrics['total_spent'],\n", "    bins=[0, 100, 500, 1000, np.inf],\n", "    labels=['Bronze', 'Silver', 'Gold', 'Platinum']\n", ")\n", "\n", "print(f\"\\n增強後的結果:\")\n", "print(customer_metrics.head())\n", "\n", "print(f\"\\n客戶層級分布:\")\n", "print(customer_metrics['customer_value_tier'].value_counts())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 10: 複雜的多層命名聚合\""}, "source": "### 範例 10: 複雜的多層命名聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 10: 複雜的多層命名聚合 ===\")\n", "\n", "df_complex = order_detail.merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ").merge(\n", "    products[['product_id', 'product_category_name']], on='product_id'\n", )\n", "\n", "complex_agg = df_complex.groupby(['customer_state', 'product_category_name']).agg(\n", "    # 交易指標\n", "    transaction_count=('order_id', 'nunique'),\n", "    item_count=('price', 'count'),\n", "    # 金額指標\n", "    total_sales=('price', 'sum'),\n", "    avg_price=('price', 'mean'),\n", "    price_std=('price', 'std'),\n", "    # 物流指標\n", "    total_freight=('freight_value', 'sum'),\n", "    avg_freight=('freight_value', 'mean')\n", ")\n", "\n", "# 計算衍生指標\n", "complex_agg['avg_items_per_order'] = complex_agg['item_count'] / complex_agg['transaction_count']\n", "complex_agg['logistics_cost_ratio'] = complex_agg['total_freight'] / complex_agg['total_sales']\n", "\n", "print(f\"\\n聚合結果形狀: {complex_agg.shape}\")\n", "print(\"\\n前 10 行:\")\n", "print(complex_agg.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 3: Transform vs Agg vs Filter（12 個範例）\""}, "source": "## Part 3: Transform vs Agg vs Filter（12 個範例）\n\n### 範例 1: Agg - 聚合為單值"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 3: Transform vs Agg vs Filter\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: Agg - 聚合為單值 ===\")\n", "\n", "# agg 將每個群組縮減為單個值\n", "agg_result = order_items.groupby('product_id')['price'].agg(['sum', 'mean', 'count'])\n", "\n", "print(f\"原始行數: {len(order_items)}\")\n", "print(f\"Agg 後行數: {len(agg_result)}\")\n", "print(f\"Agg 後列數: {len(agg_result.columns)}\")\n", "print(\"\\n前 5 行:\")\n", "print(agg_result.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: Transform - 返回與原始形狀相同的數據\""}, "source": "### 範例 2: Transform - 返回與原始形狀相同的數據"
  },
  {
