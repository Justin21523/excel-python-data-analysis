   "cell_type": {"text/plain": "\"### 案例 4: 產品類別交叉銷售分析\""}, "source": "### 案例 4: 產品類別交叉銷售分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 4: 產品類別交叉銷售分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據 - 找出在同一訂單中購買的產品類別組合\n", "df_cross = orders.merge(order_items, on='order_id').merge(\n", "    products[['product_id', 'product_category_name']], on='product_id'\n", ")\n", "\n", "# 計算每個訂單的類別多樣性\n", "order_categories = df_cross.groupby('order_id')['product_category_name'].agg([\n", "    'count',\n", "    'nunique',\n", "    ('categories', lambda x: ', '.join(x.unique()))\n", "])\n", "\n", "order_categories.columns = ['total_items', 'unique_categories', 'category_list']\n", "\n", "# 計算類別組合頻率\n", "print(\"\\n多類別購買分析:\")\n", "print(f\"只購買單一類別的訂單: {(order_categories['unique_categories'] == 1).sum()}\")\n", "print(f\"購買多類別的訂單: {(order_categories['unique_categories'] > 1).sum()}\")\n", "print(f\"多類別購買率: {(order_categories['unique_categories'] > 1).sum() / len(order_categories) * 100:.1f}%\")\n", "\n", "# 平均購買類別數\n", "print(f\"\\n平均購買類別數: {order_categories['unique_categories'].mean():.2f}\")\n", "print(f\"購買類別數分布:\")\n", "print(order_categories['unique_categories'].value_counts().sort_index())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 5: 訂單完成度與評分分析\""}, "source": "### 案例 5: 訂單完成度與評分分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 5: 訂單完成度與評分分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_quality = orders.merge(order_items, on='order_id').merge(\n", "    reviews[['order_id', 'review_score']], on='order_id', how='left'\n", ")\n", "\n", "# 計算訂單層級指標\n", "order_quality = df_quality.groupby('order_id').agg(\n", "    status=('order_status', 'first'),\n", "    total_items=('price', 'count'),\n", "    total_amount=('price', 'sum'),\n", "    review_score=('review_score', 'first'),\n", "    has_review=('review_score', 'count')\n", ")\n", "\n", "order_quality['has_review'] = order_quality['has_review'] > 0\n", "\n", "# 按訂單狀態統計\n", "print(\"\\n訂單狀態分布:\")\n", "status_summary = order_quality.groupby('status').agg({\n", "    'status': 'count',\n", "    'total_amount': 'mean',\n", "    'review_score': ['mean', 'count'],\n", "    'has_review': lambda x: (x).sum() / len(x) * 100\n", "})\n", "\n", "status_summary.columns = ['訂單數', '平均金額', '平均評分', '有評分訂單數', '評分率']\n", "print(status_summary)\n", "\n", "# 按評分分析\n", "print(\"\\n按評分等級的訂單統計:\")\n", "rating_summary = order_quality[order_quality['has_review']].copy()\n", "rating_summary['rating_level'] = pd.cut(\n", "    rating_summary['review_score'],\n", "    bins=[0, 2, 3, 4, 5],\n", "    labels=['差', '一般', '好', '非常好']\n", ")\n", "\n", "rating_stats = rating_summary.groupby('rating_level').agg({\n", "    'total_amount': ['count', 'mean'],\n", "    'review_score': 'mean'\n", "})\n", "print(rating_stats)"]]
  },
