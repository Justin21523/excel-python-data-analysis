   "cell_type": {"text/plain": "\"### 範例 12: 複雜場景的綜合應用\""}, "source": "### 範例 12: 複雜場景的綜合應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 12: 複雜場景綜合應用 ===\")\n", "\n", "# 場景: 計算每個訂單相對於其產品平均價格的偏差\n", "# 並只保留偏差較大的訂單\n", "\n", "# Step 1: Transform - 添加產品平均價格\n", "df = order_items.copy()\n", "df['product_avg_price'] = df.groupby('product_id')['price'].transform('mean')\n", "\n", "# Step 2: 計算偏差\n", "df['price_deviation'] = df['price'] - df['product_avg_price']\n", "df['deviation_pct'] = (df['price_deviation'] / df['product_avg_price'] * 100).abs()\n", "\n", "# Step 3: Filter - 只保留偏差 > 20% 的\n", "high_deviation = df[df['deviation_pct'] > 20]\n", "\n", "print(f\"\\n原始訂單明細: {len(df)}\")\n", "print(f\"高偏差訂單: {len(high_deviation)}\")\n", "print(f\"比例: {len(high_deviation)/len(df)*100:.1f}%\")\n", "\n", "# Step 4: Agg - 統計高偏差訂單的產品\n", "high_dev_stats = high_deviation.groupby('product_id').agg({\n", "    'price': ['count', 'mean'],\n", "    'deviation_pct': 'mean'\n", "})\n", "\n", "print(\"\\n高偏差訂單最多的產品 Top 5:\")\n", "print(high_dev_stats.sort_values(('price', 'count'), ascending=False).head())"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 4: 自訂聚合函數（8 個範例）\""}, "source": "## Part 4: 自訂聚合函數（8 個範例）\n\n### 範例 1: 簡單的自訂聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 4: 自訂聚合函數\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: 簡單的自訂聚合函數 ===\")\n", "\n", "# 定義自訂函數\n", "def range_func(x):\n", "    \"\"\"計算數值範圍\"\"\"\n", "    return x.max() - x.min()\n", "\n", "def cv_func(x):\n", "    \"\"\"變異係數（標準差/平均值）\"\"\"\n", "    return x.std() / x.mean() if x.mean() != 0 else 0\n", "\n", "def q90_func(x):\n", "    \"\"\"90 分位數\"\"\"\n", "    return x.quantile(0.9)\n", "\n", "# 使用自訂函數\n", "product_custom_agg = order_items.groupby('product_id')['price'].agg([\n", "    ('range', range_func),\n", "    ('cv', cv_func),\n", "    ('q90', q90_func)\n", "])\n", "\n", "print(\"\\n前 10 行:\")\n", "print(product_custom_agg.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 返回 Series 的自訂聚合函數\""}, "source": "### 範例 2: 返回 Series 的自訂聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 返回 Series 的自訂聚合函數 ===\")\n", "\n", "def price_percentiles(x):\n", "    \"\"\"計算多個分位數\"\"\"\n", "    return pd.Series({\n", "        'p10': x.quantile(0.1),\n", "        'p25': x.quantile(0.25),\n", "        'p50': x.quantile(0.5),\n", "        'p75': x.quantile(0.75),\n", "        'p90': x.quantile(0.9)\n", "    })\n", "\n", "percentile_agg = order_items.groupby('product_id')['price'].apply(price_percentiles)\n", "\n", "print(f\"\\n結果形狀: {percentile_agg.shape}\")\n", "print(\"\\n前 5 個產品的分位數:\")\n", "print(percentile_agg.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 帶條件的自訂聚合函數\""}, "source": "### 範例 3: 帶條件的自訂聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 帶條件的自訂聚合函數 ===\")\n", "\n", "def category_stats(x):\n", "    \"\"\"計算多個條件統計\"\"\"\n", "    return pd.Series({\n", "        'total': x.sum(),\n", "        'count': len(x),\n", "        'mean': x.mean(),\n", "        'above_mean': (x > x.mean()).sum(),\n", "        'below_mean': (x < x.mean()).sum(),\n", "        'outliers': ((x - x.mean()).abs() > 2 * x.std()).sum()\n", "    })\n", "\n", "stats_result = order_items.groupby('product_id')['price'].apply(category_stats)\n", "\n", "print(f\"\\n結果形狀: {stats_result.shape}\")\n", "print(\"\\n前 5 個產品:\")\n", "print(stats_result.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: 多列自訂聚合函數\""}, "source": "### 範例 4: 多列自訂聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: 多列自訂聚合函數 ===\")\n", "\n", "def revenue_analysis(group):\n", "    \"\"\"複合分析函數\"\"\"\n", "    return pd.Series({\n", "        'item_count': len(group),\n", "        'total_revenue': group['price'].sum(),\n", "        'total_freight': group['freight_value'].sum(),\n", "        'revenue_per_item': group['price'].sum() / len(group),\n", "        'freight_ratio': group['freight_value'].sum() / group['price'].sum(),\n", "        'avg_order_value': group.groupby('order_id')['price'].sum().mean()\n", "    })\n", "\n", "revenue_result = order_items.groupby('product_id').apply(revenue_analysis)\n", "\n", "print(f\"\\n結果形狀: {revenue_result.shape}\")\n", "print(\"\\n前 5 個產品:\")\n", "print(revenue_result.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: 條件計數函數\""}, "source": "### 範例 5: 條件計數函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: 條件計數函數 ===\")\n", "\n", "def condition_counter(x):\n", "    \"\"\"計算各種條件下的計數\"\"\"\n", "    return pd.Series({\n", "        'total_items': len(x),\n", "        'high_price_items': (x > 100).sum(),\n", "        'medium_price_items': ((x >= 50) & (x < 100)).sum(),\n", "        'low_price_items': (x < 50).sum(),\n", "        'expensive_pct': (x > 100).sum() / len(x) * 100,\n", "        'cheap_pct': (x < 50).sum() / len(x) * 100\n", "    })\n", "\n", "condition_result = order_items.groupby('product_id')['price'].apply(condition_counter)\n", "\n", "print(f\"\\n結果形狀: {condition_result.shape}\")\n", "print(\"\\n前 10 個產品:\")\n", "print(condition_result.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: 使用 NamedAgg 定義自訂聚合\""}, "source": "### 範例 6: 使用 NamedAgg 定義自訂聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: 使用 NamedAgg 定義自訂聚合 ===\")\n", "\n", "# NamedAgg 可以更清晰地定義列名\n", "from pandas import NamedAgg\n", "\n", "named_agg_result = order_items.groupby('product_id').agg(\n", "    item_count=NamedAgg(column='price', aggfunc='count'),\n", "    total_sales=NamedAgg(column='price', aggfunc='sum'),\n", "    avg_price=NamedAgg(column='price', aggfunc='mean'),\n", "    price_std=NamedAgg(column='price', aggfunc='std'),\n", "    total_freight=NamedAgg(column='freight_value', aggfunc='sum'),\n", "    avg_freight=NamedAgg(column='freight_value', aggfunc='mean')\n", ")\n", "\n", "print(f\"\\n列名: {named_agg_result.columns.tolist()}\")\n", "print(\"\\n前 5 行:\")\n", "print(named_agg_result.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: 鏈式聚合函數\""}, "source": "### 範例 7: 鏈式聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: 鏈式聚合函數 ===\")\n", "\n", "# 定義多個簡單函數，然後組合\n", "def calculate_metrics(group):\n", "    metrics = {}\n", "    metrics['count'] = len(group)\n", "    metrics['sum'] = group.sum()\n", "    metrics['mean'] = group.mean()\n", "    metrics['median'] = group.median()\n", "    metrics['std'] = group.std()\n", "    # 衍生指標\n", "    metrics['cv'] = metrics['std'] / metrics['mean'] if metrics['mean'] != 0 else 0\n", "    metrics['range'] = group.max() - group.min()\n", "    return pd.Series(metrics)\n", "\n", "chain_result = order_items.groupby('product_id')['price'].apply(calculate_metrics)\n", "\n", "print(f\"\\n結果形狀: {chain_result.shape}\")\n", "print(\"\\n前 5 個產品:\")\n", "print(chain_result.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: 複雜的多群組自訂聚合\""}, "source": "### 範例 8: 複雜的多群組自訂聚合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: 複雜的多群組自訂聚合 ===\")\n", "\n", "# 準備數據\n", "df_multi = order_items.merge(\n", "    orders[['order_id', 'order_status']], on='order_id'\n", ").merge(\n", "    products[['product_id', 'product_category_name']], on='product_id'\n", ")\n", "\n", "def detailed_analysis(group):\n", "    return pd.Series({\n", "        'total_items': len(group),\n", "        'completed_items': (group['order_status'] == 'delivered').sum(),\n", "        'cancelled_items': (group['order_status'] == 'canceled').sum(),\n", "        'completion_rate': (group['order_status'] == 'delivered').sum() / len(group) * 100,\n", "        'total_revenue': group['price'].sum(),\n", "        'avg_price': group['price'].mean(),\n", "        'revenue_per_unit': group['price'].sum() / len(group)\n", "    })\n", "\n", "detailed_result = df_multi.groupby('product_category_name').apply(detailed_analysis)\n", "\n", "print(f\"\\n結果形狀: {detailed_result.shape}\")\n", "print(\"\\n所有類別的詳細分析:\")\n", "print(detailed_result)"]]
