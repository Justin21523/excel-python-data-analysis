   "cell_type": {"text/plain": "\"## Part 5: 實戰案例（6 個完整案例）\""}, "source": "## Part 5: 實戰案例（6 個完整案例）\n\n### 案例 1: 客戶生命週期價值（LTV）分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 5: 實戰案例\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n\" + \"=\"*60)\n", "print(\"案例 1: 客戶生命週期價值（LTV）分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_ltv = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ").merge(\n", "    reviews[['order_id', 'review_score']], on='order_id', how='left'\n", ")\n", "\n", "# 計算客戶 LTV\n", "ltv_analysis = df_ltv.groupby('customer_id').agg(\n", "    total_spent=('price', 'sum'),\n", "    order_count=('order_id', 'nunique'),\n", "    item_count=('price', 'count'),\n", "    avg_order_value=('price', 'mean'),\n", "    avg_rating=('review_score', 'mean'),\n", "    state=('customer_state', 'first')\n", ")\n", "\n", "# 按消費金額分層\n", "ltv_analysis['customer_tier'] = pd.qcut(\n", "    ltv_analysis['total_spent'],\n", "    q=4,\n", "    labels=['Bronze', 'Silver', 'Gold', 'Platinum'],\n", "    duplicates='drop'\n", ")\n", "\n", "print(f\"\\n客戶總數: {len(ltv_analysis)}\")\n", "print(\"\\n客戶層級分布:\")\n", "print(ltv_analysis['customer_tier'].value_counts().sort_index())\n", "\n", "print(\"\\n按層級的統計:\")\n", "tier_stats = ltv_analysis.groupby('customer_tier').agg({\n", "    'total_spent': ['mean', 'median', 'sum'],\n", "    'order_count': 'mean',\n", "    'avg_rating': 'mean',\n", "    'customer_tier': 'count'\n", "})\n", "print(tier_stats)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 2: 產品銷售績效對標\""}, "source": "### 案例 2: 產品銷售績效對標"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 2: 產品銷售績效對標\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_product_perf = order_items.merge(\n", "    products[['product_id', 'product_category_name']], on='product_id'\n", ")\n", "\n", "# 計算產品績效\n", "product_performance = df_product_perf.groupby('product_id').agg(\n", "    sales_volume=('price', 'count'),\n", "    total_revenue=('price', 'sum'),\n", "    avg_price=('price', 'mean'),\n", "    category=('product_category_name', 'first')\n", ")\n", "\n", "# 計算每個產品與類別平均值的對標\n", "category_avg = df_product_perf.groupby('product_category_name')['price'].agg(['mean', 'sum'])\n", "\n", "# 合併數據\n", "product_performance = product_performance.merge(\n", "    category_avg.rename(columns={'mean': 'category_avg_price', 'sum': 'category_total_revenue'}),\n", "    left_on='category',\n", "    right_index=True\n", ")\n", "\n", "# 計算績效指標\n", "product_performance['price_vs_category'] = (\n", "    (product_performance['avg_price'] - product_performance['category_avg_price']) / \n", "    product_performance['category_avg_price'] * 100\n", ")\n", "\n", "# 按類別排名\n", "product_performance['category_rank'] = product_performance.groupby('category')['total_revenue'].rank(ascending=False)\n", "\n", "print(\"\\n銷售績效最好的 10 個產品:\")\n", "top_products = product_performance.nlargest(10, 'total_revenue')\n", "print(top_products[['sales_volume', 'total_revenue', 'avg_price', 'category', 'category_rank']])"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 3: 州級銷售趨勢分析\""}, "source": "### 案例 3: 州級銷售趨勢分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 3: 州級銷售趨勢分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_state = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "df_state['order_month'] = pd.to_datetime(df_state['order_purchase_timestamp']).dt.to_period('M')\n", "df_state['year'] = df_state['order_month'].dt.year\n", "df_state['month'] = df_state['order_month'].dt.month\n", "\n", "# 計算州級月度銷售\n", "state_monthly = df_state.groupby(['customer_state', 'order_month']).agg(\n", "    monthly_revenue=('price', 'sum'),\n", "    monthly_orders=('order_id', 'nunique'),\n", "    monthly_items=('price', 'count')\n", ")\n", "\n", "# 計算增長指標\n", "state_monthly['avg_order_value'] = state_monthly['monthly_revenue'] / state_monthly['monthly_orders']\n", "\n", "print(f\"\\n監控的州級數: {df_state['customer_state'].nunique()}\")\n", "print(f\"監控月度數: {df_state['order_month'].nunique()}\")\n", "\n", "print(\"\\nTop 5 州級的最近 3 個月銷售:\")\n", "top_states = df_state['customer_state'].value_counts().head(5).index\n", "for state in top_states:\n", "    state_data = state_monthly.xs(state).tail(3)\n", "    print(f\"\\n{state} 州:\")\n", "    print(state_data)"]]
  },
