  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: 自訂函數在 Transform 中 ===\")\n", "\n", "# 定義自訂的標準化函數\n", "def standardize(x):\n", "    return (x - x.mean()) / x.std()\n", "\n", "def min_max_scale(x):\n", "    return (x - x.min()) / (x.max() - x.min())\n", "\n", "# 應用自訂函數\n", "order_items_scaled = order_items.copy()\n", "order_items_scaled['price_standardized'] = order_items.groupby('product_id')['price'].transform(standardize)\n", "order_items_scaled['price_scaled'] = order_items.groupby('product_id')['price'].transform(min_max_scale)\n", "\n", "print(\"\\n前 5 行:\")\n", "print(order_items_scaled[['product_id', 'price', 'price_standardized', 'price_scaled']].head())\n", "\n", "print(f\"\\n標準化後的統計:\")\n", "print(order_items_scaled['price_standardized'].describe())"]]
