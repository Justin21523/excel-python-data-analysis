   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 9: Agg 與 Filter 結合 ===\")\n", "\n", "# 步驟 1: 先用 filter 保留高銷量產品\n", "min_sales = order_items.groupby('product_id').size().quantile(0.75)\n", "high_volume = order_items.groupby('product_id').filter(lambda x: len(x) >= min_sales)\n", "\n", "# 步驟 2: 再用 agg 計算統計\n", "high_volume_stats = high_volume.groupby('product_id')['price'].agg([\n", "    ('sales_count', 'count'),\n", "    ('total_sales', 'sum'),\n", "    ('avg_price', 'mean'),\n", "    ('std_price', 'std')\n", "])\n", "\n", "print(f\"\\n銷量門檻: {min_sales:.0f}\")\n", "print(f\"高銷量產品數: {len(high_volume_stats)}\")\n", "print(\"\\n前 10 個:\")\n", "print(high_volume_stats.head(10))"]]
