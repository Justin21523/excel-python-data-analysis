   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 10: Apply 與其他方法的對比 ===\")\n", "\n", "# Apply: 可以返回 Series 或 DataFrame\n", "def custom_agg(group):\n", "    return pd.Series({\n", "        'count': len(group),\n", "        'sum': group['price'].sum(),\n", "        'mean': group['price'].mean(),\n", "        'median': group['price'].median(),\n", "        'q90': group['price'].quantile(0.9)\n", "    })\n", "\n", "apply_result = order_items.groupby('product_id').apply(custom_agg)\n", "\n", "print(f\"Apply 結果形狀: {apply_result.shape}\")\n", "print(\"\\n前 5 行:\")\n", "print(apply_result.head())\n", "\n", "print(f\"\\n與 agg 對比:\")\n", "agg_result = order_items.groupby('product_id')['price'].agg(['count', 'sum', 'mean', ('median', 'median')])\n", "print(agg_result.head())"]]
