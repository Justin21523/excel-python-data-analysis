    "# 按月份和州的銷售趨勢\n",
    "pivot_time = pd.pivot_table(\n",
    "    df,\n",
    "    values='price',\n",
    "    index='order_month',\n",
    "    columns='customer_state',\n",
    "    aggfunc='sum',\n",
    "    fill_value=0\n",
