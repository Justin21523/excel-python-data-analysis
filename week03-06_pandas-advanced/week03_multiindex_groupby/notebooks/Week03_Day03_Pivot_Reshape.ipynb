  {
   "cell_type": {"text/plain": "\"## Part 1: 環境設置與資料載入\""}, "source": "## Part 1: 環境設置與資料載入"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import pandas as pd\n", "import numpy as np\n", "import sys\n", "import warnings\n", "warnings.filterwarnings('ignore')\n", "\n", "# 設置顯示選項\n", "pd.set_option('display.max_columns', None)\n", "pd.set_option('display.max_rows', 100)\n", "pd.set_option('display.width', None)\n", "pd.set_option('display.float_format', lambda x: f'{x:.2f}' if abs(x) < 1000 else f'{x:,.2f}')\n", "\n", "# 載入資料\n", "sys.path.append('../../utils')\n", "from data_loader import load_olist_data\n", "\n", "orders, order_items, products, customers, sellers, payments, reviews = load_olist_data()\n", "\n", "print(\"✅ 環境設置完成\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 2: pivot_table 完整應用（12 個範例）\n\n### 範例 1: 基本 pivot_table\""}, "source": "## Part 2: pivot_table 完整應用（12 個範例）\n\n### 範例 1: 基本 pivot_table"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 2: pivot_table 完整應用\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: 基本 pivot_table ===\")\n", "\n", "# 準備數據\n", "df = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "# 創建簡單的透視表\n", "pivot_simple = pd.pivot_table(\n", "    df,\n", "    values='price',\n", "    index='customer_state',\n", "    columns='order_status',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(\"\\n按州和訂單狀態的銷售額透視表:\")\n", "print(pivot_simple)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 多個 values 的 pivot_table\""}, "source": "### 範例 2: 多個 values 的 pivot_table"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 多個 values 的 pivot_table ===\")\n",
    "\n",
    "# 多個聚合值\n",
    "pivot_multi = pd.pivot_table(\n",
    "    df,\n",
    "    values=['price', 'freight_value'],\n",
    "    index='customer_state',\n",
    "    columns='order_status',\n",
    "    aggfunc=['sum', 'mean'],\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "print(f\"\\n透視表形狀: {pivot_multi.shape}\")\n",
    "print(\"\\n前 5 個州:\")\n",
    "print(pivot_multi.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 多層行索引的 pivot_table\""}, "source": "### 範例 3: 多層行索引的 pivot_table"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 多層行索引的 pivot_table ===\")\n",
    "\n",
    "# 準備數據\n",
    "df['order_month'] = pd.to_datetime(df['order_purchase_timestamp']).dt.to_period('M')\n",
    "\n",
    "# 多層行索引\n",
    "pivot_multi_index = pd.pivot_table(\n",
    "    df,\n",
    "    values='price',\n",
    "    index=['customer_state', 'order_month'],\n",
    "    columns='order_status',\n",
    "    aggfunc='sum',\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "print(f\"\\n透視表形狀: {pivot_multi_index.shape}\")\n",
    "print(f\"索引級別: {pivot_multi_index.index.nlevels}\")\n",
    "print(\"\\n前 10 行:\")\n",
    "print(pivot_multi_index.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: 多層列索引的 pivot_table\""}, "source": "### 範例 4: 多層列索引的 pivot_table"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: 多層列索引的 pivot_table ===\")\n",
    "\n",
    "# 準備數據\n",
    "df_cat = df.merge(products[['product_id', 'product_category_name']], on='product_id')\n",
    "\n",
    "# 多層列索引\n",
    "pivot_col_multi = pd.pivot_table(\n",
    "    df_cat,\n",
    "    values='price',\n",
    "    index='customer_state',\n",
    "    columns=['order_status', 'product_category_name'],\n",
    "    aggfunc='sum',\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "print(f\"\\n透視表形狀: {pivot_col_multi.shape}\")\n",
    "print(f\"列索引級別: {pivot_col_multi.columns.nlevels}\")\n",
    "print(\"\\n前 3 個州:\")\n",
    "print(pivot_col_multi.head(3))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: 不同的聚合函數\""}, "source": "### 範例 5: 不同的聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: 不同的聚合函數 ===\")\n",
    "\n",
    "# 自訂聚合函數\n",
    "def std_pct(x):\n",
    "    return x.std() / x.mean() * 100 if x.mean() != 0 else 0\n",
    "\n",
    "# 多個聚合函數\n",
    "pivot_agg = pd.pivot_table(\n",
    "    df,\n",
    "    values='price',\n",
    "    index='customer_state',\n",
    "    columns='order_status',\n",
    "    aggfunc=['sum', 'mean', 'count', std_pct],\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "print(f\"\\n聚合函數個數: 4\")\n",
    "print(f\"透視表形狀: {pivot_agg.shape}\")\n",
    "print(\"\\n聚合函數類型:\")\n",
    "print(pivot_agg.columns.get_level_values(0).unique())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: margins 參數（小計與總計）\""}, "source": "### 範例 6: margins 參數（小計與總計）"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: margins 參數（小計與總計）===\")\n",
    "\n",
    "# 添加總計行和列\n",
    "pivot_margins = pd.pivot_table(\n",
    "    df,\n",
    "    values='price',\n",
    "    index='customer_state',\n",
    "    columns='order_status',\n",
    "    aggfunc='sum',\n",
    "    fill_value=0,\n",
    "    margins=True,\n",
    "    margins_name='Total'\n",
    ")\n",
    "\n",
    "print(\"\\n包含總計的透視表:\")\n",
    "print(pivot_margins)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: dropna 參數\""}, "source": "### 範例 7: dropna 參數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: dropna 參數 ===\")\n",
    "\n",
    "# 不移除有 NaN 的列\n",
    "pivot_with_nan = pd.pivot_table(\n",
    "    df,\n",
    "    values='price',\n",
    "    index='customer_state',\n",
    "    columns='order_status',\n",
    "    aggfunc='sum',\n",
    "    dropna=False\n",
    ")\n",
    "\n",
    "print(f\"\\n包含 NaN 的列透視表:\")\n",
    "print(pivot_with_nan.head())\n",
    "\n",
    "# 與 dropna=True 對比\n",
    "pivot_no_nan = pd.pivot_table(\n",
    "    df,\n",
    "    values='price',\n",
    "    index='customer_state',\n",
    "    columns='order_status',\n",
    "    aggfunc='sum',\n",
    "    dropna=True\n",
    ")\n",
    "\n",
    "print(f\"\\nDropna=True 時的列: {pivot_no_nan.columns.tolist()}\")\n",
    "print(f\"Dropna=False 時的列: {pivot_with_nan.columns.tolist()}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: 百分比透視表\""}, "source": "### 範例 8: 百分比透視表"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: 百分比透視表 ===\")\n",
    "\n",
    "# 基礎透視表\n",
    "pivot_count = pd.pivot_table(\n",
    "    df,\n",
    "    values='order_id',\n",
    "    index='customer_state',\n",
    "    columns='order_status',\n",
    "    aggfunc='count',\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "# 轉換為百分比\n",
    "pivot_pct = pivot_count.div(pivot_count.sum(axis=1), axis=0) * 100\n",
    "\n",
    "print(\"\\n訂單狀態百分比分布:\")\n",
    "print(pivot_pct.round(2))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 9: 按月份的時間序列透視表\""}, "source": "### 範例 9: 按月份的時間序列透視表"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 9: 時間序列透視表 ===\")\n",
