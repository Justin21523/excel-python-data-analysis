  {
   "cell_type": {"text/plain": "\"### 案例 5: Stack/Unstack 進行數據重構\""}, "source": "### 案例 5: Stack/Unstack 進行數據重構"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 5: Stack/Unstack 進行數據重構\")\n", "print(\"=\"*60)\n", "\n", "# 原始透視表\n", "pivot_reconstruct = pd.pivot_table(\n", "    df_sales,\n", "    values='price',\n", "    index='customer_state',\n", "    columns='order_month',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(\"\\n步驟 1: 原始透視表 (前 3 行):\")\n", "print(pivot_reconstruct.head(3))\n", "\n", "# Stack 轉為長表\n", "long_format = pivot_reconstruct.stack().reset_index()\n", "long_format.columns = ['state', 'month', 'sales']\n", "\n", "print(\"\\n步驟 2: Stack 轉為長表 (前 10 行):\")\n", "print(long_format.head(10))\n", "\n", "# 進行計算\n", "long_format['sales_rank'] = long_format.groupby('month')['sales'].rank(ascending=False)\n", "long_format['monthly_pct'] = (\n", "    long_format.groupby('month')['sales'].transform(lambda x: x / x.sum() * 100)\n", ")\n", "\n", "print(\"\\n步驟 3: 添加計算列 (前 10 行):\")\n", "print(long_format.head(10))\n", "\n", "# 轉回寬表\n", "wide_final = pd.pivot_table(\n", "    long_format,\n", "    index='state',\n", "    columns='month',\n", "    values='sales_rank',\n", "    aggfunc='first'\n", ")\n", "\n", "print(\"\\n步驟 4: 轉回為排名寬表:\")\n", "print(wide_final.head(3))"]]
