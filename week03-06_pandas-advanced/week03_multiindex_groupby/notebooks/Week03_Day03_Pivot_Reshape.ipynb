  {
   "cell_type": {"text/plain": "\"### 案例 6: Melt 用於數據整合\""}, "source": "### 案例 6: Melt 用於數據整合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 6: Melt 用於數據整合\")\n", "print(\"=\"*60)\n", "\n", "# 建立多個寬表數據源\n", "sales_data_wide = pd.DataFrame({\n", "    'Store': ['Store_A', 'Store_B', 'Store_C'],\n", "    'Jan_2018': [100000, 120000, 90000],\n", "    'Feb_2018': [110000, 130000, 95000],\n", "    'Mar_2018': [120000, 140000, 100000]\n", "})\n", "\n", "cost_data_wide = pd.DataFrame({\n", "    'Store': ['Store_A', 'Store_B', 'Store_C'],\n", "    'Jan_2018': [50000, 60000, 45000],\n", "    'Feb_2018': [55000, 65000, 47000],\n", "    'Mar_2018': [60000, 70000, 50000]\n", "})\n", "\n", "print(\"\\n銷售寬表:\")\n", "print(sales_data_wide)\n", "\n", "print(\"\\n成本寬表:\")\n", "print(cost_data_wide)\n", "\n", "# Melt 銷售數據\n", "melted_sales = pd.melt(\n", "    sales_data_wide,\n", "    id_vars='Store',\n", "    var_name='Period',\n", "    value_name='Sales'\n", ")\n", "\n", "# Melt 成本數據\n", "melted_cost = pd.melt(\n", "    cost_data_wide,\n", "    id_vars='Store',\n", "    var_name='Period',\n", "    value_name='Cost'\n", ")\n", "\n", "# 合併\n", "merged = melted_sales.merge(melted_cost, on=['Store', 'Period'])\n", "\n", "# 計算利潤\n", "merged['Profit'] = merged['Sales'] - merged['Cost']\n", "merged['Profit_Margin'] = merged['Profit'] / merged['Sales'] * 100\n", "\n", "print(\"\\n整合後的數據 (前 10 行):\")\n", "print(merged.head(10))\n", "\n", "# 分析\n", "print(\"\\n\\n各店鋪的平均利潤率:\")\n", "print(merged.groupby('Store')['Profit_Margin'].mean().round(2))"]]
  },
