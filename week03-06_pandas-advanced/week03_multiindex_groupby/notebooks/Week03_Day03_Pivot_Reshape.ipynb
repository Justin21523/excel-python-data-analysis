    "print(\"\\n前 10 行:\")\n",
    "print(pivot_complex.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 11: pivot_table 的 sort 參數\""}, "source": "### 範例 11: pivot_table 的 sort 參數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 11: pivot_table 的 sort 參數 ===\")\n",
    "\n",
    "# 默認排序\n",
    "pivot_sorted = pd.pivot_table(\n",
    "    df,\n",
    "    values='price',\n",
    "    index='customer_state',\n",
    "    columns='order_status',\n",
    "    aggfunc='sum',\n",
    "    sort=True\n",
    ")\n",
    "\n",
    "print(\"\\n排序後的透視表:\")\n",
    "print(pivot_sorted)\n",
    "\n",
    "# 再按銷售額排序\n",
    "pivot_sorted['Total'] = pivot_sorted.sum(axis=1)\n",
    "pivot_sorted_total = pivot_sorted.sort_values('Total', ascending=False)\n",
    "\n",
    "print(\"\\n按總銷售額排序:\")\n",
    "print(pivot_sorted_total)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 12: 實用的業務透視表\""}, "source": "### 範例 12: 實用的業務透視表"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 12: 實用的業務透視表 ===\")\n",
    "\n",
    "# 創建銷售績效透視表\n",
    "# 1. 按州和類別的銷售額\n",
    "pivot_sales = pd.pivot_table(\n",
    "    df_cat,\n",
    "    values='price',\n",
    "    index='customer_state',\n",
    "    columns='product_category_name',\n",
    "    aggfunc='sum',\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "# 計算行占比\n",
    "pivot_sales_pct = pivot_sales.div(pivot_sales.sum(axis=1), axis=0) * 100\n",
    "\n",
    "print(\"\\n各州在不同類別的銷售占比 (%):\")\n",
    "print(pivot_sales_pct.round(1).head())\n",
    "\n",
    "# 2. 按月份的增長趨勢\n",
    "df_cat['order_year'] = df_cat['order_month'].dt.year\n",
    "df_cat['order_quarter'] = df_cat['order_month'].dt.quarter\n",
    "\n",
    "pivot_trend = pd.pivot_table(\n",
    "    df_cat,\n",
    "    values='price',\n",
    "    index='order_quarter',\n",
    "    columns='order_year',\n",
    "    aggfunc='sum',\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "print(\"\\n按季度和年份的銷售趨勢:\")\n",
    "print(pivot_trend)"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 3: stack/unstack 深度應用（10 個範例）\n\n### 範例 1: 基本 stack 操作\""}, "source": "## Part 3: stack/unstack 深度應用（10 個範例）\n\n### 範例 1: 基本 stack 操作"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 3: stack/unstack 深度應用\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: 基本 stack 操作 ===\")\n", "\n", "# 創建寬表\n", "wide_data = pd.DataFrame({\n", "    'A': [100, 200, 300],\n", "    'B': [150, 250, 350],\n", "    'C': [120, 220, 320]\n", "}, index=['Region1', 'Region2', 'Region3'])\n", "\n", "print(\"\\n原始寬表:\")\n", "print(wide_data)\n", "\n", "# Stack 操作\n", "stacked = wide_data.stack()\n", "print(\"\\nStack 後 (行索引多了一層):\")\n", "print(stacked)\n", "print(f\"\\n類型: {type(stacked)}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: Stack 後的 DataFrame 轉換\""}, "source": "### 範例 2: Stack 後的 DataFrame 轉換"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: Stack 後轉換為 DataFrame ===\")\n",
    "\n",
    "# Stack 返回 Series，可以轉換為 DataFrame\n",
    "stacked_df = stacked.reset_index()\n", "stacked_df.columns = ['Region', 'Product', 'Sales']\n", "\n", "print(\"\\nStack 後轉換為 DataFrame:\")\n", "print(stacked_df)\n", "print(f\"\\n形狀: {stacked_df.shape}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 選擇性的 Stack\""}, "source": "### 範例 3: 選擇性的 Stack"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 選擇性的 Stack ===\")\n",
    "\n", "# 多層列索引的數據\n", "columns = pd.MultiIndex.from_product(\n", "    [['Sales', 'Cost'], ['2017', '2018']],\n", "    names=['Metric', 'Year']\n", ")\n", "\n", "data = pd.DataFrame(\n", "    np.random.uniform(1000, 10000, (3, 4)),\n", "    index=['SP', 'RJ', 'MG'],\n", "    columns=columns\n", ")\n", "\n", "print(\"\\n原始多層列數據:\")\n", "print(data)\n", "\n", "# Stack 特定層級\n", "stacked_year = data.stack(level='Year')\n", "print(\"\\nStack 'Year' 後:\")\n", "print(stacked_year)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: 基本 Unstack\""}, "source": "### 範例 4: 基本 Unstack"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: 基本 Unstack ===\")\n",
    "\n", "# 從 Series 回到 DataFrame\n", "unstacked = stacked.unstack()\n", "\n", "print(\"\\nUnstack 後 (恢復寬表):\")\n", "print(unstacked)\n", "\n", "print(f\"\\n是否與原始數據相同: {unstacked.equals(wide_data)}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: Unstack 多層索引\""}, "source": "### 範例 5: Unstack 多層索引"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: Unstack 多層索引 ===\")\n",
    "\n", "# 構建多層行索引\n", "index = pd.MultiIndex.from_product(\n", "    [['SP', 'RJ'], [2017, 2018], ['Q1', 'Q2']],\n", "    names=['State', 'Year', 'Quarter']\n", ")\n", "\n", "multi_data = pd.DataFrame({\n", "    'Sales': np.random.uniform(10000, 100000, len(index)),\n", "    'Cost': np.random.uniform(5000, 50000, len(index))\n", "}, index=index)\n", "\n", "print(\"\\n原始多層索引數據 (前6行):\")\n", "print(multi_data.head(6))\n", "\n", "# Unstack 特定層級\n", "unstacked_quarter = multi_data.unstack(level='Quarter')\n", "print(\"\\nUnstack 'Quarter' 後:\")\n", "print(unstacked_quarter.head(4))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: 級聯 Unstack\""}, "source": "### 範例 6: 級聯 Unstack"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: 級聯 Unstack ===\")\n",
    "\n", "# 逐層 Unstack\n", "unstacked_1 = multi_data.unstack('Quarter')\n", "print(f\"\\nUnstack 1 層後的形狀: {unstacked_1.shape}\")\n", "\n", "unstacked_2 = unstacked_1.unstack('Year')\n", "print(f\"Unstack 2 層後的形狀: {unstacked_2.shape}\")\n", "\n", "print(\"\\n最終寬表 (前4行):\")\n", "print(unstacked_2.head(4))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: Unstack 後的缺失值處理\""}, "source": "### 範例 7: Unstack 後的缺失值處理"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: Unstack 後的缺失值處理 ===\")\n",
    "\n", "# 創建不完整的多層索引數據\n", "incomplete_index = pd.MultiIndex.from_tuples([\n", "    ('SP', 2017, 'Q1'), ('SP', 2017, 'Q2'), ('SP', 2018, 'Q1'),\n", "    ('RJ', 2017, 'Q1'), ('RJ', 2018, 'Q2'), ('RJ', 2018, 'Q3')\n", "], names=['State', 'Year', 'Quarter'])\n", "\n", "incomplete_data = pd.DataFrame({\n", "    'Sales': [100000, 150000, 180000, 120000, 200000, 160000]\n", "}, index=incomplete_index)\n", "\n", "print(\"\\n原始不完整數據:\")\n", "print(incomplete_data)\n", "\n", "# Unstack 會自動填入 NaN\n", "unstacked_incomplete = incomplete_data.unstack(fill_value=0)\n", "\n", "print(\"\\nUnstack 後 (使用 fill_value=0):\")\n", "print(unstacked_incomplete)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: Stack 與 Unstack 的實際應用\""}, "source": "### 範例 8: Stack 與 Unstack 的實際應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: Stack/Unstack 的實際應用 ===\")\n",
    "\n", "# 場景：從透視表轉回長表，進行進一步處理\n", "\n", "# 第 1 步：創建透視表\n", "pivot = pd.pivot_table(\n", "    df,\n", "    values='price',\n", "    index='customer_state',\n", "    columns='order_status',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(\"\\n第 1 步：透視表\")\n", "print(pivot.head())\n", "\n", "# 第 2 步：Stack 轉為長表\n", "long_table = pivot.stack().reset_index()\n", "long_table.columns = ['State', 'Status', 'Amount']\n", "\n", "print(\"\\n第 2 步：轉為長表\")\n", "print(long_table.head())\n", "\n", "# 第 3 步：進一步分析\n", "long_table['Percentage'] = (\n", "    long_table.groupby('State')['Amount'].transform(lambda x: x / x.sum() * 100)\n", ")\n", "\n", "print(\"\\n第 3 步：計算百分比\")\n", "print(long_table.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 9: 複雜的重塑操作\""}, "source": "### 範例 9: 複雜的重塑操作"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 9: 複雜的重塑操作 ===\")\n",
    "\n", "# 從長表到寬表，再進行各種重塑\n", "df_reshape = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "df_reshape['order_month'] = pd.to_datetime(df_reshape['order_purchase_timestamp']).dt.to_period('M')\n", "\n", "# 創建透視表\n", "pivot_reshape = pd.pivot_table(\n", "    df_reshape,\n", "    values='price',\n", "    index=['customer_state', 'order_month'],\n", "    columns='order_status',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "# Unstack 月份到列\n", "unstack_month = pivot_reshape.unstack('order_month')\n", "\n", "print(f\"\\n複雜重塑後的形狀: {unstack_month.shape}\")\n", "print(\"\\n前 3 個州:\")\n", "print(unstack_month.head(3))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 10: Stack/Unstack 的性能考量\""}, "source": "### 範例 10: Stack/Unstack 的性能考量"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 10: Stack/Unstack 的性能考量 ===\")\n",
    "\n", "import time\n", "\n", "# 創建大型數據集\n", "large_pivot = pd.pivot_table(\n", "    df_reshape,\n", "    values='price',\n", "    index='customer_state',\n", "    columns='order_month',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "# 測試 Stack 性能\n", "start = time.time()\n", "for _ in range(100):\n", "    _ = large_pivot.stack()\n", "stack_time = time.time() - start\n", "\n", "# 測試 Unstack 性能\n", "stacked = large_pivot.stack()\n", "start = time.time()\n", "for _ in range(100):\n", "    _ = stacked.unstack()\n", "unstack_time = time.time() - start\n", "\n", "print(f\"\\nStack 100 次耗時: {stack_time*1000:.2f} ms\")\n", "print(f\"Unstack 100 次耗時: {unstack_time*1000:.2f} ms\")\n", "print(f\"\\n原始透視表形狀: {large_pivot.shape}\")\n", "print(f\"Stack 後 Series 長度: {len(stacked)}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 4: melt 寬表變長表（8 個範例）\n\n### 範例 1: 基本 melt 操作\""}, "source": "## Part 4: melt 寬表變長表（8 個範例）\n\n### 範例 1: 基本 melt 操作"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 4: melt 寬表變長表\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: 基本 melt 操作 ===\")\n", "\n", "# 創建寬表\n", "wide = pd.DataFrame({\n", "    'Product': ['A', 'B', 'C'],\n", "    '2017': [100, 200, 300],\n", "    '2018': [150, 250, 350],\n", "    '2019': [200, 300, 400]\n", "})\n", "\n", "print(\"\\n原始寬表:\")\n", "print(wide)\n", "\n", "# Melt\n", "melted = pd.melt(wide, id_vars=['Product'], var_name='Year', value_name='Sales')\n", "\n", "print(\"\\nMelt 後:\")\n", "print(melted)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 多個 id_vars\""}, "source": "### 範例 2: 多個 id_vars"
  },
  {
   "cell_type": {"code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 多個 id_vars ===\")\n",
    "\n", "wide2 = pd.DataFrame({\n", "    'Region': ['North', 'South', 'East'],\n", "    'Product': ['A', 'B', 'C'],\n", "    'Q1_Sales': [100, 200, 300],\n", "    'Q2_Sales': [150, 250, 350],\n", "    'Q1_Cost': [50, 100, 150],\n", "    'Q2_Cost': [70, 120, 180]\n", "})\n", "\n", "print(\"\\n原始寬表:\")\n", "print(wide2)\n", "\n", "# 多個 id_vars\n", "melted2 = pd.melt(wide2, id_vars=['Region', 'Product'], var_name='Metric', value_name='Amount')\n", "\n", "print(\"\\nMelt 後:\")\n", "print(melted2.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 指定 value_vars\""}, "source": "### 範例 3: 指定 value_vars"
  },
  {
   "cell_type": {"code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 指定 value_vars ===\")\n",
    "\n", "# 只 melt 特定列\n", "melted3 = pd.melt(\n", "    wide2,\n", "    id_vars=['Region', 'Product'],\n", "    value_vars=['Q1_Sales', 'Q2_Sales'],\n", "    var_name='Quarter',\n", "    value_name='Sales'\n", ")\n", "\n", "print(f\"\\nMelt 後的形狀: {melted3.shape}\")\n", "print(melted3)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: 從實際數據進行 Melt\""}, "source": "### 範例 4: 從實際數據進行 Melt"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: 從實際數據進行 Melt ===\")\n",
    "\n", "# 從 Olist 數據創建透視表\n", "pivot_real = pd.pivot_table(\n", "    df,\n", "    values='price',\n", "    index='customer_state',\n", "    columns='order_status',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(\"\\n原始透視表 (前 5 行):\")\n", "print(pivot_real.head())\n", "\n", "# Melt\n", "melted_real = pd.melt(\n", "    pivot_real.reset_index(),\n", "    id_vars='customer_state',\n", "    var_name='order_status',\n", "    value_name='total_amount'\n", ")\n", "\n", "print(\"\\nMelt 後 (前 10 行):\")\n", "print(melted_real.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: Melt 與分組計算結合\""}, "source": "### 範例 5: Melt 與分組計算結合"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: Melt 與分組計算結合 ===\")\n",
    "\n", "# Melt 後進行分組分析\n", "melted_analysis = melted_real.copy()\n", "\n", "# 計算每個州的平均金額\n", "state_avg = melted_analysis.groupby('customer_state')['total_amount'].mean()\n", "\n", "melted_analysis['state_avg'] = melted_analysis['customer_state'].map(state_avg)\n", "melted_analysis['deviation'] = melted_analysis['total_amount'] - melted_analysis['state_avg']\n", "\n", "print(\"\\n添加計算列後:\")\n", "print(melted_analysis.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: Melt 後的透視\""}, "source": "### 範例 6: Melt 後的透視"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: Melt 後再 Pivot ===\")\n",
    "\n", "# 這展示了 Melt 和 Pivot 的相互轉換\n", "\n", "# 步驟 1: 原始透視表\n", "original_pivot = pd.pivot_table(\n", "    df,\n", "    values='price',\n", "    index='customer_state',\n", "    columns=['order_status'],\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "# 步驟 2: Melt\n", "melted_df = pd.melt(\n", "    original_pivot.reset_index(),\n", "    id_vars='customer_state',\n", "    var_name='order_status',\n", "    value_name='amount'\n", ")\n", "\n", "# 步驟 3: 再 Pivot 回去\n", "repivoted = pd.pivot_table(\n", "    melted_df,\n", "    index='customer_state',\n", "    columns='order_status',\n", "    values='amount',\n", "    aggfunc='sum'\n", ")\n", "\n", "print(f\"\\n原始透視表形狀: {original_pivot.shape}\")\n", "print(f\"Melt 後形狀: {melted_df.shape}\")\n", "print(f\"重新 Pivot 後形狀: {repivoted.shape}\")\n", "\n", "print(f\"\\n是否相同: {original_pivot.equals(repivoted)}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: Melt 數據準備\""}, "source": "### 範例 7: Melt 數據準備"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: Melt 用於數據準備 ===\")\n",
    "\n", "# 創建寬格式的客戶評分數據\n", "ratings_wide = pd.DataFrame({\n", "    'customer_id': ['C001', 'C002', 'C003'],\n", "    'Jan_Rating': [5, 4, 3],\n", "    'Feb_Rating': [5, 3, 4],\n", "    'Mar_Rating': [4, 5, 3]\n", "})\n", "\n", "print(\"\\n評分寬表:\")\n", "print(ratings_wide)\n", "\n", "# Melt 為長表\n", "ratings_long = pd.melt(\n", "    ratings_wide,\n", "    id_vars='customer_id',\n", "    var_name='month',\n", "    value_name='rating'\n", ")\n", "\n", "# 數據清理\n", "ratings_long['month'] = ratings_long['month'].str.replace('_Rating', '')\n", "\n", "print(\"\\n評分長表:\")\n", "print(ratings_long)\n", "\n", "# 進一步分析\n", "print(\"\\n按客戶的平均評分:\")\n", "print(ratings_long.groupby('customer_id')['rating'].mean())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: 複雜的 Melt 場景\""}, "source": "### 範例 8: 複雜的 Melt 場景"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: 複雜的 Melt 場景 ===\")\n",
    "\n", "# 創建複雜的寬表 - 多個指標\n", "complex_wide = pd.DataFrame({\n", "    'Store': ['Store1', 'Store2', 'Store3'],\n", "    'Jan_Sales': [1000, 1500, 1200],\n", "    'Jan_Cost': [500, 700, 600],\n", "    'Feb_Sales': [1100, 1400, 1300],\n", "    'Feb_Cost': [550, 680, 650],\n", "    'Mar_Sales': [1200, 1600, 1400],\n", "    'Mar_Cost': [600, 800, 700]\n", "})\n", "\n", "print(\"\\n複雜寬表:\")\n", "print(complex_wide)\n", "\n", "# Melt 所有列\n", "melted_complex = pd.melt(\n", "    complex_wide,\n", "    id_vars=['Store'],\n", "    var_name='Metric_Month',\n", "    value_name='Amount'\n", ")\n", "\n", "# 進一步分解 Metric_Month\n", "melted_complex[['Metric', 'Month']] = melted_complex['Metric_Month'].str.split('_', expand=True)\n", "melted_complex = melted_complex.drop('Metric_Month', axis=1)\n", "\n", "print(\"\\n處理後的長表 (前 10 行):\")\n", "print(melted_complex.head(10))\n", "\n", "# 再 Pivot 為更有用的形式\n", "pivot_final = pd.pivot_table(\n", "    melted_complex,\n", "    index=['Store', 'Month'],\n", "    columns='Metric',\n", "    values='Amount',\n", "    aggfunc='sum'\n", ")\n", "\n", "print(\"\\n最終透視表:\")\n", "print(pivot_final)"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 5: 實戰案例（6 個完整案例）\n\n### 案例 1: 銷售數據重塑與分析\""}, "source": "## Part 5: 實戰案例（6 個完整案例）\n\n### 案例 1: 銷售數據重塑與分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 5: 實戰案例\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n\" + \"=\"*60)\n", "print(\"案例 1: 銷售數據重塑與分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_sales = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "df_sales['order_month'] = pd.to_datetime(df_sales['order_purchase_timestamp']).dt.to_period('M')\n", "\n", "# 創建透視表\n", "sales_pivot = pd.pivot_table(\n", "    df_sales,\n", "    values='price',\n", "    index='customer_state',\n", "    columns='order_month',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(f\"\\n銷售透視表形狀: {sales_pivot.shape}\")\n", "print(\"前 3 個州的月度銷售:\")\n", "print(sales_pivot.head(3))\n", "\n", "# 計算增長率\n", "sales_growth = sales_pivot.pct_change(axis=1) * 100\n", "print(\"\\n月度增長率 (%):\")\n", "print(sales_growth.head(3))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 2: 客戶購買行為矩陣\""}, "source": "### 案例 2: 客戶購買行為矩陣"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 2: 客戶購買行為矩陣\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_behavior = orders.merge(order_items, on='order_id').merge(\n", "    products[['product_id', 'product_category_name']], on='product_id'\n", ")\n", "\n", "# 計算客戶購買最多的類別\n", "category_pivot = pd.pivot_table(\n", "    df_behavior,\n", "    values='price',\n", "    index='customer_id',\n", "    columns='product_category_name',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(f\"\\n客戶-類別購買矩陣形狀: {category_pivot.shape}\")\n", "print(f\"只購買一個類別的客戶: {(category_pivot > 0).sum(axis=1)[category_pivot > 0].eq(1).sum()}\")\n", "print(f\"購買多個類別的客戶: {((category_pivot > 0).sum(axis=1) > 1).sum()}\")\n", "\n", "# 分析客戶多樣性\n", "customer_diversity = (category_pivot > 0).sum(axis=1)\n", "print(f\"\\n客戶購買類別多樣性統計:\")\n", "print(customer_diversity.value_counts().sort_index().head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 3: 時間序列透視與季節性分析\""}, "source": "### 案例 3: 時間序列透視與季節性分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 3: 時間序列透視與季節性分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_timeseries = orders.merge(order_items, on='order_id')\n", "df_timeseries['purchase_date'] = pd.to_datetime(df_timeseries['order_purchase_timestamp'])\n", "df_timeseries['year'] = df_timeseries['purchase_date'].dt.year\n", "df_timeseries['month'] = df_timeseries['purchase_date'].dt.month\n", "df_timeseries['quarter'] = df_timeseries['purchase_date'].dt.quarter\n", "\n", "# 按季度和月份的銷售\n", "quarterly_pivot = pd.pivot_table(\n", "    df_timeseries,\n", "    values='price',\n", "    index='quarter',\n", "    columns='year',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(\"\\n按季度的銷售趨勢:\")\n", "print(quarterly_pivot)\n", "\n", "# 計算季節性指數\n", "quarterly_avg = quarterly_pivot.mean(axis=1)\n", "seasonal_index = quarterly_pivot.div(quarterly_avg, axis=0)\n", "\n", "print(\"\\n季節性指數:\")\n", "print(seasonal_index.round(2))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 4: 多維度樞紐表\""}, "source": "### 案例 4: 多維度樞紐表"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"案例 4: 多維度樞紐表\")\n", "print(\"=\"*60)\n", "\n", "# 準備完整數據\n", "df_multi_dim = orders.merge(order_items, on='order_id').merge(\n", "    products[['product_id', 'product_category_name']], on='product_id'\n", ").merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "df_multi_dim['order_month'] = pd.to_datetime(df_multi_dim['order_purchase_timestamp']).dt.to_period('M')\n", "\n", "# 創建複雜的多維透視表\n", "multi_pivot = pd.pivot_table(\n", "    df_multi_dim,\n", "    values=['price', 'freight_value'],\n", "    index=['customer_state', 'product_category_name'],\n", "    columns='order_month',\n", "    aggfunc={'price': 'sum', 'freight_value': 'mean'},\n", "    fill_value=0\n", ")\n", "\n", "print(f\"\\n多維透視表形狀: {multi_pivot.shape}\")\n", "print(f\"索引級別: {multi_pivot.index.nlevels}\")\n", "print(\"\\n前 5 行:\")\n", "print(multi_pivot.head())"]]
