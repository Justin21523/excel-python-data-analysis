  },
  {
   "cell_type": {"text/plain": "\"### 範例 10: 複雜多維透視表\""}, "source": "### 範例 10: 複雜多維透視表"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 10: 複雜多維透視表 ===\")\n",
    "\n",
    "# 多維度透視表\n",
    "pivot_complex = pd.pivot_table(\n",
    "    df_cat,\n",
    "    values=['price', 'freight_value'],\n",
    "    index=['customer_state', 'order_month'],\n",
