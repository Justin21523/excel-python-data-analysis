   "source": [
    "# 案例 7-8：時間序列聚合\nprint(\"\\n=== 案例 7-8：時間序列聚合 ===\")\n",
    "\ntimeseries_agg = transactions.groupby(transactions['date'].dt.to_period('M')).agg(\n",
    "    日期=('date', 'min'),\n",
    "    銷售額=('sales', 'sum'),\n",
    "    交易數=('sales', 'count'),\n",
    "    客戶數=('customer_id', 'nunique'),\n",
    "    平均訂單=('sales', 'mean')\n",
    ").reset_index(drop=True)\n",
    "\ntimeseries_agg['環比增長%'] = timeseries_agg['銷售額'].pct_change() * 100\ntimeseries_agg['客戶活躍度'] = (timeseries_agg['客戶數'] / transactions['customer_id'].nunique() * 100).round(2)\n",
    "\nprint(\"\\n時間序列聚合分析：\")\nprint(timeseries_agg.round(2))"
