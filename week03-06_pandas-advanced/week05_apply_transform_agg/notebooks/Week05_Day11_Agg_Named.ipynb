    "        result_grouped['銷售額'].min(),\n",
    "        result_grouped['銷售額'].max(),\n",
    "        result_grouped['銷售額'].std()\n",
    "    ],\n",
    "    '交易數': [\n",
    "        result_grouped['交易數'].mean(),\n",
    "        result_grouped['交易數'].min(),\n",
    "        result_grouped['交易數'].max(),\n",
    "        result_grouped['交易數'].std()\n",
    "    ]\n",
    "})\n",
    "\nprint(\"\\n聚合結果的聚合（統計摘要）：\")\nprint(result_summary.round(2))"
