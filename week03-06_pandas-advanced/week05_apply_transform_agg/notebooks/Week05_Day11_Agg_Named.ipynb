 "cells": [
  {
   "cell_type": {"text": "markdown"}, "metadata": {},
   "source": [
    "# Week 5 Day 11: 命名聚合魔法\n",
    "## Named Aggregation 與自定義聚合函數完整指南\n",
    "\n",
    "**學習目標：**\n",
    "- 掌握 10+ 命名聚合應用\n",
    "- 學習 12+ 自定義聚合函數\n",
    "- 理解 10+ 多層次聚合方法\n",
    "- 實戰客戶摘要、產品分析、時間序列聚合\n",
    "\n",
    "**時間估計：** 2.5 小時"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# ========== 環境設定 ==========\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 顯示設定\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.max_rows', 100)\n",
    "pd.set_option('display.width', None)\n",
    "\n",
    "print(\"✅ 環境設定完成\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# ========== 創建銷售交易數據 ==========\n",
    "np.random.seed(42)\n",
    "\n",
    "transactions = pd.DataFrame({\n",
    "    'date': pd.date_range('2023-01-01', periods=100, freq='D'),\n",
    "    'customer_id': np.random.choice(['C001', 'C002', 'C003', 'C004', 'C005'], 100),\n",
    "    'product_id': np.random.choice(['P001', 'P002', 'P003', 'P004'], 100),\n",
    "    'category': np.random.choice(['電子', '服裝', '食品'], 100),\n",
    "    'quantity': np.random.randint(1, 20, 100),\n",
    "    'unit_price': np.random.randint(10, 500, 100),\n",
    "    'sales': np.random.randint(100, 5000, 100),\n",
    "    'cost': np.random.randint(50, 3000, 100)\n",
    "})\n",
    "\nprint(\"=== 原始交易數據 ===\")\nprint(transactions.head(10))\nprint(f\"\\n數據形狀：{transactions.shape}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## Part 1: Named Aggregation 基礎（10 個範例）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 1-3：基本命名聚合\nprint(\"=== 範例 1-3：基本命名聚合 ===\")\n",
    "\n# 範例 1：簡單的命名聚合\nresult1 = transactions.groupby('customer_id').agg(\n    交易次數=('sales', 'count'),\n    總銷售額=('sales', 'sum'),\n    平均銷售額=('sales', 'mean')\n)\n",
    "\nprint(\"\\n方法 1 - Named Aggregation：\")\nprint(result1)\n",
    "\n# 範例 2：多列多函數\nresult2 = transactions.groupby('customer_id').agg(\n    銷售_合計=('sales', 'sum'),\n    銷售_平均=('sales', 'mean'),\n    銷售_最大=('sales', 'max'),\n    銷售_最小=('sales', 'min'),\n    銷量_合計=('quantity', 'sum')\n)\n",
    "\nprint(\"\\n方法 2 - 多列多函數：\")\nprint(result2)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 3：mixed 聚合（針對不同列的不同函數）\nresult3 = transactions.groupby('customer_id').agg(\n    交易次數=pd.NamedAgg(column='sales', aggfunc='count'),\n    總金額=pd.NamedAgg(column='sales', aggfunc='sum'),\n    總數量=pd.NamedAgg(column='quantity', aggfunc='sum'),\n    均價=pd.NamedAgg(column='unit_price', aggfunc='mean')\n)\n",
    "\nprint(\"\\n方法 3 - pd.NamedAgg 顯式語法：\")\nprint(result3)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 4-5：Lambda 聚合\nprint(\"\\n=== 範例 4-5：Lambda 和自定義聚合 ===\")\n",
    "\n# 範例 4：使用 lambda 計算利潤率\nresult4 = transactions.groupby('customer_id').agg(\n    利潤_總額=('sales', lambda x: (transactions.loc[x.index, 'sales'] - transactions.loc[x.index, 'cost']).sum()),\n    利潤率_平均=('sales', lambda x: ((transactions.loc[x.index, 'sales'] - transactions.loc[x.index, 'cost']) / transactions.loc[x.index, 'sales']).mean())\n)\n",
    "\nprint(\"\\n利潤相關聚合：\")\nprint(result4)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 5：複雜的聚合邏輯\nresult5 = transactions.groupby('customer_id').agg(\n    高價商品數=('unit_price', lambda x: (x > 200).sum()),\n",
    "    低價商品數=('unit_price', lambda x: (x <= 100).sum()),\n",
    "    平均客單價=('sales', 'mean'),\n",
    "    最大客單價=('sales', 'max')\n)\n",
    "\nprint(\"\\n複雜聚合結果：\")\nprint(result5)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 6-8：多級聚合\nprint(\"\\n=== 範例 6-8：多級聚合 ===\")\n",
    "\n# 範例 6：按客戶和類別聚合\nresult6 = transactions.groupby(['customer_id', 'category']).agg(\n    交易數=('sales', 'count'),\n    銷售額=('sales', 'sum'),\n    平均價=('unit_price', 'mean')\n).reset_index()\n",
    "\nprint(\"\\n按客戶和類別的多級聚合：\")\nprint(result6.head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 7：分組聚合統計\nresult7 = transactions.groupby('category').agg(\n    交易數=('sales', 'count'),\n    銷售額_合計=('sales', 'sum'),\n    銷售額_均值=('sales', 'mean'),\n    銷售額_中位數=('sales', 'median'),\n    銷售額_標準差=('sales', 'std'),\n    客戶數=('customer_id', 'nunique')\n).round(2)\n",
    "\nprint(\"\\n按類別的分組聚合統計：\")\nprint(result7)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 8：同時聚合多個列\nresult8 = transactions.groupby('customer_id').agg(\n    銷售_數量=('sales', 'count'),\n    銷售_總額=('sales', 'sum'),\n    銷售_平均=('sales', 'mean'),\n    銷售_中位數=('sales', 'median'),\n    銷量_總計=('quantity', 'sum'),\n    銷量_平均=('quantity', 'mean'),\n    成本_總計=('cost', 'sum')\n).round(2)\n",
    "\nprint(\"\\n同時聚合多個列的結果：\")\nprint(result8.head())"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 9-10：條件聚合\nprint(\"\\n=== 範例 9-10：條件聚合 ===\")\n",
    "\n# 範例 9：僅聚合高價商品\ndef high_value_count(x):\n",
    "    return (x > 1000).sum()\n",
    "\nresult9 = transactions.groupby('customer_id').agg(\n",
    "    高價交易數=('sales', high_value_count),\n",
    "    高價交易額=('sales', lambda x: x[x > 1000].sum()),\n",
    "    普通交易數=('sales', lambda x: (x <= 1000).sum())\n",
    ")\n",
    "\nprint(\"\\n按交易額級別的聚合：\")\nprint(result9)\n",
    "\n# 範例 10：最早和最晚交易\nresult10 = transactions.groupby('customer_id').agg(\n",
    "    首次交易=('date', 'min'),\n",
    "    最後交易=('date', 'max'),\n",
    "    交易天數=('date', lambda x: (x.max() - x.min()).days)\n",
    ")\n",
    "\nprint(\"\\n時間相關聚合：\")\nprint(result10)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## Part 2: 自定義聚合函數（12 個範例）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 1-3：基本自定義函數\nprint(\"=== 範例 1-3：基本自定義聚合函數 ===\")\n",
    "\n# 範例 1：加權平均\ndef weighted_average(sales_values):\n",
    "    \"\"\"計算銷售額加權平均\"\"\"\n",
    "    if len(sales_values) == 0:\n",
    "        return 0\n",
    "    weights = sales_values / sales_values.sum()\n",
    "    return (sales_values * weights).sum()\n",
    "\nresult_wa = transactions.groupby('customer_id')['sales'].apply(weighted_average)\nprint(\"\\n加權平均銷售額：\")\nprint(result_wa)\n",
    "\n# 範例 2：變異係數（CV）\ndef coefficient_of_variation(x):\n",
    "    \"\"\"計算變異係數\"\"\"\n",
    "    return x.std() / x.mean() if x.mean() != 0 else 0\n",
    "\nresult_cv = transactions.groupby('customer_id')['sales'].agg([\n    ('平均銷售', 'mean'),\n    ('變異係數', coefficient_of_variation)\n])\n",
    "\nprint(\"\\n變異係數分析：\")\nprint(result_cv.round(4))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 3：中位數絕對偏差 (MAD)\nprint(\"\\n=== 範例 3：中位數絕對偏差 ===\")\n",
    "\ndef median_absolute_deviation(x):\n",
    "    \"\"\"計算中位數絕對偏差\"\"\"\n",
    "    median = x.median()\n",
    "    return (np.abs(x - median)).median()\n",
    "\nresult_mad = transactions.groupby('customer_id')['sales'].agg([\n    ('中位數', 'median'),\n    ('MAD', median_absolute_deviation)\n]).round(2)\n",
    "\nprint(\"\\n中位數絕對偏差：\")\nprint(result_mad)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 4-6：分佈相關的聚合\nprint(\"\\n=== 範例 4-6：分佈分析 ===\")\n",
    "\n# 範例 4：四分位計算\ndef quartile_range(x):\n",
    "    \"\"\"計算 IQR\"\"\"\n",
    "    return x.quantile(0.75) - x.quantile(0.25)\n",
    "\nresult_iqr = transactions.groupby('customer_id')['sales'].agg([\n",
    "    ('Q1', lambda x: x.quantile(0.25)),\n",
    "    ('Q2_中位數', 'median'),\n",
    "    ('Q3', lambda x: x.quantile(0.75)),\n",
    "    ('IQR', quartile_range)\n",
    "]).round(0)\n",
    "\nprint(\"\\n四分位分析：\")\nprint(result_iqr)\n",
    "\n# 範例 5：峰度和偏度\nfrom scipy.stats import skew, kurtosis\n",
    "\nresult_dist = transactions.groupby('customer_id')['sales'].agg([\n",
    "    ('偏度', skew),\n",
    "    ('峰度', kurtosis)\n",
    "]).round(3)\n",
    "\nprint(\"\\n分佈形態（偏度和峰度）：\")\nprint(result_dist)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 6：信息比率\ndef information_ratio(x):\n",
    "    \"\"\"超額收益與波動性的比率\"\"\"\n",
    "    if x.std() == 0:\n",
    "        return 0\n",
    "    return (x.mean() - x.mean().mean()) / x.std()\n",
    "\nresult_ir = transactions.groupby('customer_id')['sales'].agg([\n",
    "    ('平均銷售', 'mean'),\n",
    "    ('標準差', 'std'),\n",
    "    ('夏普比率', lambda x: x.mean() / x.std() if x.std() != 0 else 0)\n",
    "]).round(3)\n",
    "\nprint(\"\\n風險調整後的績效指標：\")\nprint(result_ir)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 7-9：複雜的商業邏輯聚合\nprint(\"\\n=== 範例 7-9：商業邏輯聚合 ===\")\n",
    "\n# 範例 7：利潤率分析\ndef profit_margin_pct(group):\n",
    "    \"\"\"計算平均利潤率百分比\"\"\"\n",
    "    group_data = transactions.loc[group.index]\n",
    "    profit = (group_data['sales'] - group_data['cost']).sum()\n",
    "    revenue = group_data['sales'].sum()\n",
    "    return (profit / revenue * 100) if revenue > 0 else 0\n",
    "\nresult_profit = transactions.groupby('customer_id').apply(\n",
    "    lambda x: pd.Series({\n",
    "        '銷售額': x['sales'].sum(),\n",
    "        '成本': x['cost'].sum(),\n",
    "        '利潤': (x['sales'] - x['cost']).sum(),\n",
    "        '利潤率%': ((x['sales'] - x['cost']).sum() / x['sales'].sum() * 100)\n",
    "    })\n",
    ")\n",
    "\nprint(\"\\n利潤率分析：\")\nprint(result_profit.round(2))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 8：客戶生命週期價值 (LTV)\ndef calculate_ltv(group):\n",
    "    \"\"\"簡化的 LTV 計算\"\"\"\n",
    "    group_data = transactions.loc[group.index]\n",
    "    total_revenue = group_data['sales'].sum()\n",
    "    transactions_count = len(group_data)\n",
    "    avg_transaction = total_revenue / transactions_count if transactions_count > 0 else 0\n",
    "    \n",
    "    # 假設客戶生命週期為 3 年，每年貢獻相同\n",
    "    estimated_ltv = avg_transaction * transactions_count * 3\n",
    "    return estimated_ltv\n",
    "\nresult_ltv = transactions.groupby('customer_id').apply(\n",
    "    lambda x: pd.Series({\n",
    "        '交易次數': len(x),\n",
    "        '累計購買額': x['sales'].sum(),\n",
    "        '平均客單價': x['sales'].mean(),\n",
    "        '估計LTV': calculate_ltv(x.index)\n",
    "    })\n",
    ")\n",
    "\nprint(\"\\n客戶生命週期價值（LTV）分析：\")\nprint(result_ltv.round(2))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 9：購買行為指標\nresult_behavior = transactions.groupby('customer_id').apply(\n",
    "    lambda x: pd.Series({\n",
    "        '購買頻率': len(x),\n",
    "        '購買間隔_平均天數': (x['date'].max() - x['date'].min()).days / len(x) if len(x) > 1 else 0,\n",
    "        '客戶活躍度_天數': (x['date'].max() - x['date'].min()).days,\n",
    "        '最常購買類別': x['category'].mode()[0] if len(x['category'].mode()) > 0 else 'N/A',\n",
    "        '購買品種數': x['product_id'].nunique()\n",
    "    })\n",
    ")\n",
    "\nprint(\"\\n購買行為分析：\")\nprint(result_behavior)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 10-12：時間序列聚合\nprint(\"\\n=== 範例 10-12：時間序列聚合 ===\")\n",
    "\n# 範例 10：按月份聚合\nresult_monthly = transactions.groupby([transactions['date'].dt.to_period('M'), 'customer_id']).agg(\n",
    "    月銷售額=('sales', 'sum'),\n",
    "    月交易數=('sales', 'count'),\n",
    "    月均交易額=('sales', 'mean')\n",
    ").reset_index()\n",
    "\nprint(\"\\n按月份和客戶的聚合（前 10 筆）：\")\nprint(result_monthly.head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 11：增長趨勢\nresult_trend = transactions.groupby([transactions['date'].dt.to_period('M')]).agg(\n",
    "    日期=('date', 'min'),\n",
    "    銷售額=('sales', 'sum'),\n",
    "    交易數=('sales', 'count'),\n",
    "    平均訂單=('sales', 'mean'),\n",
    "    客戶數=('customer_id', 'nunique')\n",
    ").reset_index(drop=True)\n",
    "\nresult_trend['銷售額_環比%'] = result_trend['銷售額'].pct_change() * 100\n",
    "\nprint(\"\\n按月份的增長趨勢：\")\nprint(result_trend.round(2))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 12：時間序列 KPI\nresult_kpi = transactions.groupby('customer_id').apply(\n",
    "    lambda x: pd.Series({\n",
    "        '首購日期': x['date'].min(),\n",
    "        '最後購買': x['date'].max(),\n",
    "        '客戶活躍天數': (x['date'].max() - x['date'].min()).days,\n",
    "        '購買頻率_天': (x['date'].max() - x['date'].min()).days / len(x) if len(x) > 0 else 0,\n",
    "        '累計購買': x['sales'].sum(),\n",
    "        '累計交易': len(x)\n",
    "    })\n",
    ")\n",
    "\nprint(\"\\n時間序列 KPI：\")\nprint(result_kpi.head())"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## Part 3: 多層次聚合（10 個範例）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 1-3：二層聚合\nprint(\"=== 範例 1-3：二層聚合 ===\")\n",
    "\n# 範例 1：客戶-產品級別\nresult_2layer = transactions.groupby(['customer_id', 'product_id']).agg(\n",
    "    購買次數=('sales', 'count'),\n",
    "    總購買額=('sales', 'sum'),\n",
    "    平均單價=('unit_price', 'mean')\n",
    ").reset_index()\n",
    "\nprint(\"\\n客戶-產品二層聚合（前 10 筆）：\")\nprint(result_2layer.head(10))\n",
    "\n# 範例 2：客戶-類別級別\nresult_2layer_2 = transactions.groupby(['customer_id', 'category']).agg(\n",
    "    類別購買額=('sales', 'sum'),\n",
    "    類別交易數=('sales', 'count'),\n",
    "    佔客戶比%=('sales', lambda x: (x.sum() / transactions[transactions['customer_id'] == x.index[0]]['sales'].sum() * 100 if len(x) > 0 else 0))\n",
    ").reset_index()\n",
    "\nprint(\"\\n客戶-類別二層聚合（前 10 筆）：\")\nprint(result_2layer_2.head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 3：時間-類別級別\nresult_2layer_3 = transactions.groupby([transactions['date'].dt.to_period('M'), 'category']).agg(\n",
    "    月度銷售額=('sales', 'sum'),\n",
    "    月度交易數=('sales', 'count')\n",
    ").reset_index()\n",
    "\nprint(\"\\n時間-類別二層聚合：\")\nprint(result_2layer_3)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 4-6：三層聚合\nprint(\"\\n=== 範例 4-6：三層聚合 ===\")\n",
    "\n# 範例 4：客戶-時間-類別\nresult_3layer = transactions.groupby([\n",
    "    'customer_id',\n",
    "    transactions['date'].dt.to_period('M'),\n",
    "    'category'\n",
    "]).agg(\n",
    "    購買額=('sales', 'sum'),\n",
    "    交易數=('sales', 'count')\n",
    ").reset_index()\n",
    "\nprint(\"\\n三層聚合（客戶-時間-類別，前 15 筆）：\")\nprint(result_3layer.head(15))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 5-6：多維度樞紐\nresult_pivot = result_2layer_2.pivot_table(\n",
    "    index='customer_id',\n",
    "    columns='category',\n",
    "    values='類別購買額',\n",
    "    aggfunc='sum',\n",
    "    fill_value=0\n",
    ")\n",
    "\nprint(\"\\n客戶-類別交叉表（樞紐）：\")\nprint(result_pivot)\n",
    "\n# 添加合計列\nresult_pivot['合計'] = result_pivot.sum(axis=1)\nresult_pivot.loc['合計'] = result_pivot.sum()\n",
    "\nprint(\"\\n帶合計的交叉表：\")\nprint(result_pivot)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 7-10：進階多層聚合\nprint(\"\\n=== 範例 7-10：進階分析 ===\")\n",
    "\n# 範例 7：Groupby 多個層級並求和\nresult_multi = transactions.groupby([\n",
    "    'customer_id',\n",
    "    'category',\n",
    "    'product_id'\n",
    ]).size().reset_index(name='購買次數')\n",
    "\nresult_multi_agg = result_multi.groupby(['customer_id', 'category']).agg(\n",
    "    產品數=('product_id', 'count'),\n",
    "    總購買次數=('購買次數', 'sum')\n",
    ").reset_index()\n",
    "\nprint(\"\\n客戶-類別級別的產品多樣性：\")\nprint(result_multi_agg.head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 8：累積聚合\nresult_cumsum = transactions.sort_values('date').groupby('customer_id').agg(\n",
    "    日期=('date', 'max'),\n",
    "    累計銷售額=('sales', 'sum'),\n",
    "    累計交易數=('sales', 'count')\n",
    ").reset_index()\n",
    "\nprint(\"\\n按客戶的累積統計：\")\nprint(result_cumsum)\n",
    "\n# 範例 9：排名聚合\nresult_rank = result_cumsum.copy()\nresult_rank['銷售排名'] = result_rank['累計銷售額'].rank(method='dense', ascending=False)\nresult_rank['交易排名'] = result_rank['累計交易數'].rank(method='dense', ascending=False)\n",
    "\nprint(\"\\n帶排名的客戶聚合：\")\nprint(result_rank)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 10：分組後聚合的聚合\nresult_grouped = transactions.groupby('customer_id').agg(\n",
    "    銷售額=('sales', 'sum'),\n",
    "    交易數=('sales', 'count')\n",
    ")\n",
    "\nresult_summary = pd.DataFrame({\n",
    "    '統計指標': ['平均', '最小', '最大', '標準差'],\n",
