  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 案例 1-2：客戶摘要報告\nprint(\"=== 案例 1-2：客戶摘要報告 ===\")\n",
    "\ncustomer_summary = transactions.groupby('customer_id').agg(\n",
    "    首次購買=('date', 'min'),\n",
    "    最後購買=('date', 'max'),\n",
    "    活躍天數=('date', lambda x: (x.max() - x.min()).days),\n",
    "    購買次數=('sales', 'count'),\n",
    "    累計購買額=('sales', 'sum'),\n",
    "    平均訂單=('sales', 'mean'),\n",
    "    購買商品種類=('product_id', 'nunique'),\n",
    "    購買類別=('category', 'nunique')\n",
    ").reset_index()\n",
    "\nprint(\"\\n客戶摘要報告：\")\nprint(customer_summary)\n",
    "\n# 添加分類\ncustomer_summary['客戶級別'] = pd.cut(\n",
    "    customer_summary['累計購買額'],\n",
    "    bins=[0, 2000, 5000, 10000],\n",
    "    labels=['低價值', '中價值', '高價值']\n",
    ")\n",
    "\nprint(\"\\n客戶價值分類：\")\nprint(customer_summary[['customer_id', '累計購買額', '客戶級別']])"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 案例 3-4：產品分析\nprint(\"\\n=== 案例 3-4：產品分析 ===\")\n",
    "\nproduct_analysis = transactions.groupby('product_id').agg(\n",
    "    銷售額=('sales', 'sum'),\n",
    "    銷售量=('quantity', 'sum'),\n",
    "    銷售次數=('sales', 'count'),\n",
    "    平均售價=('unit_price', 'mean'),\n",
    "    單次平均購買額=('sales', 'mean'),\n",
    "    購買客戶數=('customer_id', 'nunique'),\n",
    "    購買類別=('category', lambda x: x.mode()[0] if len(x.mode()) > 0 else 'N/A')\n",
    ").reset_index()\n",
    "\nproduct_analysis['銷售額佔比%'] = (product_analysis['銷售額'] / product_analysis['銷售額'].sum() * 100).round(2)\nproduct_analysis['銷售排名'] = product_analysis['銷售額'].rank(method='dense', ascending=False).astype(int)\n",
    "\nprint(\"\\n產品銷售分析：\")\nprint(product_analysis)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 案例 5-6：類別分析\nprint(\"\\n=== 案例 5-6：類別分析 ===\")\n",
    "\ncategory_analysis = transactions.groupby('category').agg(\n",
    "    銷售額=('sales', 'sum'),\n",
    "    銷售量=('quantity', 'sum'),\n",
    "    交易數=('sales', 'count'),\n",
    "    人均銷售額=('sales', lambda x: transactions.loc[x.index, 'sales'].sum() / transactions.loc[x.index, 'customer_id'].nunique()),\n",
    "    客戶數=('customer_id', 'nunique'),\n",
    "    產品數=('product_id', 'nunique')\n",
    ").reset_index()\n",
    "\ncategory_analysis['銷售額佔比%'] = (category_analysis['銷售額'] / category_analysis['銷售額'].sum() * 100).round(2)\n",
    "\nprint(\"\\n類別銷售分析：\")\nprint(category_analysis)"
   ]
