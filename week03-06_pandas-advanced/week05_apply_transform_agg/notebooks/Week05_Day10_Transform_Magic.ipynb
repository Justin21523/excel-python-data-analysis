{
 "cells": [
  {
   "cell_type": {"text": "markdown"}, "metadata": {},
   "source": [
    "# Week 5 Day 10: Transform 魔法\n",
    "## 高級數據轉換與組內標準化完整指南\n",
    "\n",
    "**學習目標：**\n",
    "- 掌握 transform 10+ 應用場景\n",
    "- 學習 12+ 組內標準化方法\n",
    "- 理解 10+ 組內百分比計算\n",
    "- 實戰異常檢測、帕累托分析、動態定價\n",
    "\n",
    "**時間估計：** 2.5 小時"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# ========== 環境設定 ==========\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 顯示設定\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.max_rows', 100)\n",
    "pd.set_option('display.width', None)\n",
    "\n",
    "from scipy import stats\n",
    "\n",
    "print(\"✅ 環境設定完成\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# ========== 創建銷售數據 ==========\n",
    "np.random.seed(42)\n",
    "\n",
    "sales = pd.DataFrame({\n",
    "    'date': pd.date_range('2023-01-01', periods=100, freq='D'),\n",
    "    'region': np.random.choice(['華東', '華南', '華北'], 100),\n",
    "    'product': np.random.choice(['A', 'B', 'C', 'D'], 100),\n",
    "    'sales': np.random.randint(100, 1000, 100),\n",
    "    'quantity': np.random.randint(5, 50, 100)\n",
    "})\n",
    "\nprint(\"=== 原始銷售數據 ===\")\nprint(sales.head(10))\nprint(f\"\\n數據形狀：{sales.shape}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## Part 1: Transform 基礎（10 個範例）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 1-2：基礎 transform\nprint(\"=== 範例 1-2：Transform 基本用法 ===\")\n",
    "\n# 範例 1：組內減去組平均值\nsales['sales_minus_group_mean'] = sales.groupby('region')['sales'].transform(lambda x: x - x.mean())\n",
    "\n# 範例 2：組內除以組最大值\nsales['sales_pct_of_max'] = sales.groupby('region')['sales'].transform(lambda x: x / x.max())\n",
    "\nprint(\"\\nTransform 結果（華東地區示例）：\")\nprint(sales[sales['region'] == '華東'][['region', 'sales', 'sales_minus_group_mean', 'sales_pct_of_max']].head())"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 3-4：多個 transform 聚合\nprint(\"\\n=== 範例 3-4：複雜 Transform ===\")\n",
    "\n# 範例 3：計算組內排名\nsales['region_sales_rank'] = sales.groupby('region')['sales'].transform('rank', method='dense')\n",
    "\n# 範例 4：計算組內百分位\nsales['sales_percentile'] = sales.groupby('region')['sales'].transform(lambda x: x.rank(pct=True) * 100)\n",
    "\nprint(\"\\nTransform 排名與百分位：\")\nprint(sales[['region', 'sales', 'region_sales_rank', 'sales_percentile']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 5-7：統計轉換\nprint(\"\\n=== 範例 5-7：統計特徵 Transform ===\")\n",
    "\n# 範例 5：組內標準差\nsales['region_sales_std'] = sales.groupby('region')['sales'].transform('std')\n",
    "\n# 範例 6：組內 CV（變異係數）\nsales['region_sales_cv'] = sales.groupby('region')['sales'].transform(lambda x: x.std() / x.mean())\n",
    "\n# 範例 7：組內中位數絕對偏差\ndef mad(x):\n",
    "    return np.abs(x - np.median(x)).median()\n",
    "\nsales['sales_mad'] = sales.groupby('region')['sales'].transform(mad)\n",
    "\nprint(\"\\n統計轉換結果：\")\nprint(sales[['region', 'sales', 'region_sales_std', 'region_sales_cv', 'sales_mad']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 8-10：累積統計\nprint(\"\\n=== 範例 8-10：累積與 Shift 轉換 ===\")\n",
    "\n# 範例 8：組內累積和\nsales['cumsum_by_region'] = sales.groupby('region')['sales'].transform('cumsum')\n",
    "\n# 範例 9：組內累積乘積\nsales['cumprod_by_region'] = sales.groupby('region')['quantity'].transform('cumprod')\n",
    "\n# 範例 10：組內前值\nsales['prev_sales'] = sales.groupby('region')['sales'].transform(lambda x: x.shift(1))\n",
    "\nprint(\"\\n累積與 Shift 轉換：\")\nprint(sales[sales['region'] == '華東'][['region', 'sales', 'cumsum_by_region', 'prev_sales']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## Part 2: 組內標準化（12 個範例）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 1-3：Z-score 標準化\nprint(\"=== 範例 1-3：Z-score 標準化 ===\")\n",
    "\n# 範例 1：全局 Z-score\nsales['sales_zscore_global'] = stats.zscore(sales['sales'])\n",
    "\n# 範例 2：組內 Z-score\nsales['sales_zscore_group'] = sales.groupby('region')['sales'].transform(lambda x: (x - x.mean()) / x.std())\n",
    "\n# 範例 3：識別異常值（|z| > 2）\nsales['is_outlier_zscore'] = np.abs(sales['sales_zscore_group']) > 2\n",
    "\nprint(\"\\nZ-score 標準化：\")\nprint(sales[['region', 'sales', 'sales_zscore_global', 'sales_zscore_group', 'is_outlier_zscore']].head(10))\nprint(f\"\\n異常值檢測：{sales['is_outlier_zscore'].sum()} 個\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 4-6：Min-Max 歸一化\nprint(\"\\n=== 範例 4-6：Min-Max 歸一化 ===\")\n",
    "\n# 範例 4：全局 Min-Max\nsales['sales_minmax_global'] = (sales['sales'] - sales['sales'].min()) / (sales['sales'].max() - sales['sales'].min())\n",
    "\n# 範例 5：組內 Min-Max\nsales['sales_minmax_group'] = sales.groupby('region')['sales'].transform(\n    lambda x: (x - x.min()) / (x.max() - x.min())\n)\n",
    "\n# 範例 6：縮放到 [0, 100]\nsales['sales_scaled_100'] = sales['sales_minmax_group'] * 100\n",
    "\nprint(\"\\nMin-Max 歸一化：\")\nprint(sales[['region', 'sales', 'sales_minmax_global', 'sales_minmax_group', 'sales_scaled_100']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 7-9：排名與百分位\nprint(\"\\n=== 範例 7-9：排名與百分位 ===\")\n",
    "\n# 範例 7：全局排名\nsales['sales_rank_global'] = sales['sales'].rank(method='average')\n",
    "\n# 範例 8：組內排名\nsales['sales_rank_group'] = sales.groupby('region')['sales'].transform('rank')\n",
    "\n# 範例 9：組內分位排名\nsales['sales_quantile_group'] = sales.groupby('region')['sales'].transform(\n    lambda x: pd.qcut(x, q=4, labels=False, duplicates='drop') + 1  # 分為 1-4 四分位\n)\n",
    "\nprint(\"\\n排名與百分位：\")\nprint(sales[['region', 'sales', 'sales_rank_global', 'sales_rank_group', 'sales_quantile_group']].head(15))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 10-12：實用轉換\nprint(\"\\n=== 範例 10-12：實用轉換 ===\")\n",
    "\n# 範例 10：Log 轉換\nsales['sales_log'] = np.log1p(sales['sales'])  # log(1+x) 以避免 log(0)\n",
    "\n# 範例 11：組內 Log 轉換\nsales['sales_log_group'] = sales.groupby('region')['sales'].transform(lambda x: np.log1p(x))\n",
    "\n# 範例 12：平方根轉換\nsales['sales_sqrt'] = np.sqrt(sales['sales'])\n",
    "\nprint(\"\\n常見分佈轉換：\")\nprint(sales[['region', 'sales', 'sales_log', 'sales_sqrt']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## Part 3: 組內百分比（10 個範例）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 1-3：佔比計算\nprint(\"=== 範例 1-3：銷售額佔比 ===\")\n",
    "\n# 範例 1：對總銷售額的佔比\nsales['pct_of_total'] = sales['sales'] / sales['sales'].sum() * 100\n",
    "\n# 範例 2：對地區銷售額的佔比\nsales['pct_of_region'] = sales.groupby('region')['sales'].transform(lambda x: x / x.sum() * 100)\n",
    "\n# 範例 3：對產品銷售額的佔比\nsales['pct_of_product'] = sales.groupby('product')['sales'].transform(lambda x: x / x.sum() * 100)\n",
    "\nprint(\"\\n銷售額佔比：\")\nprint(sales[['region', 'product', 'sales', 'pct_of_total', 'pct_of_region', 'pct_of_product']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 4-6：累計百分比\nprint(\"\\n=== 範例 4-6：累計百分比 ===\")\n",
    "\n# 按銷售額排序\nsales_sorted = sales.sort_values('sales', ascending=False).reset_index(drop=True)\n",
    "\n# 範例 4：累計銷售額\nsales_sorted['cumsum_sales'] = sales_sorted['sales'].cumsum()\n",
    "\n# 範例 5：累計百分比\nsales_sorted['cumulative_pct'] = sales_sorted['cumsum_sales'] / sales_sorted['sales'].sum() * 100\n",
    "\n# 範例 6：ABC 分類（帕累托分析）\ndef classify_pareto(x):\n",
    "    if x <= 80:\n",
    "        return 'A類'\n",
    "    elif x <= 95:\n",
    "        return 'B類'\n",
    "    else:\n",
    "        return 'C類'\n",
    "\nsales_sorted['pareto_class'] = sales_sorted['cumulative_pct'].apply(classify_pareto)\n",
    "\nprint(\"\\n帕累托分析（前 20 項）：\")\nprint(sales_sorted[['sales', 'cumsum_sales', 'cumulative_pct', 'pareto_class']].head(20))\n",
    "\nprint(\"\\n帕累托分類統計：\")\nprint(sales_sorted['pareto_class'].value_counts())"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 7-8：百分位數\nprint(\"\\n=== 範例 7-8：百分位數分析 ===\")\n",
    "\n# 範例 7：全局百分位\nsales['sales_percentile_global'] = sales['sales'].rank(pct=True) * 100\n",
    "\n# 範例 8：組內百分位\nsales['sales_percentile_group'] = sales.groupby('region')['sales'].transform(lambda x: x.rank(pct=True) * 100)\n",
    "\nprint(\"\\n百分位數分析：\")\nprint(sales[['region', 'sales', 'sales_percentile_global', 'sales_percentile_group']].head(10))\n",
    "\nprint(\"\\n百分位數分布：\")\nfor pct in [25, 50, 75, 90, 95]:\n",
    "    value = sales['sales'].quantile(pct/100)\n",
    "    print(f\"  {pct}th percentile: {value:.0f}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 範例 9-10：相對於基準的百分比\nprint(\"\\n=== 範例 9-10：相對於基準的百分比 ===\")\n",
    "\n# 範例 9：相對於區域平均\nregion_mean = sales.groupby('region')['sales'].transform('mean')\nsales['pct_vs_region_avg'] = (sales['sales'] / region_mean - 1) * 100\n",
    "\n# 範例 10：相對於整體平均\nglobal_mean = sales['sales'].mean()\nsales['pct_vs_global_avg'] = (sales['sales'] / global_mean - 1) * 100\n",
    "\nprint(\"\\n相對於基準的百分比變化：\")\nprint(sales[['region', 'sales', 'pct_vs_region_avg', 'pct_vs_global_avg']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## Part 4: 實戰案例（6 個）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 案例 1：異常值檢測\nprint(\"=== 案例 1：異常值檢測系統 ===\")\n",
    "\n# 多維度異常檢測\nsales['zscore_outlier'] = np.abs(sales['sales_zscore_group']) > 2  # Z-score\nsales['iqr_outlier'] = False\n\nfor region in sales['region'].unique():\n",
    "    mask = sales['region'] == region\n",
    "    q1 = sales.loc[mask, 'sales'].quantile(0.25)\n",
    "    q3 = sales.loc[mask, 'sales'].quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    sales.loc[mask, 'iqr_outlier'] = (sales.loc[mask, 'sales'] < q1 - 1.5*iqr) | (sales.loc[mask, 'sales'] > q3 + 1.5*iqr)\n",
    "\nsales['is_outlier'] = sales['zscore_outlier'] | sales['iqr_outlier']\n",
    "\nprint(f\"\\n異常值檢測結果：\")\nprint(f\"Z-score 異常：{sales['zscore_outlier'].sum()}\")\nprint(f\"IQR 異常：{sales['iqr_outlier'].sum()}\")\nprint(f\"綜合異常：{sales['is_outlier'].sum()}\")\n",
    "\noutliers = sales[sales['is_outlier']]\nif len(outliers) > 0:\n",
    "    print(f\"\\n異常值詳情：\")\n",
    "    print(outliers[['region', 'product', 'sales', 'sales_zscore_group']].head())"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 案例 2：帕累托分析\nprint(\"\\n=== 案例 2：帕累托分析 ===\")\n",
    "\n# 按地區進行帕累托分析\nfor region in sales['region'].unique():\n",
    "    region_data = sales[sales['region'] == region].sort_values('sales', ascending=False).reset_index(drop=True)\n",
    "    region_data['cumsum'] = region_data['sales'].cumsum()\n",
    "    region_data['cum_pct'] = (region_data['cumsum'] / region_data['sales'].sum() * 100).round(2)\n",
    "    \n",
    "    print(f\"\\n{region} 地區帕累托分析：\")\n",
    "    print(f\"前 20% 的客戶（銷售額排名）：\")\n",
    "    \n",
    "    top_20_pct = int(len(region_data) * 0.2)\n",
    "    top_20_data = region_data.head(top_20_pct)\n",
    "    print(f\"  數量：{len(top_20_data)} 項\")\n",
    "    print(f\"  銷售額：${top_20_data['sales'].sum():,.0f}\")\n",
    "    print(f\"  佔比：{top_20_data['sales'].sum() / region_data['sales'].sum() * 100:.1f}%\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 案例 3：動態定價系統\nprint(\"\\n=== 案例 3：動態定價系統 ===\")\n",
    "\n# 基於銷售額百分位的定價策略\nsales['unit_price'] = sales['sales'] / sales['quantity']\n",
    "\n# 計算產品的銷售額排名\nsales['product_sales_rank'] = sales.groupby('product')['sales'].transform(lambda x: x.rank(pct=True))\n",
    "\n# 根據銷售績效調整價格\ndef dynamic_price_adjustment(percentile):\n",
    "    \"\"\"根據銷售額百分位調整價格\"\"\"\n",
    "    if percentile >= 0.75:\n",
    "        return 1.15  # 增加 15%\n",
    "    elif percentile >= 0.50:\n",
    "        return 1.08  # 增加 8%\n",
    "    elif percentile >= 0.25:\n",
    "        return 1.00  # 保持不變\n",
    "    else:\n",
    "        return 0.92  # 降低 8%\n",
    "\nsales['price_multiplier'] = sales['product_sales_rank'].apply(dynamic_price_adjustment)\nsales['adjusted_price'] = sales['unit_price'] * sales['price_multiplier']\nsales['price_change_pct'] = (sales['price_multiplier'] - 1) * 100\n",
    "\nprint(\"\\n動態定價結果（產品 A）：\")\nproduct_a = sales[sales['product'] == 'A'].sort_values('sales', ascending=False).head(10)\nprint(product_a[['sales', 'unit_price', 'price_multiplier', 'adjusted_price', 'price_change_pct']])\n",
    "\nprint(f\"\\n定價策略統計：\")\nprint(f\"漲價 15%：{(sales['price_multiplier'] == 1.15).sum()} 項\")\nprint(f\"漲價 8%：{(sales['price_multiplier'] == 1.08).sum()} 項\")\nprint(f\"保持不變：{(sales['price_multiplier'] == 1.00).sum()} 項\")\nprint(f\"降價 8%：{(sales['price_multiplier'] == 0.92).sum()} 項\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 最終總結\nprint(\"\\n\" + \"=\"*60)\nprint(\"本堂課重點總結\")\nprint(\"=\"*60)\nprint(\"\"\"\n### 核心概念\n1. **Transform**: 返回與原數據形狀相同的結果\n   - 適合做轉換而不改變行數\n   - 可與 groupby 組合進行組內轉換\n\n2. **組內標準化**: 使數據在每個組內可比\n   - Z-score: 衡量距離均值多少個標準差\n   - Min-Max: 將數據壓縮到 [0,1]\n   - Log 轉換: 處理偏態分佈\n\n3. **組內百分比**: 理解相對重要性\n   - 佔比: 部分與整體的關係\n   - 百分位: 排名相對位置\n   - 帕累托: 80/20 法則應用\n\n### 實戰應用\n- 異常值檢測: 多維度交叉驗證\n- 帕累托分析: 識別關鍵 20% 的客戶\n- 動態定價: 根據銷售績效調整定價\n- 風險評估: 標準化後的對比分析\n\n### 最佳實踐\n- 選擇合適的標準化方法\n- 結合業務邏輯進行轉換\n- 驗證轉換結果的合理性\n- 保存中間結果便於調試\n\n### 下堂課預告\n**Day 11: Named Aggregation** - 多重聚合與自定義函數\n\"\"\")"
   ]
  }
 ],
