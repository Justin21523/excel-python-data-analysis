   "source": [
    "### 1.5 應用傳遞參數和返回多個值"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 範例 9：傳遞額外參數\n",
    "print(\"=== 範例 9：動態打折 ===\")\n",
    "prices = pd.Series([100, 200, 300, 400], name='價格')\n",
    "\n",
    "# 方法 1：使用 args\n",
    "def apply_discount(price, discount_rate):\n",
    "    \"\"\"應用折扣\"\"\"\n",
    "    return price * (1 - discount_rate)\n",
    "\n",
    "discounted = prices.apply(apply_discount, args=(0.15,))\n",
    "print(f\"原價：{prices.values}\")\n",
    "print(f\"打75折後：{discounted.values}\")\n",
    "\n",
    "# 方法 2：使用 kwargs\n",
    "print(\"\\n=== 範例 10：多個參數 ===\")\n",
    "def calculate_final_price(price, tax_rate=0.1, discount_rate=0.0):\n",
    "    \"\"\"計算最終價格：加稅 + 折扣\"\"\"\n",
    "    discounted = price * (1 - discount_rate)\n",
    "    return discounted * (1 + tax_rate)\n",
    "\n",
    "final = prices.apply(calculate_final_price, tax_rate=0.1, discount_rate=0.1)\n",
    "print(f\"最終價格（含10%稅、10%折扣）：{final.values}\")\n",
    "\n",
    "# 範例 11：返回多個值（expand=True）\n",
    "print(\"\\n=== 範例 11：返回多個值 ===\")\n",
    "def extract_info(text):\n",
    "    \"\"\"從文字提取多個信息\"\"\"\n",
    "    # 返回長度、字數、是否包含數字\n",
    "    return pd.Series({\n",
    "        '長度': len(text),\n",
    "        '字數': len(text.split()),\n",
    "        '含數字': any(c.isdigit() for c in text)\n",
    "    })\n",
    "\n",
    "texts = pd.Series(['iPhone 13 Pro', 'Samsung Galaxy S21', 'Google Pixel'])\n",
    "result = texts.apply(extract_info)\n",
    "print(result)"
   ]
  },
