  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.1 基礎應用：簡單函數"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 創建範例數據\n",
    "prices = pd.Series([100, 250, 50, 300, 75], name='價格')\n",
    "\n",
    "# 範例 1：簡單轉換\n",
    "print(\"=== 範例 1：價格打八折 ===\")\n",
    "discounted = prices.apply(lambda x: x * 0.8)\n",
    "print(f\"原價：{prices.values}\")\n",
    "print(f\"打折後：{discounted.values}\")\n",
    "\n",
    "# 範例 2：條件邏輯\n",
    "print(\"\\n=== 範例 2：會員等級分類 ===\")\n",
    "customer_spending = pd.Series([100, 5000, 500, 10000, 200], name='消費額')\n",
    "\n",
    "def get_member_level(spending):\n",
    "    \"\"\"根據消費額分類會員等級\"\"\"\n",
    "    if spending >= 10000:\n",
    "        return 'VIP白金'\n",
    "    elif spending >= 5000:\n",
    "        return 'VIP黃金'\n",
    "    elif spending >= 1000:\n",
    "        return 'VIP銀牌'\n",
    "    else:\n",
    "        return '普通會員'\n",
    "\n",
    "levels = customer_spending.apply(get_member_level)\n",
    "print(levels)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.2 文字處理應用"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 範例 3：文字清洗\n",
    "print(\"=== 範例 3：文字清洗 ===\")\n",
    "raw_text = pd.Series([\n",
    "    '  iPhone 13 Pro Max  ',\n",
    "    'SAMSUNG GALAXY S21 Ultra',\n",
    "    'google pixel 6 pro',\n",
    "    '  OnePlus 9 Pro  '\n",
    "], name='商品名稱')\n",
    "\n",
    "def clean_text(text):\n",
    "    \"\"\"清洗文字：去除空格、統一大小寫\"\"\"\n",
    "    return text.strip().title()\n",
    "\n",
    "cleaned = raw_text.apply(clean_text)\n",
    "print(\"原始文字：\")\n",
    "print(raw_text)\n",
    "print(\"\\n清洗後：\")\n",
    "print(cleaned)\n",
    "\n",
    "# 範例 4：提取品牌名\n",
    "print(\"\\n=== 範例 4：提取品牌名 ===\")\n",
    "def extract_brand(product_name):\n",
    "    \"\"\"提取商品的品牌名稱\"\"\"\n",
    "    brands = ['iphone', 'samsung', 'google', 'oneplus']\n",
    "    name_lower = product_name.lower()\n",
    "    for brand in brands:\n",
    "        if brand in name_lower:\n",
    "            return brand.upper()\n",
    "    return '其他'\n",
    "\n",
    "brands = raw_text.apply(extract_brand)\n",
    "print(brands)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.3 複雜邏輯應用"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 範例 5：日期時間處理\n",
    "print(\"=== 範例 5：日期格式化 ===\")\n",
    "dates = pd.Series([\n",
    "    pd.Timestamp('2024-01-15'),\n",
    "    pd.Timestamp('2024-02-20'),\n",
    "    pd.Timestamp('2024-03-10'),\n",
    "    pd.Timestamp('2024-12-25')\n",
    "], name='訂單日期')\n",
    "\n",
    "def format_date(date):\n",
    "    \"\"\"將日期轉換為友好格式\"\"\"\n",
    "    return date.strftime('%Y年%m月%d日')\n",
    "\n",
    "formatted_dates = dates.apply(format_date)\n",
    "print(formatted_dates)\n",
    "\n",
    "# 範例 6：計算天數差異\n",
    "print(\"\\n=== 範例 6：計算與今天的天數差 ===\")\n",
    "def days_ago(date):\n",
    "    \"\"\"計算距今多少天\"\"\"\n",
    "    today = pd.Timestamp('2024-12-31')\n",
    "    diff = (today - date).days\n",
    "    if diff == 0:\n",
    "        return '今天'\n",
    "    elif diff == 1:\n",
    "        return '昨天'\n",
    "    else:\n",
    "        return f'{diff}天前'\n",
    "\n",
    "days_diff = dates.apply(days_ago)\n",
    "print(days_diff)"
   ]
  },
