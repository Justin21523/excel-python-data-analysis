  {
   "cell_type": {"cell_type": "code", "metadata": {}},
   "source": [
    "# 範例 3：按行計算（axis=1，對每一列）\n",
    "print(\"\\n=== 範例 3：計算總銷售額 ===\")\n",
    "sales_data['總銷售'] = sales_data[['1月', '2月', '3月']].apply(sum, axis=1)\n",
