    "print(\"\\n=== 實戰案例 6：數據驗證系統 ===\")\n",
    "\n",
    "data_to_validate = pd.DataFrame({\n",
    "    '客戶ID': ['C001', 'C002', None, 'C004', 'C005'],\n",
    "    '郵箱': ['test@gmail.com', 'invalid.email', 'alice@example.com', 'bob@example.com', ''],\n",
    "    '年齡': [25, 150, 35, 28, -5],\n",
    "    '城市': ['台北', '台北', '新竹', None, '台中']\n",
    "})\n",
    "\n",
    "def validate_row(row):\n",
    "    \"\"\"驗證整行數據\"\"\"\n",
    "    errors = []\n",
    "    \n",
    "    # 檢查客戶ID\n",
    "    if pd.isna(row['客戶ID']):\n",
    "        errors.append('缺失客戶ID')\n",
    "    \n",
    "    # 檢查郵箱\n",
    "    if not re.match(r'^[^@]+@[^@]+\\.[^@]+$', str(row['郵箱'])):\n",
    "        errors.append('郵箱格式錯誤')\n",
    "    \n",
    "    # 檢查年齡\n",
    "    if pd.notna(row['年齡']):\n",
    "        if row['年齡'] < 0 or row['年齡'] > 120:\n",
    "            errors.append('年齡超出範圍')\n",
    "    \n",
    "    # 檢查城市\n",
    "    if pd.isna(row['城市']):\n",
    "        errors.append('缺失城市')\n",
    "    \n",
    "    return pd.Series({\n",
    "        '驗證狀態': '✓ 合格' if not errors else '✗ 錯誤',\n",
    "        '錯誤信息': '; '.join(errors) if errors else ''\n",
    "    })\n",
    "\n",
    "validation = data_to_validate.apply(validate_row, axis=1)\n",
    "data_to_validate = pd.concat([data_to_validate, validation], axis=1)\n",
    "print(data_to_validate)"
   ]
