    "print(\"\\n=== 實戰案例 7：時間序列特徵提取 ===\")\n",
    "\n",
    "ts_data = pd.DataFrame({\n",
    "    '日期': pd.date_range('2024-01-01', periods=10, freq='D'),\n",
    "    '銷售額': np.random.randint(1000, 5000, 10)\n",
    "})\n",
    "\n",
    "def extract_time_features(date):\n",
    "    \"\"\"提取時間特徵\"\"\"\n",
    "    return pd.Series({\n",
    "        '年': date.year,\n",
    "        '月': date.month,\n",
    "        '日': date.day,\n",
    "        '星期': date.day_name(),\n",
    "        '季度': f'Q{(date.month-1)//3 + 1}',\n",
    "        '月初/月末': '月初' if date.day <= 10 else ('月中' if date.day <= 20 else '月末')\n",
    "    })\n",
    "\n",
    "features = ts_data['日期'].apply(extract_time_features)\n",
    "ts_data = pd.concat([ts_data, features], axis=1)\n",
    "print(ts_data[['日期', '銷售額', '年', '月', '星期', '季度', '月初/月末']])"
   ]
