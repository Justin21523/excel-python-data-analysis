    "### 2.4 複雜計算應用"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 範例 6：計算配置和折扣\n",
    "print(\"\\n=== 範例 6：智能折扣系統 ===\")\n",
    "orders = pd.DataFrame({\n",
    "    '訂單ID': ['O001', 'O002', 'O003', 'O004', 'O005'],\n",
    "    '商品數量': [1, 5, 10, 3, 15],\n",
    "    '單價': [100, 50, 30, 200, 20],\n",
    "    '會員等級': ['普通', 'VIP', '普通', 'VIP', 'VIP']\n",
    "})\n",
    "\n",
    "def apply_smart_discount(row):\n",
    "    \"\"\"應用智能折扣\n",
    "    - 數量 >= 10 時：折扣10%\n",
