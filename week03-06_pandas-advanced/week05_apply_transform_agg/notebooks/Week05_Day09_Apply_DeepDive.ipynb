    "print(\"\\n=== 實戰案例 4：庫存警報系統 ===\")\n",
    "\n",
    "inventory = pd.DataFrame({\n",
    "    '商品ID': ['P001', 'P002', 'P003', 'P004', 'P005'],\n",
    "    '商品名稱': ['手機', '平板', '耳機', '行動電源', '保護殼'],\n",
    "    '當前庫存': [5, 50, 200, 10, 500],\n",
    "    '每月銷量': [10, 20, 100, 15, 300],\n",
    "    '供應商交期': [7, 14, 3, 7, 1]  # 天數\n",
    "})\n",
    "\n",
    "def check_inventory_status(row):\n",
    "    \"\"\"檢查庫存狀態\"\"\"\n",
    "    current = row['當前庫存']\n",
    "    monthly_sales = row['每月銷量']\n",
    "    daily_sales = monthly_sales / 30\n",
    "    lead_time = row['供應商交期']\n",
    "    \n",
    "    # 計算需求\n",
    "    needed = daily_sales * lead_time\n",
    "    \n",
    "    # 判斷狀態\n",
    "    if current < needed:\n",
    "        return '緊急補貨'\n",
    "    elif current < needed * 2:\n",
    "        return '需要補貨'\n",
    "    elif current > monthly_sales * 3:\n",
    "        return '庫存過多'\n",
    "    else:\n",
    "        return '庫存正常'\n",
    "\n",
    "inventory['庫存狀態'] = inventory.apply(check_inventory_status, axis=1)\n",
    "print(inventory[['商品名稱', '當前庫存', '每月銷量', '庫存狀態']])"
   ]
