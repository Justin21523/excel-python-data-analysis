    "### 1.4 統計和計算應用"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 範例 7：數值映射\n",
    "print(\"=== 範例 7：評分映射 ===\")\n",
    "ratings = pd.Series([1, 5, 3, 2, 4, 5], name='評分')\n",
    "\n",
    "rating_text = {\n",
    "    1: '非常不滿意',\n",
    "    2: '不滿意',\n",
    "    3: '一般',\n",
    "    4: '滿意',\n",
    "    5: '非常滿意'\n",
    "}\n",
    "\n",
    "result = ratings.apply(lambda x: rating_text.get(x, '未知'))\n",
    "print(result)\n",
    "\n",
    "# 範例 8：複雜計算\n",
    "print(\"\\n=== 範例 8：複利計算 ===\")\n",
    "investments = pd.Series([10000, 50000, 100000], name='初始投資')\n",
    "\n",
    "def compound_interest(principal, rate=0.08, years=5):\n",
    "    \"\"\"計算複利：A = P(1+r)^n\"\"\"\n",
    "    return principal * ((1 + rate) ** years)\n",
    "\n",
    "future_value = investments.apply(compound_interest)\n",
    "print(\"初始投資：\", investments.values)\n",
    "print(\"5年後價值（年利率8%）：\", future_value.values)\n",
    "print(\"利息收入：\", (future_value - investments).values)"
   ]
  },
