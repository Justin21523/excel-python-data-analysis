   "source": [
    "print(\"\\n=== 實戰案例 3：訂單費用計算系統 ===\")\n",
    "\n",
    "orders = pd.DataFrame({\n",
    "    '訂單ID': ['O001', 'O002', 'O003', 'O004', 'O005'],\n",
    "    '商品總額': [500, 1500, 3000, 200, 2500],\n",
    "    '會員等級': ['普通', 'VIP', 'VIP', '普通', 'VIP'],\n",
    "    '配送地區': ['市區', '郊區', '市區', '偏遠', '市區'],\n",
    "    '商品數量': [2, 5, 10, 1, 8]\n",
    "})\n",
    "\n",
    "def calculate_order_fee(row):\n",
    "    \"\"\"計算訂單最終費用\"\"\"\n",
    "    subtotal = row['商品總額']\n",
    "    \n",
    "    # 1. 計算折扣\n",
    "    discount = 0\n",
    "    if row['會員等級'] == 'VIP':\n",
    "        discount += 0.1  # VIP 10% 折扣\n",
    "    \n",
    "    if subtotal >= 2000:\n",
    "        discount += 0.05  # 2000+ 額外 5% 折扣\n",
    "    elif subtotal >= 1000:\n",
    "        discount += 0.03  # 1000+ 額外 3% 折扣\n",
    "    \n",
    "    # 2. 計算運費\n",
    "    if subtotal >= 2000:\n",
    "        shipping = 0  # 免運\n",
    "    else:\n",
    "        shipping = {'市區': 50, '郊區': 80, '偏遠': 150}\n",
    "        shipping = shipping.get(row['配送地區'], 50)\n",
    "    \n",
    "    # 3. 計算稅費\n",
    "    after_discount = subtotal * (1 - discount)\n",
    "    tax = after_discount * 0.05  # 5% 稅費\n",
    "    \n",
    "    # 4. 最終價格\n",
    "    final_price = after_discount + shipping + tax\n",
    "    \n",
    "    return pd.Series({\n",
    "        '折扣率': f'{discount*100:.0f}%',\n",
    "        '折扣金額': subtotal * discount,\n",
    "        '運費': shipping,\n",
    "        '稅費': tax,\n",
    "        '最終價格': final_price\n",
    "    })\n",
    "\n",
    "result = orders.apply(calculate_order_fee, axis=1)\n",
    "orders = pd.concat([orders, result], axis=1)\n",
    "print(orders[['訂單ID', '商品總額', '折扣率', '運費', '稅費', '最終價格']])"
   ]
  },
