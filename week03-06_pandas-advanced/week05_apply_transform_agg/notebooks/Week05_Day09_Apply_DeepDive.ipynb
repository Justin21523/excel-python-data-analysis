    "print(\"\\n=== 實戰案例 8：複雜數據轉換 ===\")\n",
    "\n",
    "orders = pd.DataFrame({\n",
    "    '訂單ID': ['O001', 'O002', 'O003'],\n",
    "    '客戶名': ['Alice Smith', 'Bob Johnson', 'Charlie Brown'],\n",
    "    '商品': ['手機', '平板', '耳機'],\n",
    "    '價格': [999, 599, 199],\n",
    "    '數量': [1, 2, 3]\n",
    "})\n",
    "\n",
    "def transform_order_row(row):\n",
    "    \"\"\"複雜行轉換\"\"\"\n",
    "    # 分離名字和姓氏\n",
    "    name_parts = row['客戶名'].split()\n",
    "    \n",
    "    return pd.Series({\n",
    "        '客戶首名': name_parts[0] if len(name_parts) > 0 else '',\n",
    "        '客戶姓': name_parts[-1] if len(name_parts) > 1 else '',\n",
    "        '小計': row['價格'] * row['數量'],\n",
    "        '稅費': row['價格'] * row['數量'] * 0.05,\n",
    "        '總額': row['價格'] * row['數量'] * 1.05\n",
    "    })\n",
    "\n",
    "result = orders.apply(transform_order_row, axis=1)\n",
    "orders = pd.concat([orders, result], axis=1)\n",
    "print(orders[['訂單ID', '客戶首名', '客戶姓', '商品', '小計', '稅費', '總額']])\n",
    "\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(\"✅ Week 5 Day 9 Apply 深度潛水 - 完成！\")\n",
    "print(\"=\"*50)"
   ]
