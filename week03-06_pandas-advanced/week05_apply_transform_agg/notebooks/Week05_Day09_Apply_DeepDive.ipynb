    "print(\"=== 實戰案例 1：RFM 評分系統 ===\")\n",
    "\n",
    "# 創建客戶交易數據\n",
    "transactions = pd.DataFrame({\n",
    "    '客戶ID': ['C001', 'C001', 'C001', 'C002', 'C002', 'C003', 'C004', 'C005', 'C005', 'C005'],\n",
    "    '交易日期': pd.date_range('2024-01-01', periods=10, freq='10D'),\n",
    "    '交易額': [100, 150, 200, 500, 300, 1000, 100, 250, 350, 400]\n",
    "})\n",
    "\n",
    "# 計算 RFM 指標\n",
    "base_date = pd.Timestamp('2024-12-31')\n",
    "rfm = transactions.groupby('客戶ID').agg({\n",
    "    '交易日期': lambda x: (base_date - x.max()).days,  # Recency\n",
    "    '客戶ID': 'count',  # Frequency\n",
    "    '交易額': 'sum'  # Monetary\n",
    "})\n",
    "\n",
    "rfm.columns = ['R', 'F', 'M']\n",
    "print(\"\\nRFM 指標：\")\n",
    "print(rfm)\n",
    "\n",
    "# 使用 apply 計算 RFM 分數\n",
    "def score_rfm(value, metric, ascending=False):\n",
    "    \"\"\"計算 RFM 分數（1-5 分）\"\"\"\n",
    "    sorted_vals = sorted(value.unique())\n",
    "    if ascending:\n",
    "        sorted_vals = sorted_vals\n",
    "    else:\n",
    "        sorted_vals = sorted_vals[::-1]\n",
    "    \n",
    "    # 分成 5 個等級\n",
    "    scores = {}\n",
    "    for i, val in enumerate(sorted_vals):\n",
    "        scores[val] = min(5, (i // max(1, (len(sorted_vals)-1)//4)) + 1)\n",
    "    return scores\n",
    "\n",
    "# 為每個指標計算分數\n",
    "rfm['R_score'] = rfm['R'].apply(lambda x: 5 if x <= 30 else (4 if x <= 60 else (3 if x <= 90 else (2 if x <= 180 else 1))))\n",
    "rfm['F_score'] = rfm['F'].apply(lambda x: 5 if x >= 4 else (4 if x >= 3 else (3 if x >= 2 else (2 if x >= 1 else 1))))\n",
    "rfm['M_score'] = rfm['M'].apply(lambda x: 5 if x >= 1000 else (4 if x >= 500 else (3 if x >= 300 else (2 if x >= 150 else 1))))\n",
    "\n",
    "print(\"\\nRFM 分數：\")\n",
    "print(rfm[['R_score', 'F_score', 'M_score']])\n",
    "\n",
    "# 計算總分和客戶等級\n",
    "rfm['RFM_分數'] = rfm[['R_score', 'F_score', 'M_score']].apply(np.mean, axis=1)\n",
    "rfm['客戶等級'] = rfm['RFM_分數'].apply(\n",
    "    lambda x: '鑽石' if x >= 4.5 else ('白金' if x >= 3.5 else ('黃金' if x >= 2.5 else '普通'))\n",
    ")\n",
    "\n",
    "print(\"\\nRFM 分析結果：\")\n",
    "print(rfm[['R', 'F', 'M', 'RFM_分數', '客戶等級']])"
   ]
