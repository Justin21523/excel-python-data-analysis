    "### 2.3 會員等級系統（實戰應用）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 創建客戶數據\n",
    "customers = pd.DataFrame({\n",
    "    '客戶ID': ['C001', 'C002', 'C003', 'C004', 'C005'],\n",
    "    '年消費額': [15000, 8000, 25000, 5000, 12000],\n",
    "    '購買次數': [50, 30, 80, 15, 45],\n",
    "    '最後購買天數': [5, 30, 2, 120, 20]\n",
    "})\n",
    "\n",
    "print(\"=== 範例 5：複合會員等級系統 ===\")\n",
    "print(\"原始客戶數據：\")\n",
    "print(customers)\n",
    "\n",
    "def assign_member_level(row):\n",
    "    \"\"\"複合評分系統\n",
    "    - 消費額占50%\n",
    "    - 購買次數占30%\n",
    "    - 活躍度占20%\n",
    "    \"\"\"\n",
    "    # 標準化各項指標（0-100分）\n",
    "    max_spending = 25000\n",
    "    max_purchases = 80\n",
    "    \n",
    "    spending_score = (row['年消費額'] / max_spending) * 100\n",
    "    purchase_score = (row['購買次數'] / max_purchases) * 100\n",
    "    # 活躍度：越近期越高\n",
    "    activity_score = max(0, 100 - row['最後購買天數'])\n",
    "    \n",
    "    # 加權評分\n",
    "    total_score = (spending_score * 0.5 + \n",
    "                   purchase_score * 0.3 + \n",
    "                   activity_score * 0.2)\n",
    "    \n",
    "    if total_score >= 80:\n",
    "        return 'VIP鑽石'\n",
    "    elif total_score >= 60:\n",
    "        return 'VIP白金'\n",
    "    elif total_score >= 40:\n",
    "        return 'VIP黃金'\n",
    "    else:\n",
    "        return '普通會員'\n",
    "\n",
    "customers['會員等級'] = customers.apply(assign_member_level, axis=1)\n",
    "print(\"\\n分配會員等級後：\")\n",
    "print(customers)"
   ]
  },
  {
