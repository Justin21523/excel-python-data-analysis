    "# 範例 12：正則表達式和文字處理\n",
    "print(\"=== 範例 12：郵箱驗證和提取 ===\")\n",
    "emails = pd.Series([\n",
    "    'john.doe@gmail.com',\n",
    "    'invalid.email@',\n",
    "    'alice_smith@yahoo.com',\n",
    "    'no-at-symbol.com'\n",
    "], name='郵箱')\n",
    "\n",
    "def validate_email(email):\n",
    "    \"\"\"驗證郵箱格式\"\"\"\n",
    "    pattern = r'^[^@]+@[^@]+\\.[^@]+$'\n",
    "    return bool(re.match(pattern, email))\n",
    "\n",
    "def extract_domain(email):\n",
    "    \"\"\"提取郵箱域名\"\"\"\n",
    "    match = re.search(r'@(.+)', email)\n",
    "    return match.group(1) if match else '無效'\n",
    "\n",
    "validation = emails.apply(validate_email)\n",
    "domains = emails.apply(extract_domain)\n",
    "\n",
    "print(\"郵箱驗證結果：\")\n",
    "print(validation)\n",
    "print(\"\\n域名提取：\")\n",
    "print(domains)\n"
