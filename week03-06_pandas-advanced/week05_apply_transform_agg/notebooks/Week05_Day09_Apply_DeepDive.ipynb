    "print(\"\\n=== 實戰案例 5：績效評分 ===\")\n",
    "\n",
    "employees = pd.DataFrame({\n",
    "    '員工ID': ['E001', 'E002', 'E003', 'E004', 'E005'],\n",
    "    '姓名': ['Alice', 'Bob', 'Charlie', 'David', 'Eva'],\n",
    "    '銷售額': [100000, 85000, 120000, 75000, 95000],\n",
    "    '客戶滿意度': [4.5, 3.8, 4.8, 3.5, 4.2],\n",
    "    '出勤率': [0.98, 0.92, 0.95, 0.88, 0.99]\n",
    "})\n",
    "\n",
    "def calculate_performance_score(row):\n",
    "    \"\"\"計算綜合績效分數\"\"\"\n",
    "    # 銷售額分數（滿分100）\n",
    "    max_sales = employees['銷售額'].max()\n",
    "    sales_score = (row['銷售額'] / max_sales) * 40  # 佔40%\n",
    "    \n",
    "    # 滿意度分數（滿分100）\n",
    "    satisfaction_score = (row['客戶滿意度'] / 5) * 35  # 佔35%\n",
    "    \n",
    "    # 出勤率分數（滿分100）\n",
    "    attendance_score = row['出勤率'] * 25  # 佔25%\n",
    "    \n",
    "    total_score = sales_score + satisfaction_score + attendance_score\n",
    "    \n",
    "    # 評級\n",
    "    if total_score >= 90:\n",
    "        level = 'A'\n",
    "    elif total_score >= 75:\n",
    "        level = 'B'\n",
    "    elif total_score >= 60:\n",
    "        level = 'C'\n",
    "    else:\n",
    "        level = 'D'\n",
    "    \n",
    "    return pd.Series({\n",
    "        '績效分數': round(total_score, 2),\n",
    "        '績效等級': level\n",
    "    })\n",
    "\n",
    "perf = employees.apply(calculate_performance_score, axis=1)\n",
    "employees = pd.concat([employees, perf], axis=1)\n",
    "print(employees[['姓名', '銷售額', '客戶滿意度', '出勤率', '績效分數', '績效等級']])"
   ]
  },
