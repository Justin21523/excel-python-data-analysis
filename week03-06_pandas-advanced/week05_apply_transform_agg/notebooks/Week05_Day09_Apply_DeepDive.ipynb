    "print(\"\\n=== 實戰案例 2：文字清洗管道 ===\")\n",
    "\n",
    "reviews = pd.DataFrame({\n",
    "    '評論ID': range(1, 6),\n",
    "    '評論文本': [\n",
    "        '  太好了!!!非常滿意  ',\n",
    "        'AMAZING quality...amazing price!!!',\n",
    "        '品質不錯...但是物流太慢了...',\n",
    "        '完全失望...不推薦!!!',\n",
    "        '還可以吧,就是有點貴'\n",
    "    ]\n",
    "})\n",
    "\n",
    "def clean_text_pipeline(text):\n",
    "    \"\"\"多步驟文字清洗\"\"\"\n",
    "    # 步驟 1：去除多餘空格\n",
    "    text = text.strip()\n",
    "    \n",
    "    # 步驟 2：統一大小寫\n",
    "    text = text.lower()\n",
    "    \n",
    "    # 步驟 3：去除多個符號\n",
    "    text = re.sub(r'[!?。]+', '.', text)\n",
    "    text = re.sub(r'\\.{2,}', '.', text)\n",
    "    \n",
    "    # 步驟 4：去除多餘點號\n",
    "    text = text.strip('.')\n",
    "    \n",
    "    return text\n",
    "\n",
    "reviews['清洗後'] = reviews['評論文本'].apply(clean_text_pipeline)\n",
    "print(reviews)\n",
    "\n",
    "# 情感分析\n",
    "positive_words = ['好', '滿意', 'amazing', 'quality', '優']\n",
    "negative_words = ['差', '失望', '慢', '貴', '不推薦']\n",
    "\n",
    "def analyze_sentiment(text):\n",
    "    \"\"\"簡單情感分析\"\"\"\n",
    "    text_lower = text.lower()\n",
    "    pos_count = sum(1 for word in positive_words if word in text_lower)\n",
    "    neg_count = sum(1 for word in negative_words if word in text_lower)\n",
    "    \n",
    "    if pos_count > neg_count:\n",
    "        return '正面'\n",
    "    elif neg_count > pos_count:\n",
    "        return '負面'\n",
    "    else:\n",
    "        return '中立'\n",
    "\n",
    "reviews['情感'] = reviews['清洗後'].apply(analyze_sentiment)\n",
    "print(\"\\n情感分析結果：\")\n",
    "print(reviews[['評論文本', '情感']])"
   ]
