   "source": [
    "### 2.1 axis 參數（row vs column）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 創建銷售數據\n",
    "sales_data = pd.DataFrame({\n",
    "    '1月': [100, 200, 150, 300],\n",
    "    '2月': [150, 250, 200, 350],\n",
    "    '3月': [200, 300, 250, 400],\n",
    "    '品類': ['手機', '平板', '配件', '電腦']\n",
    "})\n",
    "\n",
    "sales_data.index.name = '商品'\n",
    "print(\"原始數據：\")\n",
    "print(sales_data)\n",
    "\n",
    "# 範例 1：按列計算（axis=0，對每一列）\n",
    "print(\"\\n=== 範例 1：按列計算平均值 ===\")\n",
    "monthly_avg = sales_data[['1月', '2月', '3月']].apply(np.mean, axis=0)\n",
    "print(\"每月平均銷售：\")\n",
    "print(monthly_avg)\n",
    "\n",
    "# 範例 2：按列計算多個統計量\n",
    "print(\"\\n=== 範例 2：每月統計 ===\")\n",
    "def month_stats(col):\n",
    "    \"\"\"計算月度統計\"\"\"\n",
    "    return pd.Series({\n",
    "        '平均': col.mean(),\n",
    "        '最小': col.min(),\n",
    "        '最大': col.max(),\n",
    "        '標準差': col.std()\n",
    "    })\n",
    "\n",
    "stats = sales_data[['1月', '2月', '3月']].apply(month_stats, axis=0)\n",
    "print(stats)"
   ]
  },
