{
 "cells": [
  {
   "cell_type": {"text": "markdown"}, "metadata": {},
   "source": [
    "# Week 5 Capstone: RFM 客戶分群系統\n",
    "## 完整的客戶價值分析與分群實現\n",
    "\n",
    "**項目目標：**\n",
    "- Step 1: 計算 RFM 指標\n",
    "- Step 2: RFM 評分（五分位）\n",
    "- Step 3: 客戶分群（11 種分群）\n",
    "- Step 4: 價值分析與 LTV 估算\n",
    "- Step 5: 流失預警系統\n",
    "- Step 6: 行銷建議生成\n",
    "- Step 7: 視覺化與報表輸出"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "# 生成模擬數據\n",
    "np.random.seed(42)\n",
    "n_customers = 100\n",
    "\n",
    "transactions = pd.DataFrame({\n",
    "    'customer_id': np.repeat(range(1, n_customers+1), 5),\n",
    "    'transaction_date': [pd.to_datetime('2023-01-01') + timedelta(days=int(x)) for x in np.random.uniform(0, 365, n_customers*5)],\n",
    "    'amount': np.random.randint(100, 2000, n_customers*5)\n",
    "})\n",
    "\nprint(\"=== 原始交易數據 ===\")\nprint(transactions.head(10))\nprint(f\"總交易數：{len(transactions)}，客戶數：{transactions['customer_id'].nunique()}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# Step 1: 計算 RFM 指標\nprint(\"\\n\" + \"=\"*60)\nprint(\"Step 1: 計算 RFM 指標\")\nprint(\"=\"*60)\n",
    "\nreference_date = pd.Timestamp('2023-12-31')\n",
    "\nrfm = transactions.groupby('customer_id').agg({\n",
    "    'transaction_date': lambda x: (reference_date - x.max()).days,  # Recency\n",
    "    'customer_id': 'count',  # Frequency\n",
    "    'amount': 'sum'  # Monetary\n",
    "}).rename(columns={\n",
    "    'transaction_date': 'Recency',\n",
    "    'customer_id': 'Frequency',\n",
    "    'amount': 'Monetary'\n",
    "})\n",
    "\nprint(\"\\nRFM 指標統計：\")\nprint(rfm.describe())"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# Step 2: RFM 評分（五分位）\nprint(\"\\n\" + \"=\"*60)\nprint(\"Step 2: RFM 評分（1-5 分）\")\nprint(\"=\"*60)\n",
    "\n# Recency: 越小越好（最近購買），所以反向計分\nrfm['R_Score'] = pd.qcut(rfm['Recency'], q=5, labels=[5, 4, 3, 2, 1], duplicates='drop')\n\n# Frequency: 越大越好\nrfm['F_Score'] = pd.qcut(rfm['Frequency'].rank(method='first'), q=5, labels=[1, 2, 3, 4, 5], duplicates='drop')\n",
    "\n# Monetary: 越大越好\nrfm['M_Score'] = pd.qcut(rfm['Monetary'], q=5, labels=[1, 2, 3, 4, 5], duplicates='drop')\n",
    "\n# 轉換為數值\nrfm['R_Score'] = rfm['R_Score'].astype(int)\nrfm['F_Score'] = rfm['F_Score'].astype(int)\nrfm['M_Score'] = rfm['M_Score'].astype(int)\n",
    "\n# 計算 RFM 綜合分數\nrfm['RFM_Score'] = rfm['R_Score'] * 100 + rfm['F_Score'] * 10 + rfm['M_Score']\n",
    "\nprint(\"\\nRFM 評分示例（前 10 位客戶）：\")\nprint(rfm[['Recency', 'Frequency', 'Monetary', 'R_Score', 'F_Score', 'M_Score', 'RFM_Score']].head(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# Step 3: 客戶分群（11 種分群）\nprint(\"\\n\" + \"=\"*60)\nprint(\"Step 3: 客戶分群（11 種）\")\nprint(\"=\"*60)\n",
    "\ndef segment_customers(row):\n",
    "    \"\"\"根據 RFM 分數進行分群\"\"\"\n",
    "    r, f, m = row['R_Score'], row['F_Score'], row['M_Score']\n",
    "    \n",
    "    # 高價值客戶\n",
    "    if r >= 4 and f >= 4 and m >= 4:\n",
    "        return '金牌客戶'\n",
    "    elif r >= 4 and f >= 4 and m >= 3:\n",
    "        return '忠實客戶'\n",
    "    elif r >= 4 and f >= 3 and m >= 4:\n",
    "        return '潛力客戶'\n",
    "    \n",
    "    # 中等價值客戶\n",
    "    elif r >= 3 and f >= 3 and m >= 3:\n",
    "        return '活躍客戶'\n",
    "    elif r >= 3 and f >= 2 and m >= 3:\n",
    "        return '需維護客戶'\n",
    "    \n",
    "    # 低價值但有潛力\n",
    "    elif r >= 4 and f <= 2 and m >= 3:\n",
    "        return '新客戶'\n",
    "    elif r >= 4 and m <= 2:\n",
    "        return '小額新客'\n",
    "    \n",
    "    # 風險客戶\n",
    "    elif r <= 2 and f >= 3:\n",
    "        return '流失風險'\n",
    "    elif r <= 2 and f <= 2:\n",
    "        return '即將流失'\n",
    "    \n",
    "    # 其他\n",
    "    elif f == 1:\n",
    "        return '一次性客戶'\n",
    "    else:\n",
    "        return '普通客戶'\n",
    "\nrfm['Segment'] = rfm.apply(segment_customers, axis=1)\n",
    "\nprint(\"\\n客戶分群統計：\")\nprint(rfm['Segment'].value_counts())\n",
    "\nprint(\"\\n各分群的 RFM 特徵：\")\nsegment_profile = rfm.groupby('Segment').agg({\n",
    "    'Recency': 'mean',\n",
    "    'Frequency': 'mean',\n",
    "    'Monetary': 'mean',\n",
    "    'RFM_Score': 'mean'\n",
    "}).round(2).sort_values('RFM_Score', ascending=False)\nprint(segment_profile)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# Step 4: 價值分析與 LTV 估算\nprint(\"\\n\" + \"=\"*60)\nprint(\"Step 4: 客戶價值分析與 LTV\")\nprint(\"=\"*60)\n",
    "\n# 計算客戶價值指標\nrfm['AVG_Order_Value'] = rfm['Monetary'] / rfm['Frequency']\nrfm['Purchase_Frequency'] = rfm['Frequency'] / (365 / (rfm['Recency'] + 1))\n\n# 簡化的 LTV 計算 (利潤率假設為 30%)\nrfm['Profit_Margin'] = rfm['Monetary'] * 0.30\nrfm['LTV_Estimate'] = rfm['Monetary'] * rfm['Purchase_Frequency'] * 3  # 3 年客戶生命週期\n\nprint(\"\\n客戶價值指標示例（前 10 位）：\")\nprint(rfm[['Monetary', 'Frequency', 'AVG_Order_Value', 'Purchase_Frequency', 'LTV_Estimate']].head(10).round(2))\n",
    "\nprint(\"\\n按分群的客戶終身價值（LTV）：\")\nltv_by_segment = rfm.groupby('Segment')[['Monetary', 'LTV_Estimate', 'Profit_Margin']].mean().round(0).sort_values('LTV_Estimate', ascending=False)\nprint(ltv_by_segment)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# Step 5: 流失預警系統\nprint(\"\\n\" + \"=\"*60)\nprint(\"Step 5: 流失預警系統\")\nprint(\"=\"*60)\n",
    "\n# 定義流失風險等級\ndef churn_risk(row):\n",
    "    \"\"\"評估客戶流失風險\"\"\"\n",
    "    recency_months = row['Recency'] / 30\n",
    "    \n",
    "    if row['Segment'] in ['即將流失', '流失風險']:\n",
    "        return '🔴 極高風險'\n",
    "    elif recency_months > 3 and row['Frequency'] < 5:\n",
    "        return '🟠 高風險'\n",
    "    elif recency_months > 2:\n",
    "        return '🟡 中風險'\n",
    "    else:\n",
    "        return '🟢 低風險'\n",
    "\nrfm['Churn_Risk'] = rfm.apply(churn_risk, axis=1)\n",
    "\nprint(\"\\n流失風險分佈：\")\nprint(rfm['Churn_Risk'].value_counts())\n",
    "\n# 高風險客戶\nhigh_risk = rfm[rfm['Churn_Risk'].isin(['🔴 極高風險', '🟠 高風險'])]\nprint(f\"\\n需要立即關注的客戶數：{len(high_risk)}\")\nprint(\"\\n高風險客戶示例：\")\nprint(high_risk[['Recency', 'Frequency', 'Monetary', 'Segment', 'Churn_Risk']].head())"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# Step 6: 行銷建議生成\nprint(\"\\n\" + \"=\"*60)\nprint(\"Step 6: 行銷建議生成\")\nprint(\"=\"*60)\n",
    "\ndef marketing_strategy(row):\n",
    "    \"\"\"根據分群生成行銷建議\"\"\"\n",
    "    segment = row['Segment']\n",
    "    \n",
    "    strategies = {\n",
    "        '金牌客戶': '💎 VIP 服務 - 提供專屬客服、會員折扣、新品優先體驗',\n",
    "        '忠實客戶': '🎁 忠誠度計劃 - 增加購買獎勵、升級會員權益',\n",
    "        '潛力客戶': '🚀 激活計劃 - 提升購買頻率，交叉銷售',\n",
    "        '活躍客戶': '📈 保持互動 - 定期推送優惠、新品通知',\n",
    "        '需維護客戶': '⚠️ 喚回計劃 - 個性化優惠、免郵費優惠',\n",
    "        '新客戶': '🎯 轉化計劃 - 首購優惠、產品推薦、建立複購',\n",
    "        '小額新客': '💰 升客計劃 - 建議大額商品、組合優惠',\n",
    "        '流失風險': '📞 挽回計劃 - 個性化溝通、重大折扣、調查原因',\n",
    "        '即將流失': '🆘 緊急挽回 - 最高折扣、VIP 待遇恢復體驗',\n",
    "        '一次性客戶': '🔄 複購激勵 - 首次複購優惠、推薦機制',\n",
    "        '普通客戶': '📧 基礎維護 - 郵件營銷、定期促銷'\n",
    "    }\n",
    "    return strategies.get(segment, '維持現狀')\n",
    "\nrfm['Marketing_Strategy'] = rfm['Segment'].apply(lambda x: marketing_strategy({'Segment': x}))\n",
    "\nprint(\"\\n行銷策略映射表：\")\nfor segment in rfm['Segment'].unique():\n",
    "    strategy = marketing_strategy({'Segment': segment})\n",
    "    count = len(rfm[rfm['Segment'] == segment])\n",
    "    print(f\"{segment:>8} ({count:>2} 人): {strategy}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# Step 7: 視覺化與報表輸出\nprint(\"\\n\" + \"=\"*60)\nprint(\"Step 7: 綜合報表輸出\")\nprint(\"=\"*60)\n",
    "\n# 建立最終報表\nfinal_report = rfm[['Recency', 'Frequency', 'Monetary', 'RFM_Score', 'Segment', 'Churn_Risk', 'LTV_Estimate']].copy()\nfinal_report = final_report.reset_index().rename(columns={'customer_id': 'Customer_ID'})\n\nprint(\"\\n最終客戶分析報表（前 15 行）：\")\nprint(final_report.head(15).to_string(index=False))\n",
    "\n# 分群的商業價值\nprint(\"\\n\\n分群商業價值分析：\")\nvalue_analysis = rfm.groupby('Segment').agg({\n    'Monetary': ['count', 'sum', 'mean'],\n    'LTV_Estimate': 'sum',\n    'Frequency': 'mean'\n}).round(0).sort_values(('Monetary', 'sum'), ascending=False)\n",
    "\nvalue_analysis.columns = ['客戶數', '總銷售額', '平均客單價', '總LTV', '平均購買次數']\nprint(value_analysis)\n",
    "\n# 關鍵指標\nprint(\"\\n\\n關鍵業務指標：\")\nprint(f\"總客戶數: {len(rfm)}\")\nprint(f\"總銷售額: ${rfm['Monetary'].sum():,.0f}\")\nprint(f\"客均價值: ${rfm['Monetary'].mean():.0f}\")\nprint(f\"預計 LTV: ${rfm['LTV_Estimate'].sum():,.0f}\")\nprint(f\"流失風險客戶: {len(high_risk)} ({len(high_risk)/len(rfm)*100:.1f}%)\")\nprint(f\"高價值客戶（金牌+忠實）: {len(rfm[rfm['Segment'].isin(['金牌客戶', '忠實客戶'])])} ({len(rfm[rfm['Segment'].isin(['金牌客戶', '忠實客戶'])])/len(rfm)*100:.1f}%)\")"
   ]
  }
 ],
