   "source": [
    "# Week 4 Capstone: 時間序列分析儀表板\n",
    "## TimeSeries Dashboard - 完整專案實現\n",
    "\n",
    "**項目目標：**\n",
    "構建一個綜合的時間序列分析系統，包括：\n",
    "- 日週月趨勢分析\n",
    "- 移動平均線技術分析\n",
    "- YTD 累計分析\n",
    "- 成長率分析 (MoM)\n",
    "- 季節性分析\n",
    "- 異常檢測系統\n",
    "- 綜合 KPI 報表\n",
    "\n",
    "**時間估計：** 3-4 小時"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# ========== 環境設定 ==========\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 顯示設定\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.max_rows', 100)\n",
    "pd.set_option('display.width', None)\n",
    "\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "print(\"✅ 環境設定完成\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# ========== 數據準備 ==========\nnp.random.seed(42)\n",
    "\n",
    "# 生成 2 年的銷售數據\ndate_range = pd.date_range('2022-01-01', periods=730, freq='D')\nbase_sales = np.linspace(1000, 2000, 730)\nseasonal = 500 * np.sin(np.arange(730)/365*2*np.pi)\nnoise = np.random.normal(0, 100, 730)\n",
    "\nsales_df = pd.DataFrame({\n",
    "    'date': date_range,\n",
    "    'sales': (base_sales + seasonal + noise).clip(lower=0).astype(int),\n",
    "    'units': np.random.randint(50, 200, 730),\n",
    "    'category': np.random.choice(['A', 'B', 'C'], 730)\n",
    "})\n",
    "\nsales_df = sales_df.set_index('date')\nprint(\"=== 原始銷售數據 ===\")\nprint(sales_df.head(10))\nprint(f\"數據範圍：{sales_df.index.min().date()} 至 {sales_df.index.max().date()}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 功能 1: 日週月趨勢分析"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*60)\nprint(\"功能 1: 日週月趨勢分析\")\nprint(\"=\"*60)\n",
    "\n# 各時間頻度的聚合\ndaily = sales_df['sales'].copy()\nweekly = sales_df['sales'].resample('W').sum()\nmonthly = sales_df['sales'].resample('M').sum()\nquarterly = sales_df['sales'].resample('Q').sum()\n",
    "\n# 創建對比表\ntrend_analysis = pd.DataFrame({\n    'Period': ['日度', '週度', '月度', '季度'],\n    '樣本數': [len(daily), len(weekly), len(monthly), len(quarterly)],\n    '總銷售額': [\n        daily.sum(),\n        weekly.sum(),\n        monthly.sum(),\n        quarterly.sum()\n    ],\n    '平均值': [\n        daily.mean(),\n        weekly.mean(),\n        monthly.mean(),\n        quarterly.mean()\n    ],\n    '最大值': [\n        daily.max(),\n        weekly.max(),\n        monthly.max(),\n        quarterly.max()\n    ],\n    '最小值': [\n        daily.min(),\n        weekly.min(),\n        monthly.min(),\n        quarterly.min()\n    ]\n})\n",
    "\nprint(\"\\n時間頻度統計對比：\")\nprint(trend_analysis.to_string(index=False))\n",
    "\nprint(f\"\\n按月份的銷售額：\")\nprint(monthly)\n",
    "\nprint(f\"\\n按季度的銷售額：\")\nprint(quarterly)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 功能 2: 移動平均線分析（7/30/90 日）"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*60)\nprint(\"功能 2: 移動平均線分析\")\nprint(\"=\"*60)\n",
    "\n# 計算移動平均線\nsales_df['SMA_7'] = sales_df['sales'].rolling(7).mean()\nsales_df['SMA_30'] = sales_df['sales'].rolling(30).mean()\nsales_df['SMA_90'] = sales_df['sales'].rolling(90).mean()\n",
    "\n# 計算指數加權移動平均\nsales_df['EMA_12'] = sales_df['sales'].ewm(span=12).mean()\nsales_df['EMA_26'] = sales_df['sales'].ewm(span=26).mean()\n",
    "\n# MACD 計算\nsales_df['MACD'] = sales_df['EMA_12'] - sales_df['EMA_26']\nsales_df['Signal'] = sales_df['MACD'].ewm(span=9).mean()\nsales_df['MACD_Hist'] = sales_df['MACD'] - sales_df['Signal']\n",
    "\nprint(\"\\n移動平均線與技術指標（最後 30 天）：\")\nma_display = sales_df[['sales', 'SMA_7', 'SMA_30', 'SMA_90', 'MACD', 'Signal']].tail(30)\nprint(ma_display)\n",
    "\n# 趨勢分析\nprint(f\"\\n技術面分析：\")\nprint(f\"短期趨勢（7日 SMA）：\", \"⬆️ 向上\" if sales_df['SMA_7'].iloc[-1] > sales_df['SMA_30'].iloc[-1] else \"⬇️ 向下\")\nprint(f\"中期趨勢（30日 SMA）：\", \"⬆️ 向上\" if sales_df['SMA_30'].iloc[-1] > sales_df['SMA_90'].iloc[-1] else \"⬇️ 向下\")\nprint(f\"長期趨勢（90日 SMA）：\", \"⬆️ 向上\" if sales_df['SMA_90'].iloc[-1] > sales_df['SMA_90'].iloc[-30] else \"⬇️ 向下\")\nprint(f\"MACD 信號：\", \"🟢 買入\" if sales_df['MACD'].iloc[-1] > sales_df['Signal'].iloc[-1] else \"🔴 賣出\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 功能 3: YTD（年初至今）累計分析"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*60)\nprint(\"功能 3: YTD 累計分析\")\nprint(\"=\"*60)\n",
    "\n# 添加年月日信息\nsales_df['year'] = sales_df.index.year\nsales_df['month'] = sales_df.index.month\nsales_df['day_of_year'] = sales_df.index.dayofyear\n",
    "\n# 按年份計算 YTD\nfor year in sales_df['year'].unique():\n    year_data = sales_df[sales_df['year'] == year]\n    sales_df.loc[sales_df['year'] == year, f'ytd_{year}'] = year_data['sales'].expanding().sum()\n",
    "\n# 計算 YTD 統計\nytd_stats = []\nfor year in sorted(sales_df['year'].unique()):\n    year_data = sales_df[sales_df['year'] == year]\n    ytd_stats.append({\n        '年份': year,\n        '年初至今銷售額': year_data[f'ytd_{year}'].iloc[-1],\n        '日均銷售': year_data['sales'].mean(),\n        '累計天數': len(year_data),\n        '最高日銷售': year_data['sales'].max(),\n        '最低日銷售': year_data['sales'].min()\n    })\n",
    "\nytd_df = pd.DataFrame(ytd_stats)\nprint(\"\\nYTD 統計：\")\nprint(ytd_df.to_string(index=False))\n",
    "\n# 月度進度\nprint(f\"\\n2023 年月度進度：\")\nmonth_progress = sales_df[sales_df['year'] == 2023].groupby('month')['sales'].agg([\n    ('月銷售額', 'sum'),\n    ('日均', 'mean'),\n    ('累計至月末', lambda x: x.expanding().sum().iloc[-1])\n]).reset_index()\nprint(month_progress)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 功能 4: 成長率分析 (MoM - Month-over-Month)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*60)\nprint(\"功能 4: 成長率分析 (MoM)\")\nprint(\"=\"*60)\n",
    "\n# 月度銷售聚合\nmonthly_sales = sales_df.groupby(['year', 'month'])['sales'].sum().reset_index()\nmonthly_sales['year_month'] = pd.to_datetime(monthly_sales[['year', 'month']].assign(day=1))\nmonthly_sales = monthly_sales.sort_values('year_month')\n",
    "\n# 計算 MoM\nmonthly_sales['mom_sales_diff'] = monthly_sales['sales'].diff()\nmonthly_sales['mom_pct'] = monthly_sales['sales'].pct_change() * 100\n",
    "\nprint(\"\\nMonth-over-Month 增長分析：\")\nprint(monthly_sales[['year_month', 'sales', 'mom_sales_diff', 'mom_pct']].to_string(index=False))\n",
    "\nprint(f\"\\nMoM 統計摘要：\")\nprint(f\"平均月度增長：{monthly_sales['mom_pct'].mean():.2f}%\")\nprint(f\"最強增長月份：{monthly_sales.loc[monthly_sales['mom_pct'].idxmax(), 'year_month'].strftime('%Y-%m')}（+{monthly_sales['mom_pct'].max():.2f}%）\")\nprint(f\"最弱增長月份：{monthly_sales.loc[monthly_sales['mom_pct'].idxmin(), 'year_month'].strftime('%Y-%m')}（{monthly_sales['mom_pct'].min():.2f}%）\")\nprint(f\"正增長月數：{(monthly_sales['mom_pct'] > 0).sum()}\")\nprint(f\"負增長月數：{(monthly_sales['mom_pct'] < 0).sum()}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 功能 5: 季節性分析"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*60)\nprint(\"功能 5: 季節性分析\")\nprint(\"=\"*60)\n",
    "\n# 按月份的季節指數\nmonthly_avg = sales_df.groupby('month')['sales'].agg(['mean', 'std', 'count'])\noverall_mean = sales_df['sales'].mean()\nmonthly_avg['季節指數'] = monthly_avg['mean'] / overall_mean\n",
    "\nprint(\"\\n月份季節指數：\")\nmonth_names = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']\nfor idx, (month, row) in enumerate(monthly_avg.iterrows(), 1):\n    print(f\"{month_names[month-1]:>3}: 平均={row['mean']:>8.0f}, 指數={row['季節指數']:>5.2f} {'📈' if row['季節指數'] > 1 else '📉'}\")\n",
    "\n# 季度分析\nquarterly_analysis = sales_df.groupby('quarter' if 'quarter' in sales_df.columns else sales_df.index.quarter)['sales'].agg([\n    ('季度銷售額', 'sum'),\n    ('平均日銷售', 'mean'),\n    ('波動性', 'std')\n])\n",
    "\nprint(f\"\\n季度分析：\")\nprint(quarterly_analysis)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 功能 6: 異常檢測系統"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*60)\nprint(\"功能 6: 異常檢測系統\")\nprint(\"=\"*60)\n",
    "\n# 布林帶\nsales_df['bb_middle'] = sales_df['sales'].rolling(20).mean()\nsales_df['bb_std'] = sales_df['sales'].rolling(20).std()\nsales_df['bb_upper'] = sales_df['bb_middle'] + 2 * sales_df['bb_std']\nsales_df['bb_lower'] = sales_df['bb_middle'] - 2 * sales_df['bb_std']\nsales_df['anomaly_bb'] = (sales_df['sales'] > sales_df['bb_upper']) | (sales_df['sales'] < sales_df['bb_lower'])\n",
    "\n# 基於 Z-score\nfrom scipy import stats\nsales_df['z_score'] = np.abs(stats.zscore(sales_df['sales'].dropna()))\nsales_df['anomaly_zscore'] = sales_df['z_score'] > 3\n",
    "\n# 基於 IQR\nq1 = sales_df['sales'].rolling(30).quantile(0.25)\nq3 = sales_df['sales'].rolling(30).quantile(0.75)\niqr = q3 - q1\nsales_df['anomaly_iqr'] = (sales_df['sales'] < q1 - 1.5*iqr) | (sales_df['sales'] > q3 + 1.5*iqr)\n",
    "\n# 綜合異常標記\nsales_df['is_anomaly'] = sales_df['anomaly_bb'] | sales_df['anomaly_iqr']\n",
    "\nanomalies = sales_df[sales_df['is_anomaly']]\nprint(f\"\\n異常檢測結果：\")\nprint(f\"檢測到異常點：{len(anomalies)} 個（占 {len(anomalies)/len(sales_df)*100:.2f}%）\")\nprint(f\"\\n異常點詳情（前 15 個）：\")\nif len(anomalies) > 0:\n    print(anomalies[['sales', 'bb_middle', 'bb_upper', 'bb_lower']].head(15))\n\n# 異常點時間分布\nprint(f\"\\n異常點按月份分布：\")\nanomaly_by_month = anomalies.groupby('month').size()\nfor month in range(1, 13):\n    count = anomaly_by_month.get(month, 0)\n    if count > 0:\n        print(f\"{month_names[month-1]}: {count} 個\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 功能 7: 綜合 KPI 報表"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*60)\nprint(\"功能 7: 綜合 KPI 報表\")\nprint(\"=\"*60)\n",
    "\n# 基礎 KPI\nkpis = {\n",
    "    '時間範圍': f\"{sales_df.index.min().date()} 至 {sales_df.index.max().date()}\",\n",
    "    '總天數': len(sales_df),\n",
    "    '總銷售額': f\"${sales_df['sales'].sum():,}\",\n",
    "    '日均銷售': f\"${sales_df['sales'].mean():.0f}\",\n",
    "    '銷售額中位數': f\"${sales_df['sales'].median():.0f}\",\n",
    "    '最高日銷售': f\"${sales_df['sales'].max()}\",\n",
    "    '最低日銷售': f\"${sales_df['sales'].min()}\",\n",
    "    '銷售波動性': f\"{sales_df['sales'].std():.2f}\",\n",
    "    '變異係數': f\"{(sales_df['sales'].std() / sales_df['sales'].mean()):.2%}\"\n",
    "}\n",
    "\nprint(\"\\n基礎 KPI：\")\nfor key, value in kpis.items():\n",
    "    print(f\"  {key:>15}: {value}\")\n",
    "\n# 增長 KPI\nprint(f\"\\n增長 KPI：\")\nlast_30_sales = sales_df.iloc[-30:]['sales'].sum()\nprev_30_sales = sales_df.iloc[-60:-30]['sales'].sum()\ngrowth_30 = ((last_30_sales - prev_30_sales) / prev_30_sales) * 100\n",
    "\nlast_7_sales = sales_df.iloc[-7:]['sales'].sum()\nprev_7_sales = sales_df.iloc[-14:-7]['sales'].sum()\ngrowth_7 = ((last_7_sales - prev_7_sales) / prev_7_sales) * 100\n",
    "\nprint(f\"  最近 7 天銷售額: ${last_7_sales:,.0f}\")\nprint(f\"  前 7 天銷售額: ${prev_7_sales:,.0f}\")\nprint(f\"  7 天環比增長: {growth_7:+.2f}%\")\nprint(f\"  最近 30 天銷售額: ${last_30_sales:,.0f}\")\nprint(f\"  前 30 天銷售額: ${prev_30_sales:,.0f}\")\nprint(f\"  30 天環比增長: {growth_30:+.2f}%\")\n",
    "\n# 年度 KPI\nprint(f\"\\n年度 KPI：\")\nfor year in sorted(sales_df['year'].unique()):\n    year_sales = sales_df[sales_df['year'] == year]['sales'].sum()\n    year_days = len(sales_df[sales_df['year'] == year])\n    year_daily_avg = year_sales / year_days\n    print(f\"  {year} 年：${year_sales:,.0f} (日均: ${year_daily_avg:.0f}, 天數: {year_days})\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 技術面 KPI\nprint(f\"\\n技術面 KPI：\")\nprint(f\"  平均 RSI: 計算中...\")\n\n# RSI 計算\ndelta = sales_df['sales'].diff()\ngain = (delta.where(delta > 0, 0)).rolling(14).mean()\nloss = (-delta.where(delta < 0, 0)).rolling(14).mean()\nrs = gain / loss\nsales_df['rsi'] = 100 - (100 / (1 + rs))\n",
    "\nprint(f\"  最新 RSI: {sales_df['rsi'].iloc[-1]:.2f}\")\nprint(f\"  超買狀態（RSI > 70）天數: {(sales_df['rsi'] > 70).sum()}\")\nprint(f\"  超賣狀態（RSI < 30）天數: {(sales_df['rsi'] < 30).sum()}\")\n",
    "\nprint(f\"\\n市場狀態：\")\ntrend_strength = \"強勢\" if abs(sales_df['MACD'].iloc[-1]) > 50 else \"弱勢\"\ntrend_direction = \"上升\" if sales_df['MACD'].iloc[-1] > 0 else \"下降\"\nprint(f\"  趨勢方向: {trend_direction}\")\nprint(f\"  趨勢強度: {trend_strength}\")\nprint(f\"  當前信號: {'🟢 買入' if sales_df['MACD'].iloc[-1] > sales_df['Signal'].iloc[-1] else '🔴 賣出'}\")\nprint(f\"  異常警告: {'⚠️ 存在異常值' if sales_df['is_anomaly'].iloc[-1] else '✅ 無異常'}\")"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "---\n",
    "## 最終報告總結"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "print(\"\\n\" + \"=\"*70)\nprint(\" \" * 20 + \"時間序列分析儀表板 - 最終報告\")\nprint(\"=\"*70)\n",
    "\nprint(f\"\"\"\n📊 分析周期：{sales_df.index.min().strftime('%Y年%m月%d日')} 至 {sales_df.index.max().strftime('%Y年%m月%d日')} ({len(sales_df)} 天)\n\n📈 銷售概況：\n   • 總銷售額：${sales_df['sales'].sum():,}\n   • 平均日銷售：${sales_df['sales'].mean():.2f}\n   • 最高日銷售：${sales_df['sales'].max()} ({sales_df['sales'].idxmax().strftime('%Y-%m-%d')})\n   • 最低日銷售：${sales_df['sales'].min()} ({sales_df['sales'].idxmin().strftime('%Y-%m-%d')})\n\n📊 趨勢分析：\n   • 短期（7 日）：{'⬆️ 向上' if sales_df['SMA_7'].iloc[-1] > sales_df['SMA_7'].iloc[-30] else '⬇️ 向下'}\n   • 中期（30 日）：{'⬆️ 向上' if sales_df['SMA_30'].iloc[-1] > sales_df['SMA_30'].iloc[-90] else '⬇️ 向下'}\n   • 長期（90 日）：{'⬆️ 向上' if sales_df['SMA_90'].iloc[-1] > sales_df['SMA_90'].iloc[-180] else '⬇️ 向下'}\n\n📅 季節性：\n   • 最高銷售月份：{month_names[monthly_avg['mean'].idxmax()-1]}（指數：{monthly_avg['季節指數'].max():.2f}）\n   • 最低銷售月份：{month_names[monthly_avg['mean'].idxmin()-1]}（指數：{monthly_avg['季節指數'].min():.2f}）\n\n⚠️ 異常檢測：\n   • 異常點數：{sales_df['is_anomaly'].sum()} 個（占 {sales_df['is_anomaly'].mean()*100:.2f}%）\n   • 異常密度：{'🔴 高' if sales_df['is_anomaly'].mean() > 0.05 else '🟢 低'}\n\n💡 建議：\n   • 監控異常點，可能表示市場異動\n   • 利用季節性規律進行銷售預測\n   • 關注趨勢反轉點，評估成長潛力\n   • 持續優化產品和營銷策略\n\"\"\")\n",
    "\nprint(\"=\"*70)"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 創建數據導出\nprint(\"\\n📁 數據導出準備...\\n\")\n",
    "\n# 導出月度報表\nmonthly_report = sales_df.groupby(['year', 'month']).agg({\n    'sales': ['sum', 'mean', 'std', 'min', 'max'],\n    'units': 'sum'\n}).reset_index()\n",
    "\nmonthly_report.columns = ['_'.join(col).strip('_') if col[1] else col[0] for col in monthly_report.columns.values]\nprint(f\"✅ 月度報表準備完成 ({len(monthly_report)} 行)\")\nprint(monthly_report)\n",
    "\n# 導出週度報表\nweekly_report = sales_df.groupby(sales_df.index.to_period('W')).agg({\n    'sales': ['sum', 'mean', 'std'],\n    'units': 'sum'\n}).reset_index()\n",
    "\nprint(f\"\\n✅ 週度報表準備完成 ({len(weekly_report)} 行)\")\nprint(weekly_report.tail(10))"
   ]
  },
  {
   "cell_type": {"text": "python"}, "metadata": {},
   "source": [
    "# 項目完成總結\nprint(\"\\n\" + \"=\"*70)\nprint(\" \" * 25 + \"項目完成總結\")\nprint(\"=\"*70)\nprint(\"\"\"\n✅ 功能清單：\n\n1. ✓ 日週月趨勢分析\n   └─ 多時間尺度的銷售統計與對比\n\n2. ✓ 移動平均線分析（7/30/90 日）\n   └─ SMA、EMA、MACD 技術指標\n\n3. ✓ YTD（年初至今）累計分析\n   └─ 年度進度追蹤與月度細分\n\n4. ✓ 成長率分析（MoM）\n   └─ 月環比增長率計算與排名\n\n5. ✓ 季節性分析\n   └─ 月份季節指數與季度分析\n\n6. ✓ 異常檢測系統\n   └─ 布林帶、Z-score、IQR 多重檢測\n\n7. ✓ 綜合 KPI 報表\n   └─ 基礎、增長、年度、技術面 KPI\n\n💻 技術應用：\n   • Pandas 時間序列操作（resample, rolling, expanding）\n   • 多層次數據聚合與分組\n   • 技術指標計算（SMA, EMA, MACD, RSI）\n   • 統計異常檢測方法\n   • 數據可視化準備\n\n📊 輸出結果：\n   • 月度完整報表\n   • 週度統計數據\n   • KPI 儀表板\n   • 異常警告系統\n   • 季節性預測支持\n\n🎓 學習收穫：\n   ✓ 掌握完整的時間序列分析流程\n   ✓ 理解多維度的業務指標體系\n   ✓ 學會技術指標在數據分析中的應用\n   ✓ 實踐異常檢測在業務中的價值\n   ✓ 為進階預測模型做好準備\n\n🚀 下一步方向：\n   → Week 5: Apply & Transform - 數據轉換進階\n   → Week 6: Performance & Merge - 大數據處理\n   → Week 7+: 機器學習與預測建模\n\"\"\")\nprint(\"=\"*70)"
