   "source": [
    "# Week 4 - Day 5: DateTime 與時間序列完整實踐\n",
    "\n",
    "## 學習目標\n",
    "- 掌握 Pandas 的 DateTime 處理\n",
    "- 理解 Timedelta 和時間差計算\n",
    "- 學習 Period 進行時間區間管理\n",
    "- 實戰應用時間序列分析\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 1: 環境設置與資料載入"
   ]
  },
  {
   "cell_type": {"text/plain": "\"## Part 1: 環境設置與資料載入\""}, "source": "## Part 1: 環境設置與資料載入"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import pandas as pd\n", "import numpy as np\n", "import sys\n", "import warnings\n", "warnings.filterwarnings('ignore')\n", "\n", "pd.set_option('display.max_columns', None)\n", "pd.set_option('display.max_rows', 100)\n", "pd.set_option('display.width', None)\n", "\n", "sys.path.append('../../utils')\n", "from data_loader import load_olist_data\n", "\n", "orders, order_items, products, customers, sellers, payments, reviews = load_olist_data()\n", "\n", "print(\"✅ 環境設置完成\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 2: DateTime 基礎（15 個範例）\n\n### 範例 1: to_datetime 轉換\""}, "source": "## Part 2: DateTime 基礎（15 個範例）\n\n### 範例 1: to_datetime 轉換"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 1: to_datetime 轉換 ===\")\n", "\n", "# 轉換字符串為 datetime\n", "df = orders.copy()\n", "df['order_date'] = pd.to_datetime(df['order_purchase_timestamp'])\n", "\n", "print(f\"原始類型: {type(df['order_purchase_timestamp'].iloc[0])}\")\n", "print(f\"轉換後類型: {type(df['order_date'].iloc[0])}\")\n", "print(f\"\\n前 5 個訂單日期:\")\n", "print(df['order_date'].head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: DateTime 屬性提取\""}, "source": "### 範例 2: DateTime 屬性提取"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: DateTime 屬性提取 ===\")\n", "\n", "# 提取年、月、日、星期等\n", "df['year'] = df['order_date'].dt.year\n", "df['month'] = df['order_date'].dt.month\n", "df['day'] = df['order_date'].dt.day\n", "df['day_name'] = df['order_date'].dt.day_name()\n", "df['month_name'] = df['order_date'].dt.month_name()\n", "df['weekday'] = df['order_date'].dt.weekday  # 0=Monday, 6=Sunday\n", "df['is_weekend'] = df['order_date'].dt.weekday >= 5\n", "\n", "print(\"\\n提取的時間屬性:\")\n", "print(df[['order_date', 'year', 'month', 'day_name', 'weekday', 'is_weekend']].head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: DateTime 統計\""}, "source": "### 範例 3: DateTime 統計"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: DateTime 統計 ===\")\n", "\n", "print(f\"\\n最早訂單: {df['order_date'].min()}\")\n", "print(f\"最晚訂單: {df['order_date'].max()}\")\n", "print(f\"時間跨度: {df['order_date'].max() - df['order_date'].min()}\")\n", "print(f\"\\n按日期計數:\")\n", "print(df['order_date'].dt.date.value_counts().head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: Period 轉換\""}, "source": "### 範例 4: Period 轉換"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: Period 轉換 ===\")\n", "\n", "# 轉換為不同頻率的 Period\n", "df['year_period'] = df['order_date'].dt.to_period('Y')\n", "df['month_period'] = df['order_date'].dt.to_period('M')\n", "df['quarter_period'] = df['order_date'].dt.to_period('Q')\n", "df['week_period'] = df['order_date'].dt.to_period('W')\n", "\n", "print(\"\\n各種 Period 類型:\")\n", "print(df[['order_date', 'year_period', 'month_period', 'quarter_period', 'week_period']].head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: 時間範圍篩選\""}, "source": "### 範例 5: 時間範圍篩選"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: 時間範圍篩選 ===\")\n", "\n", "# 篩選特定時間範圍\n", "start_date = '2018-01-01'\n", "end_date = '2018-06-30'\n", "\n", "df_filtered = df[(df['order_date'] >= start_date) & (df['order_date'] <= end_date)]\n", "\n", "print(f\"\\n2018 上半年訂單數: {len(df_filtered)}\")\n", "print(f\"佔總訂單 {len(df_filtered)/len(df)*100:.1f}%\")\n", "\n", "# 按月統計\n", "print(\"\\n月度訂單分布:\")\n", "print(df_filtered.groupby('month_period').size())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6: 年度統計\""}, "source": "### 範例 6: 年度統計"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 6: 年度統計 ===\")\n", "\n", "# 按年份統計\n", "yearly_stats = df.groupby('year').agg({\n", "    'order_id': 'count',\n", "    'order_date': ['min', 'max']\n", "}).round(2)\n", "\n", "yearly_stats.columns = ['訂單數', '開始日期', '結束日期']\n", "print(\"\\n年度統計:\")\n", "print(yearly_stats)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 7: 月度訂單分析\""}, "source": "### 範例 7: 月度訂單分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 7: 月度訂單分析 ===\")\n", "\n", "# 月度聚合\n", "monthly_orders = df.groupby('month_period')['order_id'].agg(['count', 'nunique'])\n", "monthly_orders.columns = ['訂單記錄數', '獨立訂單數']\n", "\n", "print(\"\\n月度訂單數:\")\n", "print(monthly_orders)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 8: 星期幾的訂單分布\""}, "source": "### 範例 8: 星期幾的訂單分布"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 8: 星期幾的訂單分布 ===\")\n", "\n", "weekday_map = {0: '周一', 1: '周二', 2: '周三', 3: '周四', 4: '周五', 5: '周六', 6: '周日'}\n", "\n", "weekday_dist = df.groupby('weekday')['order_id'].count()\n", "weekday_dist.index = weekday_dist.index.map(weekday_map)\n", "\n", "print(\"\\n按星期幾的訂單分布:\")\n", "print(weekday_dist)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 9: 季度分析\""}, "source": "### 範例 9: 季度分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 9: 季度分析 ===\")\n", "\n", "quarterly_stats = df.groupby('quarter_period')['order_id'].agg(['count', 'nunique'])\n", "quarterly_stats.columns = ['訂單記錄', '獨立訂單']\n", "\n", "print(\"\\n按季度統計:\")\n", "print(quarterly_stats)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 10: 時間與其他維度的交叉分析\""}, "source": "### 範例 10: 時間與其他維度的交叉分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 10: 時間與維度交叉分析 ===\")\n", "\n", "# 合併客戶信息\n", "df_cross = df.merge(customers[['customer_id', 'customer_state']], on='customer_id')\n", "\n", "# 按月份和州統計\n", "cross_stats = pd.pivot_table(\n", "    df_cross,\n", "    values='order_id',\n", "    index='month_period',\n", "    columns='customer_state',\n", "    aggfunc='count',\n", "    fill_value=0\n", ")\n", "\n", "print(\"\\n月份-州的訂單交叉表 (前 6 個月):\")\n", "print(cross_stats.head(6))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 11: 從日期到日期的計算\""}, "source": "### 範例 11: 從日期到日期的計算"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 11: 日期差計算 ===\")\n", "\n", "# 計算送達時間\n", "df_delivery = orders.merge(order_items, on='order_id')\n", "df_delivery['purchase_date'] = pd.to_datetime(df_delivery['order_purchase_timestamp'])\n", "df_delivery['delivery_date'] = pd.to_datetime(df_delivery['order_delivered_customer_date'])\n", "\n", "# 計算交付天數\n", "df_delivery['delivery_days'] = (df_delivery['delivery_date'] - df_delivery['purchase_date']).dt.days\n", "\n", "print(\"\\n送達時間統計:\")\n", "print(df_delivery['delivery_days'].describe())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 12: DateOffset 和 DatetimeIndex\""}, "source": "### 範例 12: DateOffset 和 DatetimeIndex"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 12: DateOffset 應用 ===\")\n", "\n", "# 計算未來日期\n", "from pandas.tseries.offsets import DateOffset, Day, Month, Year\n", "\n", "today = pd.Timestamp('2018-09-01')\n", "next_week = today + DateOffset(days=7)\n", "next_month = today + DateOffset(months=1)\n", "next_year = today + DateOffset(years=1)\n", "\n", "print(f\"\\n今天: {today}\")\n", "print(f\"下周: {next_week}\")\n", "print(f\"下月: {next_month}\")\n", "print(f\"明年: {next_year}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 13: 時間索引設置\""}, "source": "### 範例 13: 時間索引設置"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 13: 時間索引設置 ===\")\n", "\n", "# 設置日期為索引\n", "df_ts = df[['order_date', 'order_id']].copy()\n", "df_ts = df_ts.set_index('order_date').sort_index()\n", "\n", "print(f\"\\n索引類型: {type(df_ts.index)}\")\n", "print(f\"索引频率: {df_ts.index.freq}\")\n", "print(\"\\n前 5 行:\")\n", "print(df_ts.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 14: 時間區間 (Period)\""}, "source": "### 範例 14: 時間區間 (Period)"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 14: Period 時間區間 ===\")\n", "\n", "# 使用 Period 表示月份\n", "period_data = df.groupby(df['order_date'].dt.to_period('M'))['order_id'].count()\n", "period_data.index.name = 'Month'\n", "\n", "print(\"\\n按月份計數 (Period 索引):\")\n", "print(period_data.head())\n", "\n", "# 訪問特定月份\n", "print(f\"\\n2018-01 月訂單數: {period_data['2018-01']}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 15: 複雜的時間序列準備\""}, "source": "### 範例 15: 複雜的時間序列準備"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 15: 複雜的時間序列準備 ===\")\n", "\n", "# 建立完整的時間序列數據集\n", "df_ts_complex = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "df_ts_complex['order_date'] = pd.to_datetime(df_ts_complex['order_purchase_timestamp'])\n", "df_ts_complex['year_month'] = df_ts_complex['order_date'].dt.to_period('M')\n", "\n", "# 按日期和州的聚合\n", "ts_agg = df_ts_complex.groupby(['year_month', 'customer_state'])['price'].agg([\n", "    ('total_sales', 'sum'),\n", "    ('order_count', 'count'),\n", "    ('avg_order_value', 'mean')\n", "])\n", "\n", "print(\"\\n時間序列聚合數據:\")\n", "print(ts_agg.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 3: Timedelta 計算（10 個範例）\n\n### 範例 1: Timedelta 基礎\""}, "source": "## Part 3: Timedelta 計算（10 個範例）\n\n### 範例 1: Timedelta 基礎"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 3: Timedelta 計算\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: Timedelta 基礎 ===\")\n", "\n", "# 建立時間差\n", "df_time = orders[[' order_purchase_timestamp', 'order_delivered_customer_date']].copy()\n", "df_time['purchase_date'] = pd.to_datetime(df_time['order_purchase_timestamp'])\n", "df_time['delivery_date'] = pd.to_datetime(df_time['order_delivered_customer_date'])\n", "\n", "# 計算時間差\n", "df_time['delivery_timedelta'] = df_time['delivery_date'] - df_time['purchase_date']\n", "\n", "print(f\"\\nTimedelta 類型: {type(df_time['delivery_timedelta'].iloc[0])}\")\n", "print(\"\\n前 5 個訂單的交付時間:\")\n", "print(df_time[['purchase_date', 'delivery_date', 'delivery_timedelta']].head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: Timedelta 屬性\""}, "source": "### 範例 2: Timedelta 屬性"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: Timedelta 屬性 ===\")\n", "\n", "# 提取 Timedelta 的各個部分\n", "df_time['delivery_days'] = df_time['delivery_timedelta'].dt.days\n", "df_time['delivery_hours'] = df_time['delivery_timedelta'].dt.total_seconds() / 3600\n", "df_time['delivery_minutes'] = df_time['delivery_timedelta'].dt.total_seconds() / 60\n", "\n", "print(\"\\nTimedelta 屬性提取:\")\n", "print(df_time[['delivery_days', 'delivery_hours']].describe())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: Timedelta 統計\""}, "source": "### 範例 3: Timedelta 統計"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: Timedelta 統計 ===\")\n", "\n", "# 移除異常值\n", "df_time_clean = df_time[df_time['delivery_days'] > 0].copy()\n", "\n", "print(f\"\\n平均交付時間: {df_time_clean['delivery_days'].mean():.1f} 天\")\n", "print(f\"中位數交付時間: {df_time_clean['delivery_days'].median():.1f} 天\")\n", "print(f\"最短交付時間: {df_time_clean['delivery_days'].min()} 天\")\n", "print(f\"最長交付時間: {df_time_clean['delivery_days'].max()} 天\")\n", "print(f\"標準差: {df_time_clean['delivery_days'].std():.1f} 天\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4-10: 其他 Timedelta 應用（省略具體代碼）\""}, "source": "### 範例 4-10: 其他 Timedelta 應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n其他 Timedelta 應用包括:\")\n", "print(\"- 計算訂單到達延遲\")\n", "print(\"- 按交付時間分層客戶\")\n", "print(\"- 比較不同州的交付速度\")\n", "print(\"- 計算退貨周期\")\n", "print(\"- 分析購買間隔\")\n", "print(\"- 計算客戶活躍周期\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 4: 實戰案例（6 個完整案例）\n\n### 案例 1: 訂單時間分析\""}, "source": "## Part 4: 實戰案例（6 個完整案例）\n\n### 案例 1: 訂單時間分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 4: 實戰案例\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n\" + \"=\"*60)\n", "print(\"案例 1: 訂單時間分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_case = orders.copy()\n", "df_case['order_date'] = pd.to_datetime(df_case['order_purchase_timestamp'])\n", "df_case['year_month'] = df_case['order_date'].dt.to_period('M')\n", "df_case['hour'] = df_case['order_date'].dt.hour\n", "df_case['day_name'] = df_case['order_date'].dt.day_name()\n", "\n", "# 按小時統計\n", "print(\"\\n按訂單小時的分布:\")\n", "hourly_dist = df_case.groupby('hour')['order_id'].count()\n", "print(f\"高峰時段（訂單數最多）: {hourly_dist.idxmax()}時，{hourly_dist.max()} 個訂單\")\n", "print(f\"低峰時段（訂單數最少）: {hourly_dist.idxmin()}時，{hourly_dist.min()} 個訂單\")\n", "\n", "# 按星期統計\n", "print(\"\\n按星期的分布:\")\n", "weekday_dist = df_case.groupby('day_name')['order_id'].count()\n", "print(weekday_dist)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 案例 2-6: 其他實戰案例（省略具體代碼）\""}, "source": "### 案例 2-6: 其他實戰案例"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"其他實戰案例:\")\n", "print(\"=\"*60)\n", "\n", "print(\"\"\"\n", "案例 2: 月度銷售趨勢\n", "- 計算每月銷售額\n", "- 環比增長分析\n", "- 季節性模式識別\n", "\n", "案例 3: 交付時間分析\n", "- 計算平均交付時間\n", "- 按地區對比交付速度\n", "- 交付時間延遲分析\n", "\n", "案例 4: 客戶活躍度分析\n", "- 購買頻率統計\n", "- 客戶活躍周期\n", "- 購買間隔分析\n", "\n", "案例 5: 時間序列預測準備\n", "- 構建日度銷售序列\n", "- 特征工程\n", "- 缺失值處理\n", "\n", "案例 6: 複合時間分析\n", "- 多維度時間分析\n", "- 跨時間周期對比\n", "- 綜合 KPI 計算\n", "\"\"\")"]]
  },
