{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Week 4 - Day 7: 時間對比分析與同期比較\n",
    "\n",
    "## 學習目標\n",
    "- 掌握 shift 進行時間平移\n",
    "- 理解 pct_change 和 diff 的差異\n",
    "- 學習 MoM (Month-over-Month) 和 YoY (Year-over-Year) 分析\n",
    "- 實戰應用時間對比分析\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 1: 環境設置"
   ]
  },
  {
   "cell_type": {"text/plain": "\"## Part 1: 環境設置\""}, "source": "## Part 1: 環境設置"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import pandas as pd\n", "import numpy as np\n", "import sys\n", "import warnings\n", "warnings.filterwarnings('ignore')\n", "\n", "pd.set_option('display.max_columns', None)\n", "pd.set_option('display.max_rows', 100)\n", "\n", "sys.path.append('../../utils')\n", "from data_loader import load_olist_data\n", "\n", "orders, order_items, products, customers, sellers, payments, reviews = load_olist_data()\n", "\n", "print(\"✅ 環境設置完成\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 2: Shift 時間平移（10 個範例）\n\n### 範例 1: 基本 shift\""}, "source": "## Part 2: Shift 時間平移（10 個範例）\n\n### 範例 1: 基本 shift"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 1: 基本 shift ===\")\n", "\n", "# 準備時間序列\n", "df = orders.merge(order_items, on='order_id')\n", "df['order_date'] = pd.to_datetime(df['order_purchase_timestamp']).dt.date\n", "daily_sales = df.groupby('order_date')['price'].sum().sort_index()\n", "daily_sales.index = pd.to_datetime(daily_sales.index)\n", "\n", "# Shift 操作\n", "shifted_1 = daily_sales.shift(1)  # 向下平移 1 天\n", "shifted_7 = daily_sales.shift(7)  # 向下平移 7 天\n", "\n", "comparison = pd.DataFrame({\n", "    'Current': daily_sales,\n", "    'Previous_Day': shifted_1,\n", "    'Previous_Week': shifted_7\n", "})\n", "\n", "print(\"\\n時間平移對比:\")\n", "print(comparison.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 計算日環比\""}, "source": "### 範例 2: 計算日環比"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 計算日環比 ===\")\n", "\n", "# 日環比 = (今日 - 昨日) / 昨日 * 100%\n", "daily_growth = ((daily_sales - daily_sales.shift(1)) / daily_sales.shift(1) * 100)\n", "\n", "day_comparison = pd.DataFrame({\n", "    'Sales': daily_sales,\n", "    'Growth_Rate': daily_growth\n", "})\n", "\n", "print(\"\\n日環比 (前 10 天):\")\n", "print(day_comparison.head(10))\n", "\n", "print(f\"\\n平均日增長率: {daily_growth.mean():.2f}%\")\n", "print(f\"最大日增長: {daily_growth.max():.2f}%\")\n", "print(f\"最大日下跌: {daily_growth.min():.2f}%\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 週環比\""}, "source": "### 範例 3: 週環比"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 週環比 ===\")\n", "\n", "# 週度銷售\n", "weekly_sales = daily_sales.resample('W').sum()\n", "\n", "# 週環比\n", "weekly_growth = ((weekly_sales - weekly_sales.shift(1)) / weekly_sales.shift(1) * 100)\n", "\n", "weekly_comp = pd.DataFrame({\n", "    'Weekly_Sales': weekly_sales,\n", "    'Growth_Rate': weekly_growth\n", "})\n", "\n", "print(\"\\n週環比:\")\n", "print(weekly_comp)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4-10: 其他 shift 應用（省略具體代碼）\""}, "source": "### 範例 4-10: 其他 shift 應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\nShift 應用包括:\")\n", "print(\"- 計算月環比\")\n", "print(\"- 構建滯後特征\")\n", "print(\"- 計算多期回報\")\n", "print(\"- 異常檢測\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 3: pct_change 與 diff（12 個範例）\n\n### 範例 1: pct_change 百分比變化\""}, "source": "## Part 3: pct_change 與 diff（12 個範例）\n\n### 範例 1: pct_change 百分比變化"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 3: pct_change 與 diff\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: pct_change 百分比變化 ===\")\n", "\n", "# 直接使用 pct_change\n", "pct_change_1 = daily_sales.pct_change(periods=1) * 100\n", "pct_change_7 = daily_sales.pct_change(periods=7) * 100\n", "\n", "pct_comp = pd.DataFrame({\n", "    'Value': daily_sales,\n", "    'Daily_Change_%': pct_change_1,\n", "    'Weekly_Change_%': pct_change_7\n", "})\n", "\n", "print(\"\\n百分比變化:\")\n", "print(pct_comp.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: diff 絕對值變化\""}, "source": "### 範例 2: diff 絕對值變化"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: diff 絕對值變化 ===\")\n", "\n", "# 計算絕對值變化\n", "diff_1 = daily_sales.diff(periods=1)\n", "diff_7 = daily_sales.diff(periods=7)\n", "\n", "diff_comp = pd.DataFrame({\n", "    'Value': daily_sales,\n", "    'Daily_Diff': diff_1,\n", "    'Weekly_Diff': diff_7\n", "})\n", "\n", "print(\"\\n絕對值變化:\")\n", "print(diff_comp.head(10))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: pct_change vs diff 對比\""}, "source": "### 範例 3: pct_change vs diff 對比"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: pct_change vs diff 對比 ===\")\n", "\n", "# 創建對比數據\n", "comparison_df = pd.DataFrame({\n", "    'Value': daily_sales,\n", "    'pct_change': daily_sales.pct_change() * 100,\n", "    'diff': daily_sales.diff()\n", "})\n", "\n", "print(\"\\n前 15 天的對比:\")\n", "print(comparison_df.head(15))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4-12: 其他應用（省略具體代碼）\""}, "source": "### 範例 4-12: 其他應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n應用包括:\")\n", "print(\"- 多期回報計算\")\n", "print(\"- 波動性分析\")\n", "print(\"- 異常檢測\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 4: MoM/YoY 同期比較（10 個範例）\n\n### 範例 1: 基本 MoM\""}, "source": "## Part 4: MoM/YoY 同期比較（10 個範例）\n\n### 範例 1: 基本 MoM"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"Part 4: MoM/YoY 同期比較\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n=== 範例 1: 基本 MoM ===\")\n", "\n", "# 準備月度數據\n", "df_ts = orders.merge(order_items, on='order_id')\n", "df_ts['order_date'] = pd.to_datetime(df_ts['order_purchase_timestamp'])\n", "df_ts['year'] = df_ts['order_date'].dt.year\n", "df_ts['month'] = df_ts['order_date'].dt.month\n", "df_ts['year_month'] = df_ts['order_date'].dt.to_period('M')\n", "\n", "# 月度銷售\n", "monthly_sales = df_ts.groupby('year_month')['price'].sum()\n", "\n", "# 計算 MoM\n", "monthly_mom = monthly_sales.pct_change() * 100\n", "\n", "mom_df = pd.DataFrame({\n", "    'Sales': monthly_sales,\n", "    'MoM_%': monthly_mom\n", "})\n", "\n", "print(\"\\nMonth-over-Month 增長:\")\n", "print(mom_df)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 基本 YoY\""}, "source": "### 範例 2: 基本 YoY"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 基本 YoY ===\")\n", "\n", "# 按年月的銷售\n", "pivot_sales = pd.pivot_table(\n", "    df_ts,\n", "    values='price',\n", "    index='month',\n", "    columns='year',\n", "    aggfunc='sum'\n", ")\n", "\n", "print(\"\\n按月份和年份的銷售:\")\n", "print(pivot_sales)\n", "\n", "# 計算 YoY\n", "if len(pivot_sales.columns) >= 2:\n", "    yoy_growth = ((pivot_sales[pivot_sales.columns[-1]] - pivot_sales[pivot_sales.columns[-2]]) / \n", "                  pivot_sales[pivot_sales.columns[-2]] * 100)\n", "    print(\"\\nYear-over-Year 增長率:\")\n", "    print(yoy_growth)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3-10: 其他同期比較應用（省略具體代碼）\""}, "source": "### 範例 3-10: 其他同期比較應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n同期比較應用包括:\")\n", "print(\"- 季度環比\")\n", "print(\"- 按地區的 MoM 分析\")\n", "print(\"- 按產品的 YoY 分析\")\n", "print(\"- 複合增長率計算\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 5: 實戰案例\n\n### 案例 1: 完整的時間對比分析\""}, "source": "## Part 5: 實戰案例\n\n### 案例 1: 完整的時間對比分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"實戰案例\")\n", "print(\"=\"*60)\n", "\n", "print(\"\\n案例 1: 完整的時間對比分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_case = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "df_case['order_date'] = pd.to_datetime(df_case['order_purchase_timestamp'])\n", "df_case['year_month'] = df_case['order_date'].dt.to_period('M')\n", "\n", "# 全局月度銷售\n", "global_monthly = df_case.groupby('year_month')['price'].sum()\n", "\n", "# 計算 MoM 和 YoY\n", "analysis = pd.DataFrame({\n", "    'Sales': global_monthly,\n", "    'MoM_%': global_monthly.pct_change() * 100,\n", "    'Diff': global_monthly.diff()\n", "})\n", "\n", "print(\"\\n全局月度分析:\")\n", "print(analysis)"]]
  },
  {
   "cell_type": {"text/plain": "\"## 總結\""}, "source": "## 總結"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n✅ Week 4 Day 7 - 時間對比分析課程結束\")"]]
  }
 ],
