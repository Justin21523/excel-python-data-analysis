{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Week 4: 時間序列分析儀表板\n",
    "\n",
    "## 專案目標\n",
    "- 建立完整的時間序列分析儀表板\n",
    "- 實現多維度的趨勢分析\n",
    "- 計算關鍵性能指標 (KPI)\n",
    "- 進行異常檢測與預警\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": {"text/plain": "\"## 環境設置與資料載入\""}, "source": "## 環境設置與資料載入"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import pandas as pd\n", "import numpy as np\n", "import sys\n", "import warnings\n", "warnings.filterwarnings('ignore')\n", "\n", "pd.set_option('display.max_columns', None)\n", "pd.set_option('display.max_rows', 100)\n", "pd.set_option('display.float_format', lambda x: f'{x:,.2f}' if abs(x) > 100 else f'{x:.2f}')\n", "\n", "sys.path.append('../../utils')\n", "from data_loader import load_olist_data\n", "\n", "orders, order_items, products, customers, sellers, payments, reviews = load_olist_data()\n", "\n", "print(\"✅ 環境設置完成\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## 功能 1: 日週月趨勢分析\""}, "source": "## 功能 1: 日週月趨勢分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"功能 1: 日週月趨勢分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df = orders.merge(order_items, on='order_id')\n", "df['order_date'] = pd.to_datetime(df['order_purchase_timestamp']).dt.date\n", "daily_sales = df.groupby('order_date')['price'].sum().sort_index()\n", "daily_sales.index = pd.to_datetime(daily_sales.index)\n", "\n", "# 計算各級別統計\n", "weekly_sales = daily_sales.resample('W').sum()\n", "monthly_sales = daily_sales.resample('M').sum()\n", "\n", "print(f\"\\n日度銷售 - 統計:\")\n", "print(f\"  最小: R$ {daily_sales.min():,.2f}\")\n", "print(f\"  平均: R$ {daily_sales.mean():,.2f}\")\n", "print(f\"  最大: R$ {daily_sales.max():,.2f}\")\n", "\n", "print(f\"\\n週度銷售 - 統計:\")\n", "print(f\"  最小: R$ {weekly_sales.min():,.2f}\")\n", "print(f\"  平均: R$ {weekly_sales.mean():,.2f}\")\n", "print(f\"  最大: R$ {weekly_sales.max():,.2f}\")\n", "\n", "print(f\"\\n月度銷售 - 統計:\")\n", "print(f\"  最小: R$ {monthly_sales.min():,.2f}\")\n", "print(f\"  平均: R$ {monthly_sales.mean():,.2f}\")\n", "print(f\"  最大: R$ {monthly_sales.max():,.2f}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## 功能 2: 移動平均線\""}, "source": "## 功能 2: 移動平均線"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"功能 2: 移動平均線\")\n", "print(\"=\"*60)\n", "\n", "# 計算移動平均\n", "ma7 = daily_sales.rolling(window=7).mean()\n", "ma30 = daily_sales.rolling(window=30).mean()\n", "ma90 = daily_sales.rolling(window=90).mean()\n", "\n", "# 構建移動平均數據框\n", "ma_df = pd.DataFrame({\n", "    'Actual': daily_sales,\n", "    'MA7': ma7,\n", "    'MA30': ma30,\n", "    'MA90': ma90\n", "})\n", "\n", "print(\"\\n最新 30 天的移動平均線:\")\n", "print(ma_df.tail(30))\n", "\n", "# 識別趨勢\n", "latest = ma_df.iloc[-1]\n", "if latest['Actual'] > latest['MA30']:\n", "    trend = \"上升趨勢\"\n", "elif latest['Actual'] < latest['MA30']:\n", "    trend = \"下降趨勢\"\n", "else:\n", "    trend = \"穩定趨勢\"\n", "\n", "print(f\"\\n當前趨勢: {trend}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## 功能 3: YTD 累計分析\""}, "source": "## 功能 3: YTD 累計分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"功能 3: YTD (Year-to-Date) 累計分析\")\n", "print(\"=\"*60)\n", "\n", "# 提取年月信息\n", "df_ytd = df.copy()\n", "df_ytd['date'] = pd.to_datetime(df_ytd['order_purchase_timestamp'])\n", "df_ytd['year'] = df_ytd['date'].dt.year\n", "df_ytd['month'] = df_ytd['date'].dt.month\n", "\n", "# 按年計算 YTD\n", "yearly_sales = df_ytd.groupby('year')['price'].sum()\n", "\n", "print(\"\\n年度銷售總額:\")\n", "print(yearly_sales)\n", "\n", "# 當年月度累計\n", "current_year = df_ytd['year'].max()\n", "current_year_data = df_ytd[df_ytd['year'] == current_year]\n", "ytd_monthly = current_year_data.groupby('month')['price'].sum()\n", "ytd_cumsum = ytd_monthly.cumsum()\n", "\n", "print(f\"\\n{current_year} 年 YTD 累計:\")\n", "ytd_df = pd.DataFrame({\n", "    'Month': ytd_monthly.index,\n", "    'Monthly_Sales': ytd_monthly.values,\n", "    'YTD_Cumulative': ytd_cumsum.values\n", "})\n", "print(ytd_df)"]]
  },
  {
   "cell_type": {"text/plain": "\"## 功能 4: 成長率分析\""}, "source": "## 功能 4: 成長率分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"功能 4: 成長率分析\")\n", "print(\"=\"*60)\n", "\n", "# 月度 MoM\n", "monthly = daily_sales.resample('M').sum()\n", "mom = monthly.pct_change() * 100\n", "\n", "growth_df = pd.DataFrame({\n", "    'Monthly_Sales': monthly,\n", "    'MoM_Growth_%': mom\n", "})\n", "\n", "print(\"\\nMonth-over-Month 增長率:\")\n", "print(growth_df.dropna())\n", "\n", "# 統計\n", "print(f\"\\n成長率統計:\")\n", "print(f\"  平均增長: {mom.mean():.2f}%\")\n", "print(f\"  最大增長: {mom.max():.2f}%\")\n", "print(f\"  最大下跌: {mom.min():.2f}%\")\n", "print(f\"  增長月份數: {(mom > 0).sum()} 個月\")\n", "print(f\"  下跌月份數: {(mom < 0).sum()} 個月\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## 功能 5: 季節性分析\""}, "source": "## 功能 5: 季節性分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"功能 5: 季節性分析\")\n", "print(\"=\"*60)\n", "\n", "# 按月份 (1-12) 統計\n", "df_seasonal = df.copy()\n", "df_seasonal['date'] = pd.to_datetime(df_seasonal['order_purchase_timestamp'])\n", "df_seasonal['month'] = df_seasonal['date'].dt.month\n", "\n", "seasonal_sales = df_seasonal.groupby('month')['price'].agg(['sum', 'mean', 'count'])\n", "seasonal_sales.columns = ['Total', 'Avg_Order_Value', 'Orders']\n", "\n", "month_names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']\n", "seasonal_sales.index = [month_names[i-1] for i in seasonal_sales.index]\n", "\n", "print(\"\\n按月份的季節性分析:\")\n", "print(seasonal_sales)\n", "\n", "# 計算季節指數\n", "overall_avg = df_seasonal['price'].mean()\n", "seasonal_index = seasonal_sales['Avg_Order_Value'] / overall_avg\n", "\n", "print(\"\\n季節性指數 (相對於平均值):\")\n", "print(seasonal_index.round(2))"]]
  },
  {
   "cell_type": {"text/plain": "\"## 功能 6: 異常檢測系統\""}, "source": "## 功能 6: 異常檢測系統"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"功能 6: 異常檢測系統\")\n", "print(\"=\"*60)\n", "\n", "# 基於統計的異常檢測\n", "mean = daily_sales.mean()\n", "std = daily_sales.std()\n", "\n", "# 識別異常值 (超過 2 個標準差)\n", "anomalies = daily_sales[(daily_sales > mean + 2*std) | (daily_sales < mean - 2*std)]\n", "\n", "print(f\"\\n異常值檢測 (2σ 規則):\")\n", "print(f\"  均值: R$ {mean:,.2f}\")\n", "print(f\"  標準差: R$ {std:,.2f}\")\n", "print(f\"  上限: R$ {mean + 2*std:,.2f}\")\n", "print(f\"  下限: R$ {mean - 2*std:,.2f}\")\n", "print(f\"\\n檢測到的異常日期 ({len(anomalies)} 天):\")\n", "\n", "for date, value in anomalies.head(10).items():\n", "    deviation = (value - mean) / std\n", "    print(f\"  {date.date()}: R$ {value:,.2f} (偏離: {deviation:.2f}σ)\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## 綜合儀表板 KPI\""}, "source": "## 綜合儀表板 KPI"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"綜合儀表板 - 關鍵 KPI\")\n", "print(\"=\"*60)\n", "\n", "kpi_report = pd.DataFrame({\n", "    'KPI': [\n", "        '總銷售額',\n", "        '日均銷售',\n", "        '月均銷售',\n", "        '訂單總數',\n", "        '平均訂單值',\n", "        '銷售波動性 (CV)',\n", "        '最高日銷售',\n", "        '最低日銷售',\n", "        '本月環比增長',\n", "        '異常日比例'\n", "    ],\n", "    '數值': [\n", "        f\"R$ {daily_sales.sum():,.2f}\",\n", "        f\"R$ {daily_sales.mean():,.2f}\",\n", "        f\"R$ {monthly_sales.mean():,.2f}\",\n", "        f\"{len(df):,}\",\n", "        f\"R$ {df['price'].mean():.2f}\",\n", "        f\"{std/mean*100:.2f}%\",\n", "        f\"R$ {daily_sales.max():,.2f}\",\n", "        f\"R$ {daily_sales.min():,.2f}\",\n", "        f\"{mom.iloc[-1]:.2f}%\",\n", "        f\"{len(anomalies)/len(daily_sales)*100:.2f}%\"\n", "    ]\n", "})\n", "\n", "print(\"\\n\")\n", "print(kpi_report.to_string(index=False))"]]
  },
  {
   "cell_type": {"text/plain": "\"## 多維度分析\""}, "source": "## 多維度分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"多維度分析\")\n", "print(\"=\"*60)\n", "\n", "# 準備數據\n", "df_multi = orders.merge(order_items, on='order_id').merge(\n", "    customers[['customer_id', 'customer_state']], on='customer_id'\n", ")\n", "\n", "df_multi['date'] = pd.to_datetime(df_multi['order_purchase_timestamp'])\n", "df_multi['year_month'] = df_multi['date'].dt.to_period('M')\n", "\n", "# 按州的月度分析\n", "state_monthly = pd.pivot_table(\n", "    df_multi,\n", "    values='price',\n", "    index='year_month',\n", "    columns='customer_state',\n", "    aggfunc='sum',\n", "    fill_value=0\n", ")\n", "\n", "print(\"\\n按州的月度銷售 (前 5 個月):\")\n", "print(state_monthly.head())\n", "\n", "# 州的排名\n", "state_totals = state_monthly.sum().sort_values(ascending=False)\n", "print(\"\\n各州總銷售額排名 (Top 10):\")\n", "for i, (state, sales) in enumerate(state_totals.head(10).items(), 1):\n", "    print(f\"  {i}. {state}: R$ {sales:,.2f}\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## 儀表板總結\""}, "source": "## 儀表板總結"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n", "print(\"✅ 時間序列分析儀表板完成\")\n", "print(\"=\"*60)\n", "\n", "print(\"\"\"\n", "儀表板功能總結:\n", "\n", "1. 日週月趨勢分析\n", "   - 多級別銷售統計\n", "   - 時間序列概覽\n", "\n", "2. 移動平均線\n", "   - 短期、中期、長期趨勢\n", "   - 趨勢識別\n", "\n", "3. YTD 累計分析\n", "   - 年度進度跟蹤\n", "   - 累計銷售分析\n", "\n", "4. 成長率分析\n", "   - 月環比增長\n", "   - 增長態勢評估\n", "\n", "5. 季節性分析\n", "   - 月份模式識別\n", "   - 季節指數計算\n", "\n", "6. 異常檢測系統\n", "   - 統計異常識別\n", "   - 預警機制\n", "\n", "7. 多維度分析\n", "   - 地區細分\n", "   - 對標分析\n", "\n", "應用場景:\n", "- 銷售業績跟蹤\n", "- 趨勢預測\n", "- 異常預警\n", "- 季節性規劃\n", "- 決策支持\n", "\"\"\")"]]
  }
 ],
