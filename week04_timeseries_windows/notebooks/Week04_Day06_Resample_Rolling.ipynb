{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Week 4 - Day 6: Resample 與 Rolling Window 完整實踐\n",
    "\n",
    "## 學習目標\n",
    "- 掌握 resample 進行時間序列重採樣\n",
    "- 理解 rolling window 的移動統計\n",
    "- 學習 expanding 的累計統計\n",
    "- 實戰應用時間序列分析技巧\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 1: 環境設置與資料載入"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import sys\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.max_rows', 100)\n",
    "\n",
    "sys.path.append('../../utils')\n",
    "from data_loader import load_olist_data\n",
    "\n",
    "orders, order_items, products, customers, sellers, payments, reviews = load_olist_data()\n",
    "\n",
    "print(\"✅ 環境設置完成\")"
   ]
  },
  {
   "cell_type": {"text/plain": "\"## Part 2: Resample 重採樣（12 個範例）\n\n### 範例 1: 基本 resample\""}, "source": "## Part 2: Resample 重採樣（12 個範例）\n\n### 範例 1: 基本 resample"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 1: 基本 resample ===\")\n",
    "\n",
    "# 準備時間序列數據\n",
    "df = orders.merge(order_items, on='order_id')\n",
    "df['order_date'] = pd.to_datetime(df['order_purchase_timestamp']).dt.date\n",
    "\n",
    "# 按日期聚合\n",
    "daily_sales = df.groupby('order_date')['price'].sum().sort_index()\n",
    "daily_sales.index = pd.to_datetime(daily_sales.index)\n",
    "\n",
    "print(f\"\\n原始數據點數: {len(daily_sales)}\")\n",
    "print(daily_sales.head())\n",
    "\n",
    "# Resample 到周\n",
    "weekly_sales = daily_sales.resample('W').sum()\n",
    "print(f\"\\nResample 後 (周): {len(weekly_sales)} 週\")\n",
    "print(weekly_sales.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 不同頻率的 resample\""}, "source": "### 範例 2: 不同頻率的 resample"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 不同頻率的 resample ===\")\n",
    "\n",
    "monthly_sales = daily_sales.resample('M').sum()\n",
    "quarterly_sales = daily_sales.resample('Q').sum()\n",
    "yearly_sales = daily_sales.resample('Y').sum()\n",
    "\n",
    "print(f\"月度 resample: {len(monthly_sales)} 月\")\n",
    "print(monthly_sales)\n",
    "\n",
    "print(f\"\\n季度 resample: {len(quarterly_sales)} 季度\")\n",
    "print(quarterly_sales)\n",
    "\n",
    "print(f\"\\n年度 resample: {len(yearly_sales)} 年\")\n",
    "print(yearly_sales)"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: 不同的聚合函數\""}, "source": "### 範例 3: 不同的聚合函數"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: 不同的聚合函數 ===\")\n",
    "\n",
    "# 同時應用多個聚合函數\n",
    "resampled = daily_sales.resample('W').agg([\n",
    "    ('total', 'sum'),\n",
    "    ('mean', 'mean'),\n",
    "    ('std', 'std'),\n",
    "    ('min', 'min'),\n",
    "    ('max', 'max'),\n",
    "    ('count', 'count')\n",
    "])\n",
    "\n",
    "print(\"\\n週度統計:\")\n",
    "print(resampled.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4: Resample 後的缺失值處理\""}, "source": "### 範例 4: Resample 後的缺失值處理"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 4: 缺失值處理 ===\")\n",
    "\n",
    "# 使用不同的缺失值填充方法\n",
    "resampled_ffill = daily_sales.resample('D').ffill()  # Forward fill\n",
    "resampled_bfill = daily_sales.resample('D').bfill()  # Backward fill\n",
    "resampled_zero = daily_sales.resample('D').fillna(0)  # 填充 0\n",
    "resampled_interpolate = daily_sales.resample('D').interpolate()  # 插值\n",
    "\n",
    "print(f\"\\n原始數據點: {len(daily_sales)}\")\n",
    "print(f\"每日 resample: {len(resampled_ffill)}\")\n",
    "print(f\"缺失值占比: {resampled_ffill.isna().sum() / len(resampled_ffill) * 100:.1f}%\")"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 5: 自訂 resample 偏移\""}, "source": "### 範例 5: 自訂 resample 偏移"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 5: 自訂 resample 偏移 ===\")\n",
    "\n",
    "# 每 5 天 resample\n",
    "five_day = daily_sales.resample('5D').sum()\n",
    "print(f\"每 5 天: {len(five_day)} 期\")\n",
    "print(five_day.head())\n",
    "\n",
    "# 每 2 周 resample\n",
    "two_week = daily_sales.resample('2W').sum()\n",
    "print(f\"\\n每 2 週: {len(two_week)} 期\")\n",
    "print(two_week.head())"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 6-12: 其他 resample 應用（省略具體代碼）\""}, "source": "### 範例 6-12: 其他 resample 應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\nResample 應用包括:\")\n",
    "print(\"- OHLC (Open, High, Low, Close) 時間序列\")\n",
    "print(\"- 資料升採樣 (upsample) 和降採樣 (downsample)\")\n",
    "print(\"- 按標籤對齊\")\n",
    "print(\"- 邊界處理\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 3: Rolling Window（15 個範例）\n\n### 範例 1: 基本 rolling\""}, "source": "## Part 3: Rolling Window（15 個範例）\n\n### 範例 1: 基本 rolling"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n",
    "print(\"Part 3: Rolling Window\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "print(\"\\n=== 範例 1: 基本 rolling ===\")\n",
    "\n",
    "# 計算 7 日移動平均\n",
    "rolling_mean = daily_sales.rolling(window=7).mean()\n",
    "print(f\"\\n7 日移動平均:\")\n",
    "print(rolling_mean.head(14))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 2: 多個窗口大小\""}, "source": "### 範例 2: 多個窗口大小"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 2: 多個窗口大小 ===\")\n",
    "\n",
    "# 計算不同窗口的移動平均\n",
    "ma7 = daily_sales.rolling(window=7).mean()\n",
    "ma30 = daily_sales.rolling(window=30).mean()\n",
    "ma90 = daily_sales.rolling(window=90).mean()\n",
    "\n",
    "# 組合到一個 DataFrame\n",
    "moving_averages = pd.DataFrame({\n",
    "    'Actual': daily_sales,\n",
    "    'MA7': ma7,\n",
    "    'MA30': ma30,\n",
    "    'MA90': ma90\n",
    "})\n",
    "\n",
    "print(\"\\n移動平均對比:\")\n",
    "print(moving_averages.head(100).tail(20))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 3: Rolling 標準差\""}, "source": "### 範例 3: Rolling 標準差"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n=== 範例 3: Rolling 標準差 ===\")\n",
    "\n",
    "# 計算波動性\n",
    "rolling_std = daily_sales.rolling(window=30).std()\n",
    "\n",
    "# 計算變異係數\n",
    "rolling_cv = rolling_std / daily_sales.rolling(window=30).mean() * 100\n",
    "\n",
    "volatility = pd.DataFrame({\n",
    "    'Value': daily_sales,\n",
    "    'Rolling_Std': rolling_std,\n",
    "    'CV': rolling_cv\n",
    "})\n",
    "\n",
    "print(\"\\n波動性指標:\")\n",
    "print(volatility.dropna().head(30))"]]
  },
  {
   "cell_type": {"text/plain": "\"### 範例 4-15: 其他 rolling 應用（省略具體代碼）\""}, "source": "### 範例 4-15: 其他 rolling 應用"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\nRolling 應用包括:\")\n",
    "print(\"- Rolling 最大值和最小值\")\n",
    "print(\"- 布林帶 (Bollinger Bands)\")\n",
    "print(\"- 相關係數滑動計算\")\n",
    "print(\"- 異常檢測\")\n",
    "print(\"- 趨勢識別\")"]]
  },
  {
   "cell_type": {"text/plain": "\"## Part 4: 實戰案例\n\n### 案例 1: 銷售趨勢分析\""}, "source": "## Part 4: 實戰案例\n\n### 案例 1: 銷售趨勢分析"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*60)\n",
    "print(\"實戰案例\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "print(\"\\n案例 1: 銷售趨勢分析\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# 月度銷售\n",
    "monthly = daily_sales.resample('M').sum()\n",
    "\n",
    "# 計算移動平均\n",
    "monthly_ma3 = monthly.rolling(window=3).mean()\n",
    "\n",
    "print(\"\\n月度銷售與 3 月移動平均:\")\n",
    "trend_df = pd.DataFrame({\n",
    "    'Monthly_Sales': monthly,\n",
    "    'MA3': monthly_ma3\n",
    "})\n",
    "print(trend_df)\n",
    "\n",
    "# 識別趨勢\n",
    "trend_df['Trend'] = 'Stable'\n",
    "trend_df.loc[trend_df['Monthly_Sales'] > trend_df['MA3'], 'Trend'] = 'Uptrend'\n",
    "trend_df.loc[trend_df['Monthly_Sales'] < trend_df['MA3'], 'Trend'] = 'Downtrend'\n",
    "\n",
    "print(\"\\n添加趨勢標記:\")\n",
    "print(trend_df)"]]
  },
  {
   "cell_type": {"text/plain": "\"## 總結\""}, "source": "## 總結"
  },
  {
   "cell_type": ["code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["print(\"\\n✅ Week 4 Day 6 - Resample 與 Rolling 完整實踐課程結束\")"]]
  }
 ],
